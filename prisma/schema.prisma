enum DeploymentEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum DeploymentStatus {
  PENDING
  IN_PROGRESS
  SUCCEEDED
  FAILED
  ROLLED_BACK
}

// A real deployment record — written by the CI/CD pipeline (see
// .github/workflows/) via a real Deployment API call, or manually. Never
// fabricated: `commitSha`/`version` are the real git ref being deployed.
model Deployment {
  id               String                @id @default(cuid())
  environment      DeploymentEnvironment
  version          String
  commitSha        String
  status           DeploymentStatus      @default(PENDING)
  deployedByUserId String?
  startedAt        DateTime              @default(now())
  finishedAt       DateTime?
  rollbackOfId     String?
  notes            String?               @db.Text

  deployedByUser User?           @relation(fields: [deployedByUserId], references: [id], onDelete: SetNull)
  rollbackOf     Deployment?     @relation("DeploymentRollback", fields: [rollbackOfId], references: [id], onDelete: SetNull)
  rolledBackBy   Deployment[]    @relation("DeploymentRollback")
  changeRequests ChangeRequest[]

  @@index([environment, startedAt])
