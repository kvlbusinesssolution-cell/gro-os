enum BackupType {
  DATABASE
  STORAGE
  CONFIGURATION
  SECRETS
}

enum BackupStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

// A real backup run record — see scripts/backup-database.sh /
// src/lib/ops/backup.ts. `storageKey`/`sizeBytes` are only ever set once a
// real backup artifact actually exists on disk; a FAILED row never claims
// a storageKey.
model Backup {
  id          String       @id @default(cuid())
  type        BackupType
  status      BackupStatus @default(RUNNING)
  storageKey  String?      @db.Text
  sizeBytes   BigInt?
  checksum    String?
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  error       String?      @db.Text

  restores Restore[]

  @@index([type, startedAt])
}

enum RestoreStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

// A real restore-test/restore-execution record — restore TESTING
// (verifying a backup is actually restorable, per the spec's "Restore
// Testing") uses the same model with `isTest: true` against a scratch
// target, never production, so a restore test can never be confused with a
// real disaster-recovery restore in this table's history.
model Restore {
  id          String        @id @default(cuid())
  backupId    String
  isTest      Boolean       @default(true)
  status      RestoreStatus @default(RUNNING)
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  error       String?       @db.Text

  backup Backup @relation(fields: [backupId], references: [id], onDelete: Cascade)

  @@index([backupId])
}

enum ComplianceFramework {
  SOC2
  ISO27001
  GDPR
  CCPA
  DPDP_INDIA
  PCI_DSS
  WCAG
}

enum ComplianceReportStatus {
  READY
  PARTIAL
  NOT_READY
}

// A real, generated readiness snapshot per framework — `findings` is real,
// structured Json (a checklist of real controls checked against this
// codebase's actual architecture), never a fabricated "certified" claim.
// This app is not SOC2/ISO27001-CERTIFIED by generating this row — it
// records ARCHITECTURAL READINESS for that certification process, which
// still requires a real third-party auditor engagement this codebase
// cannot itself provide.
model ComplianceReport {
  id          String                 @id @default(cuid())
  framework   ComplianceFramework
  status      ComplianceReportStatus
  findings    Json
  generatedAt DateTime               @default(now())

  @@index([framework, generatedAt])
}

// ============================= AI Company Understanding Engine =============================
// A new organization's own website (and optionally LinkedIn) is analyzed by AI to build a
// durable "Company DNA" profile. Nothing here is fabricated — every field is either a real,
// crawled fact, an explicitly confidence-scored AI inference, or listed in `unknownFields`.
// Auto-generated CRM/Dashboard/Knowledge Base/Automation suggestions stay proposals inside
// `draftConfiguration` until the org owner reviews and approves — src/lib/company-discovery/
// auto-configure.ts is the only code path allowed to turn a proposal into a real, live row.

enum DiscoveryRunStatus {
  PENDING
  CRAWLING
  ANALYZING
  AWAITING_REVIEW
  APPROVED
  REJECTED
  FAILED
}

enum DNAStatus {
  AWAITING_REVIEW
  APPROVED
  REJECTED
}

model CompanyDiscoveryRun {
  id             String             @id @default(cuid())
  organizationId String
  status         DiscoveryRunStatus @default(PENDING)
  // Human-readable progress, e.g. "Crawling website (4/12 pages)" — polled by the
  // review-wizard UI via the existing realtime event bus (src/lib/realtime/event-bus.ts).
  currentStep    String?
  errorMessage   String?            @db.Text
  dnaId          String?            @unique

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dna          OrganizationDNA? @relation(fields: [dnaId], references: [id], onDelete: SetNull)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([organizationId, startedAt])
}

// The durable "Organization Memory" this engine produces — analogous to AgentMemory, but for
// the org's own business profile rather than agent conversation history. Every field group
// carries its own verification tag so the review UI can render Verified / AI Inference (with
// confidence) / Unknown buckets, per this feature's "never fabricate" requirement.
model OrganizationDNA {
  id             String    @id @default(cuid())
  organizationId String
  // Supports future re-analysis without deleting history — each re-run creates a new row.
  version        Int       @default(1)
  status         DNAStatus @default(AWAITING_REVIEW)

  // ---- Verified (crawled) facts ----
  crawledPages  Json // [{ url, pageType, title }]
  brandAssets   Json // { logoUrl, colors[], socialLinks{}, contactEmail, contactPhone, businessHours }
  websiteScanId String? @unique

  // ---- AI inferences — see `confidence` for the per-field confidence score (0-100) ----
  businessUnderstanding Json // industry, subIndustry, businessModel, targetMarket, services[], products[]...
  linkedinInsights      Json? // null when no LinkedIn URL was given; web-search sourced only, never scraped
  icp                   Json
  swot                  Json
  opportunities         Json
  confidence            Json // { fieldName: 0-100 }
  unknownFields         String[] // field names the AI could not verify — rendered as explicit blanks, never guessed

  // ---- Executive Board Meeting output (runs automatically, before human review) ----
  executiveMeetingId String? @unique

  // ---- Draft configuration proposal — see auto-configure.ts; applied only after Approve ----
  draftConfiguration Json // { dealStageRenames[], dashboardWidgets[], workflowTemplateKeys[], knowledgeArticles[] }

  reviewedByUserId String?
  reviewedAt       DateTime?
  rejectionReason  String?   @db.Text

  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  websiteScan      WebsiteScan?             @relation(fields: [websiteScanId], references: [id], onDelete: SetNull)
  executiveMeeting Meeting?                 @relation(fields: [executiveMeetingId], references: [id], onDelete: SetNull)
  competitors      OrganizationCompetitor[]
  discoveryRun     CompanyDiscoveryRun?

  createdAt DateTime @default(now())

  @@index([organizationId, version])
}

// Competitors are always AI-web-search summaries, never a full independent site audit in v1 —
// `verificationMethod` stays "ai-web-search" so the review UI never mislabels this as verified.
model OrganizationCompetitor {
  id                 String   @id @default(cuid())
  organizationDnaId  String
  name               String
  website            String?
  strengths          String[]
  weaknesses         String[]
  positioning        String?  @db.Text
  verificationMethod String

  organizationDna OrganizationDNA @relation(fields: [organizationDnaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationDnaId])
}

// ============================= Autonomous AI Business Development System (Phase 17) =============================
// Continuous, scheduled discovery/research/scoring/forecasting layered on top of
// existing Lead Finder, Company Intelligence, Lead Scoring, Outreach, Analytics,
// and the Executive Board meeting engine — no engine here is a rebuild of any of
// those; see src/lib/business-development/*.ts for the orchestration.

enum OutreachAutoMode {
  DRAFT_ONLY // AI drafts, a human sends manually — today's exact behavior, the default
  QUEUE_FOR_APPROVAL // AI drafts + auto-requests approval via the existing Approval model
  AUTO_SEND // only reachable if an OWNER explicitly sets this; every send is still logged/audited
}

// Per-organization control panel — every capability defaults OFF/conservative
// since this creates real CRM data and spends real AI credits unattended.
model LeadDiscoveryConfig {
  id               String           @id @default(cuid())
  organizationId   String           @unique
  discoveryEnabled Boolean          @default(false)
  // Owner-defined search queries, e.g. "fintech companies in UAE". Empty means
  // the discovery job derives queries from Organization.industry/clientTypes/
  // countriesServed instead.
  searchQueries    String[]
  // Optional override of lead-scoring.ts's 9 factor weights — { industryMatch,
  // companySize, growth, technologyFit, opportunitySize, budgetPotential,
  // location, digitalMaturity, automationNeed: number }. Null = existing plain
  // average (zero behavior change for orgs that never touch this).
  scoringWeights   Json?
  outreachAutoMode OutreachAutoMode @default(DRAFT_ONLY)
  updatedByUserId  String?
  updatedAt        DateTime         @updatedAt
  createdAt        DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// Structured, categorized opportunity per discovered Company — "Website
// Redesign / ERP / CRM / AI Automation / Cloud Migration / ..." from the
// spec. Distinct from the org's-own-website Opportunity model (Phase 8) —
// this is per lead/client Company, not the platform tenant's own site.
model LeadOpportunity {
  id                 String   @id @default(cuid())
  companyId          String
  category           String
  title              String
  description        String   @db.Text
  estimatedImpact    String
  estimatedValue     Float?
  evidence           String   @db.Text
  confidenceScore    Int
  generatedByAgentId String?
  createdAt          DateTime @default(now())

  // Phase 2: KVL service catalog matching. `recommendedService` stores a
  // KVLServiceId string (e.g. "WEBSITE_DEVELOPMENT") — plain String, not a
  // Prisma enum, since the catalog lives in application code
  // (kvl-service-catalog.ts) per the spec's "do not hardcode service logic
  // inside UI/schema" intent; application-level validation (Zod, matched
  // against KVL_SERVICES) is more appropriate than a rigid DB enum that
  // would need a migration every time a service is added/renamed.
  recommendedService String?
  serviceMatchScore  Int?
  serviceMatchReason String?           @db.Text
  status             OpportunityStatus @default(NEW)
  updatedAt          DateTime          @updatedAt

  // Phase 2: AI Opportunity Brief — the two genuinely new fields the brief
  // needs beyond what's already stored above (Company Overview/Business
  // Context are composed at read time from Company + CompanyIntelligence,
  // see opportunity-brief.ts). Both are grounded in the same evidence
  // already required for the opportunity itself — never generic boilerplate.
  salesAngle String? @db.Text
  nextStep   String? @db.Text

  // Phase 4: "How relevant and actionable is this detected opportunity?" —
  // a weighted blend of problem severity, service match, evidence quality,
  // buying intent (IntentScore, reused not recomputed) and business
  // relevance (LeadScore.overallScore, reused not recomputed). See
  // src/lib/business-development/opportunity-priority.ts for the formula.
  // `opportunityScoreBreakdown` is the same transparent-breakdown discipline
  // as IntentScore.signals: { problemSeverity, serviceMatch, evidenceQuality,
  // intent, businessRelevance, total }. `priority` is the configurable
  // HOT/HIGH/MEDIUM/NURTURE/LOW/DISQUALIFIED bucket derived from the total,
  // with DISMISSED opportunities always forced to DISQUALIFIED regardless
  // of score. Nullable — pre-Phase-4 rows haven't been scored yet.
  opportunityScore          Int?
  opportunityScoreBreakdown Json?
  priority                  OpportunityPriority?
  priorityReasoning         String?              @db.Text

  // Priority Queue triage — trend arrow needs the score from before the most
  // recent recompute (set inside computeOpportunityScore, see
  // opportunity-priority.ts); ownerUserId/snoozedUntil back the "Assign to
  // me" and "Snooze" inline actions on that same page.
  previousOpportunityScore Int?
  ownerUserId              String?
  snoozedUntil             DateTime?

  company        Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner          User?   @relation("OpportunityOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  // Phase 13: the real Deal(s) this opportunity was converted into. Many-valued
  // for the same "never fail a write over an edge case" reasoning as
  // Lead.convertedDeals — the UI enforces "convert once" via isTerminal().
  convertedDeals Deal[]

  @@index([companyId, createdAt])
  @@index([ownerUserId])
}

enum OpportunityStatus {
  NEW
  REVIEWED
  ADDED_TO_CRM
  DISMISSED
}

enum OpportunityPriority {
  HOT
  HIGH
  MEDIUM
  NURTURE
  LOW
  DISQUALIFIED
}

model BuyerPersona {
  id               String   @id @default(cuid())
  companyId        String
  likelyTitle      String
  description      String   @db.Text
  painPoints       String[]
  preferredChannel String?
  confidenceScore  Int
  // True only when a real Contact row on this company has a matching title —
  // a plain DB check, never AI-asserted.
  isVerified       Boolean  @default(false)
  createdAt        DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

// Recurring re-run of the AI Company Understanding Engine's discoverCompetitors()
// — history + diff, not a one-time snapshot.
model CompetitorSnapshot {
  id             String   @id @default(cuid())
  organizationId String
  competitors    Json
  // Competitor names present now but not in the immediately-previous snapshot.
  newlyDetected  String[]
  // Free-form AI notes on industry trends / new categories / partnership
  // signals — always rendered under an explicit "AI analysis" label, never
  // presented as verified fact.
  marketSignals  Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

enum BriefingType {
  DAILY
  WEEKLY
  MONTHLY
  // Phase 19: Customer Success Agent's portfolio-scoped digest — same
  // ExecutiveBriefing shape, no new model.
  CUSTOMER_SUCCESS
}

// Durable record of every generated briefing — real counts/values denormalized
// at generation time so history remains accurate even as the live pipeline
// changes later. Delivered via the existing notifyOrganizationOwners/
// emailOrganizationOwners — no new delivery channel.
model ExecutiveBriefing {
  id                    String       @id @default(cuid())
  organizationId        String
  type                  BriefingType
  newLeadsCount         Int
  opportunities         Json
  pendingApprovalsCount Int
  revenueForecast       Json
  risks                 String[]
  recommendedActions    String[]
  // Phase 10 (Autonomous Growth Operating System): real, deterministic Phase
  // 1-9 grounding data pulled in alongside the pre-existing fields above —
  // new/HOT LeadOpportunity counts, Reply counts by intent, at-risk (no
  // recent activity) Deal count, pending Proposal count/aging,
  // ReferralPartner candidate count, and a computeAcquisitionOverview()
  // snapshot. Nullable so every pre-Phase-10 briefing row stays valid
  // without a backfill. See GrowthSignals in src/lib/ai/executive-briefing.ts
  // for the exact shape — same "denormalize the real numbers at generation
  // time" reasoning as every other field on this model.
  growthSignals         Json?
  // The ONLY AI-generated field on this model — a CEO-voice paragraph that
  // reformats/prioritizes the deterministic fields above. Every other field
  // is a plain Prisma aggregate computed before this is generated.
  narrativeSummary      String?      @db.Text
  createdAt             DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type, createdAt])
}

// ============================= AI Business Growth Engine =============================
// Executive-intelligence layer built on top of everything above — CRM, Client
// Portal, Alerts, Projects, Proposals, Insights, and the AI Company
// Understanding Engine. Nothing here re-derives data another model already
// owns; every score/prediction traces to a real Prisma aggregate or is
// honestly flagged as a neutral fallback (never a fabricated number), and
// every AI-generated field is structurally separate from deterministic ones.
// See src/lib/clients/, src/lib/growth/, src/lib/pipeline/,
// src/lib/market-intelligence/, src/lib/strategy/, src/lib/ai/executive-briefing.ts.

enum ClientHealthClassification {
  HEALTHY
  NEEDS_ATTENTION
  HIGH_RISK
}

// One row per client per day — deterministic composite of real signals
// already tracked elsewhere (Invoice payment behavior, Project delivery
// health, Contract/Subscription renewal status, recency of activity). Any
// factor with no backing data (e.g. a client with zero invoices) uses the
// documented neutral fallback (50) and is flagged isNeutralFallback in
// factorsJson — never presented as a real measurement.
model ClientHealthSnapshot {
  id              String                     @id @default(cuid())
  organizationId  String
  clientId        String
  date            DateTime                   @db.Date
  overallScore    Int
  classification  ClientHealthClassification
  paymentScore    Int
  engagementScore Int
  deliveryScore   Int
  contractScore   Int
  // 0-100: % of the 4 factors above backed by real (non-fallback) data.
  dataConfidence  Int
  factorsJson     Json
  createdAt       DateTime                   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, date])
  @@index([organizationId, date])
}

// One row per org per day — a composite of the 10 spec'd Growth Score axes.
// customerSuccessScore is derived from ClientHealthSnapshot; the rest reuse
// computeCompanyHealth()'s existing sales/marketing/automation/ai axes plus
// three new ones. customerSatisfactionScore has NO real data source anywhere
// in this schema (no NPS/CSAT field exists) and is always 50 with
// axisConfidence.customerSatisfactionScore = 0 — an honest "unknown", not an
// invented number.
model GrowthScoreSnapshot {
  id                        String   @id @default(cuid())
  organizationId            String
  date                      DateTime @db.Date
  salesScore                Int
  marketingScore            Int
  customerSuccessScore      Int
  operationsScore           Int
  financeScore              Int
  productivityScore         Int
  aiAdoptionScore           Int
  automationScore           Int
  technologyScore           Int
  customerSatisfactionScore Int
  overallScore              Int
  // {axisName: 0-100} — per-axis confidence, so a UI can visibly distinguish
  // a real measurement from a neutral placeholder for any axis.
  axisConfidence            Json
  createdAt                 DateTime @default(now())

  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  improvementPlans GrowthImprovementPlan[]

  @@unique([organizationId, date])
  @@index([organizationId, date])
}

// AI-generated narrative + action list grounded in one specific
// GrowthScoreSnapshot's real axis values — never generated in a vacuum.
model GrowthImprovementPlan {
  id                 String   @id @default(cuid())
  organizationId     String
  snapshotId         String
  recommendations    Json
  narrativeSummary   String   @db.Text
  confidenceScore    Int
  generatedByAgentId String?
  createdAt          DateTime @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshot     GrowthScoreSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// Latest-only per client (unique clientId) — deterministic weighted combo of
// that client's latest ClientHealthSnapshot factors. `reasons` is always
// deterministic (a plain breakdown of which factors drove the score);
// `aiNarrative` is optional, generated only above a risk threshold, and kept
// structurally separate so it can never be mistaken for the deterministic
// reasons.
model ChurnRiskAssessment {
  id                 String    @id @default(cuid())
  organizationId     String
  clientId           String    @unique
  probabilityScore   Int
  riskLevel          RiskLevel
  reasons            Json
  aiNarrative        String?   @db.Text
  recommendedActions String[]  @default([])
  confidenceScore    Int
  generatedByAgentId String?
  computedAt         DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId, riskLevel])
}

enum ClientOpportunityKind {
  UPSELL
  CROSS_SELL
  REFERRAL
}

enum ClientOpportunityStatus {
  SUGGESTED
  ACTED_ON
  DISMISSED
}

// One model, kind-discriminated (mirrors how AlertType differentiates rows
// within one Alert table) instead of three near-identical Upsell/Cross-sell/
// Referral models. "Act on this" in the UI always routes into an existing
// gated flow (Proposal draft creation) — this model itself never executes
// anything.
model ClientOpportunity {
