// Recurring AI web-search scan for industry/AI/software-demand trends —
// same discipline as CompetitorSnapshot/discoverCompetitors(): every trend
// is stamped with a verificationMethod and rendered under an explicit
// "AI web search — not independently verified" badge, never presented as
// verified fact.
model MarketTrendSnapshot {
  id                 String   @id @default(cuid())
  organizationId     String
  industry           String?
  // Null = the org's own scheduled/self trend snapshot (discoverMarketTrends).
  // Set = an ad-hoc Research Agent brief for a specific company/topic
  // (generateResearchBrief), stored in the same model rather than a parallel one.
  topic              String?
  trends             Json
  opportunities      Json?
  verificationMethod String   @default("ai-web-search")
  createdAt          DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

enum StrategicPlanHorizon {
  DAYS_30
  DAYS_90
  DAYS_180
  DAYS_365
}

enum StrategicPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// Generated on-demand only (owner clicks "Generate N-day plan"), never on a
// cron — a strategic plan shouldn't silently regenerate and go stale
// unattended. Starts DRAFT; an owner reviewing and setting reviewedByUserId/
// reviewedAt (mirroring OrganizationDNA's review pattern) is the human gate
// before a plan is treated as ACTIVE guidance.
model StrategicPlan {
  id                 String               @id @default(cuid())
  organizationId     String
  horizon            StrategicPlanHorizon
  status             StrategicPlanStatus  @default(DRAFT)
  title              String
  narrativeSummary   String               @db.Text
  goals              Json
  // Denormalized real numbers (growth score, pipeline totals, forecast,
  // open risks) this plan was generated from — same precedent as
  // ExecutiveBriefing's own denormalization, so history stays accurate even
  // as the live pipeline changes later.
  groundedInSnapshot Json
  confidenceScore    Int
  generatedByAgentId String?
  reviewedByUserId   String?
  reviewedAt         DateTime?
  createdAt          DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, horizon, createdAt])
}

