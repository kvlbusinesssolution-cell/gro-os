enum IntegrationStatus {
  NOT_CONNECTED
  CONNECTED
  ERROR
  EXPIRED
}

// One connected third-party account per (organization, provider) — the
// Integration Layer's persisted state (src/lib/integrations/*). Never
// created/marked CONNECTED except after a real OAuth code exchange
// succeeds; accessToken/refreshToken are AES-256-GCM ciphertext (see
// src/lib/integrations/crypto.ts, INTEGRATION_TOKEN_ENCRYPTION_KEY — a
// separate key from AgentMemory's AGENT_MEMORY_ENCRYPTION_KEY so rotating
// one never silently breaks the other). No credentials are ever stored in
// plaintext.
model IntegrationConnection {
  id             String                 @id @default(cuid())
  organizationId String
  provider       IntegrationProviderKey
  category       IntegrationCategory
  status         IntegrationStatus      @default(NOT_CONNECTED)

  // AES-256-GCM ciphertext (base64: iv + authTag + ciphertext). Null until a
  // real token exchange has happened.
  encryptedAccessToken  String?   @db.Text
  encryptedRefreshToken String?   @db.Text
  tokenExpiresAt        DateTime?
  scopes                String[]

  connectedByUserId String?
  lastSyncAt        DateTime?
  lastHealthCheckAt DateTime?
  lastError         String?   @db.Text
  // Provider-specific non-secret bits (e.g. DocuSign account/base URI,
  // connected mailbox address) — never a secret, those live in the
  // encrypted fields above.
  metadata          Json?

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedByUser User?        @relation(fields: [connectedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, provider])
  @@index([organizationId, status])
}

// Real versioned project files — distinct from the generic Document model
// (which stays the flat, unversioned store for proposals/contracts/company-
// level files). A ProjectFile is a logical file identity; every upload
// (including the first) creates a new ProjectFileVersion, never overwrites
// storage in place, so version history is real and browsable.
model ProjectFile {
  id               String  @id @default(cuid())
  organizationId   String
  projectId        String
  name             String
  folder           String?
  // Gates whether the Client Portal's file list can show this row — never
  // shown to a client by default, same convention as Document.visibleToClient.
  visibleToClient  Boolean @default(false)
  uploadedByUserId String?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions     ProjectFileVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([projectId])
}

model ProjectFileVersion {
  id               String  @id @default(cuid())
  projectFileId    String
  versionNumber    Int
  // Relative path under storage/project-files/ — same auth-gated streaming
  // convention as Document.storageKey, never under public/.
  storageKey       String
  mimeType         String
  sizeBytes        Int
  changeNote       String?
  uploadedByUserId String?

  projectFile ProjectFile @relation(fields: [projectFileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectFileId, versionNumber])
  @@index([projectFileId])
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

// A dedicated, real model for meeting/decision-sourced action items —
// previously only implicit via Recommendation/Task. Distinct from Task:
// an ActionItem always traces back to the real meeting/decision that
// created it (never fabricated), and Recommendation stays the AI's own
// suggestion log (a different concept — a recommendation may never become
// an action item at all).
model ActionItem {
  id                String           @id @default(cuid())
  organizationId    String
  projectId         String?
  meetingId         String?
  decisionId        String?
  title             String
  description       String?          @db.Text
  assignedToUserId  String?
  assignedToAgentId String?
  dueDate           DateTime?
  status            ActionItemStatus @default(OPEN)
  // Reuses the existing MessagePriority enum rather than declaring a
  // duplicate (same convention Task.priority already follows).
  priority          MessagePriority  @default(NORMAL)
  // The one metric that proves this item worked, and the concrete business
  // impact it's expected to have — set by the AI Executive Board's
  // execution-plan generation (generateMeetingSummary) or, for a manually
  // created item, by whoever created it. Both optional: not every action
  // item comes with a defined KPI.
  kpi               String?          @db.Text
  expectedImpact    String?          @db.Text
  // Set when an ActionItem is promoted into a real, trackable Task — never
  // required, since not every action item needs the full Task workflow.
  taskId            String?          @unique

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  meeting      Meeting?     @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  decision     Decision?    @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@index([meetingId])
}

enum BugSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BugStatus {
  OPEN
  IN_PROGRESS
  FIXED
  VERIFIED
  WONT_FIX
}

// A dedicated QA/bug-tracking model with real fields Task never had
// (severity, reproduction steps, environment) — previously only implicit
// via Task.type === "BUG" + labels. Optionally links to a real Task for
// assignment/workflow, so a bug can still be worked the same way as any
// other task once triaged, without losing its QA-specific detail.
model BugReport {
  id               String      @id @default(cuid())
  organizationId   String
  projectId        String
  taskId           String?     @unique
  title            String
  description      String      @db.Text
  severity         BugSeverity @default(MEDIUM)
  reproSteps       String?     @db.Text
  environment      String?
  reportedByUserId String?
  status           BugStatus   @default(OPEN)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@index([status])
}

// ============================= Phase 15: BI / Analytics / Forecasting =============================

enum AlertType {
  REVENUE_DROP
  REVENUE_SPIKE
  PIPELINE_DECLINE
  CLIENT_CHURN_RISK
  DEAL_STALLED
  BUDGET_OVERRUN
  LATE_PAYMENT
  PROJECT_DELAY
  SECURITY_RISK
  // Business Risk Engine additions
  REVENUE_CONCENTRATION
  RESOURCE_SHORTAGE
  // Phase 19: Support Agent — a real TaskType.SUPPORT Task past its due
  // date (used as the SLA deadline) and still open.
  SUPPORT_SLA_BREACH
  // Phase 19: HR Agent — a real LeaveRequest sitting PENDING too long.
  LATE_LEAVE_APPROVAL
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

// Deterministic, rule-evaluated alerts (src/lib/alerts/*) — every trigger
// traces to a real Prisma aggregate crossing a documented threshold, never
// an LLM guess. Alerts PRODUCE Notifications via the existing
// notifyOrganizationOwners pipeline; they don't replace them — same
// relationship ProjectRisk already has to DELIVERY_HEALTH_DROPPED.
model Alert {
  id                    String      @id @default(cuid())
  organizationId        String
  type                  AlertType
  severity              RiskLevel
  status                AlertStatus @default(ACTIVE)
  title                 String
  message               String      @db.Text
  // Polymorphic pointer (mirrors AuditLog.metadata's Json approach) — the
  // related entity varies by AlertType (Deal, Client, Invoice, Project,
  // Company), no dedicated FK per type.
  relatedEntityType     String?
  relatedEntityId       String?
  metricValue           Float?
  thresholdValue        Float?
  formula               String      @db.Text
  // AI-generated, grounded strictly in this alert's own title/message/formula
  // — an enrichment only, generated once on create/reactivate. Empty when AI
  // is unavailable or generation fails; never blocks alert creation.
  mitigationSuggestions String[]    @default([])

  triggeredAt          DateTime  @default(now())
  acknowledgedAt       DateTime?
  acknowledgedByUserId String?
  resolvedAt           DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, type, relatedEntityId])
  @@index([organizationId, status])
}

enum SubscriptionBillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

