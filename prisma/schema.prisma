  BOARD_REVIEW_COMPLETED
  PROJECT_CREATED
  MILESTONE_COMPLETED
  RISK_DETECTED
  DEADLINE_APPROACHING
  CLIENT_COMMENT_ADDED
  CLIENT_APPROVED_MILESTONE
  // Added for the AI Delivery Board (Phase 5) — everything else the brief's
