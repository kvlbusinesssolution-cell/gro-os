  changeNote      String?
  changedByUserId String?

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  changedByUser User?        @relation("DocumentVersionChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

