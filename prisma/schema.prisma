enum BackupType {
  DATABASE
  STORAGE
  CONFIGURATION
  SECRETS
}

enum BackupStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

// A real backup run record — see scripts/backup-database.sh /
// src/lib/ops/backup.ts. `storageKey`/`sizeBytes` are only ever set once a
// real backup artifact actually exists on disk; a FAILED row never claims
// a storageKey.
model Backup {
  id          String       @id @default(cuid())
  type        BackupType
  status      BackupStatus @default(RUNNING)
  storageKey  String?      @db.Text
  sizeBytes   BigInt?
  checksum    String?
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  error       String?      @db.Text

  restores Restore[]

  @@index([type, startedAt])
}

enum RestoreStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

// A real restore-test/restore-execution record — restore TESTING
// (verifying a backup is actually restorable, per the spec's "Restore
// Testing") uses the same model with `isTest: true` against a scratch
// target, never production, so a restore test can never be confused with a
// real disaster-recovery restore in this table's history.
model Restore {
  id          String        @id @default(cuid())
  backupId    String
  isTest      Boolean       @default(true)
  status      RestoreStatus @default(RUNNING)
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  error       String?       @db.Text

  backup Backup @relation(fields: [backupId], references: [id], onDelete: Cascade)

  @@index([backupId])
