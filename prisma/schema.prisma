  PAYMENT
  BOOKING
  CRM_INDICATOR
  MESSAGING
  OTHER
}

enum OpportunityBand {
  HIGH
  MEDIUM
  LOW
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

enum RecommendationCategory {
  ERP
  CRM
  HRMS
  HOSPITAL_MANAGEMENT
  SCHOOL_ERP
  INVENTORY
  POS
  BILLING
  ACCOUNTING
  WAREHOUSE
  AI_CHATBOT
