// ============================= Phase 12: Enterprise Document Generation =============================
//
// Proposal (extended above) stays the flagship AI-authored document.
// Quotation/Contract/Invoice get dedicated models because they carry real
// structured/relational data (line items, tax math, signature/payment
// state) that Proposal doesn't. Every other "generate title + rich text,
// link to a company/deal/project, track status" document kind (NDA, MSA,
// SLA, Terms, Privacy Agreement, Acceptance Letter, Delivery Certificate,
// Scope of Work, Requirement Specification, Technical Architecture,
// Project Roadmap, Risk Register, Acceptance Criteria, Project Plan,
// Business Report) shares ONE model (BusinessDocument) discriminated by
// `kind` — building 14 near-identical tables would be pure duplication.
//
// DocumentVersion and Signature are intentionally polymorphic (docKind +
// docId, no hard FK) since Prisma has no native polymorphic relation and
// a real FK would require picking one target table — the same
// loose-reference pattern already used by Activity.metadata's dealId.
// Referential integrity for these two is enforced in application code.

enum DocumentKind {
  PROPOSAL
  QUOTATION
  CONTRACT
  INVOICE
  BUSINESS_DOCUMENT
}

