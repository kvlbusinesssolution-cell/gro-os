generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================= Auth.js core =============================

model User {
  id               String    @id @default(cuid())
  name             String?
  firstName        String?
  lastName         String?
  email            String?   @unique
  emailVerified    DateTime?
  // Public-facing value — either an external URL (legacy: pasted directly,
  // or an OAuth provider's own avatar URL) or our own serving route
  // (/api/users/{id}/avatar) once avatarStorageKey is set below.
  image            String?
  // Real on-disk storage key for a self-hosted avatar upload (src/lib/
  // storage/avatars.ts) — null when the user has no uploaded photo (still
  // using an external `image` URL, or no photo at all). Mirrors
  // WhiteLabelSettings.logoStorageKey's exact pattern.
  avatarStorageKey String?
  password         String?

  phone    String?
  country  String?
  language String?
  timezone String?
  jobTitle String?

  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  // Persistent lockout — distinct from the in-memory rolling rate limiter in
  // src/lib/rate-limit.ts. That limiter throttles attempts per email+IP and
  // resets on process restart; this is a real, durable lock independent of
  // which IP is attempting, cleared only after lockedUntil elapses or a
  // successful sign-in.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Set to now() by "Logout everywhere" (src/app/profile/actions.ts,
  // signOutAllDevices). Because this app uses stateless JWT sessions
  // (session.strategy === "jwt" in src/auth.ts), an already-issued JWT
  // can't be revoked server-side by deleting a row — the jwt() callback
  // instead compares this timestamp against the token's own signedInAt
  // claim on every request and rejects (forces re-auth) any token minted
  // before it. Null means the account has never had a mass logout.
  sessionInvalidatedAt DateTime?

  onboardingCompletedAt DateTime?

  // Phase 18: a platform-operator identity distinct from any organization's
  // own OWNER/ADMIN role — gates the cross-tenant Admin Billing Dashboard
  // (MRR/ARR/churn across every organization). Never settable via any
  // organization-scoped action; only ever flipped directly in the database
  // by whoever operates this deployment.
  isPlatformOwner Boolean @default(false)

  accounts              Account[]
  sessions              Session[]
  deviceSessions        DeviceSession[]
  authenticators        Authenticator[]
  tokens                UserToken[]
  apiKeys               ApiKey[]
  memberships           Membership[]
  sentInvitations       Invitation[]            @relation("InvitationSender")
  auditLogs             AuditLog[]
  connectedIntegrations IntegrationConnection[]
  preference            UserPreference?

  createdMeetings           Meeting[]
  meetingParticipation      MeetingParticipant[]
  meetingMessages           MeetingMessage[]
  tasksAssignedByMe         Task[]               @relation("TaskAssignedByUser")
  tasksAssignedToMe         Task[]               @relation("TaskAssignedToUser")
  notifications             Notification[]
  activities                Activity[]
  dashboards                Dashboard[]
  createdDashboardTemplates DashboardTemplate[]  @relation("DashboardTemplateCreatedBy")

  ownedProjects                Project[]                 @relation("ProjectOwner")
  createdProposals             Proposal[]                @relation("ProposalCreatedBy")
  uploadedDocuments            Document[]                @relation("DocumentUploadedBy")
  createdArticles              KnowledgeArticle[]        @relation("ArticleCreatedBy")
  articleVersionsEdited        KnowledgeArticleVersion[] @relation("KnowledgeArticleVersionEditor")
  knowledgeAttachmentsUploaded KnowledgeAttachment[]     @relation("KnowledgeAttachmentUploader")
  ingestedDocumentsUploaded    IngestedDocument[]        @relation("IngestedDocumentUploader")
  searchHistory                SearchHistory[]
  bookmarks                    Bookmark[]
  marketplaceInterests         MarketplaceInterest[]     @relation("MarketplaceInterestUser")
  ownedCompanies               Company[]                 @relation("CompanyOwner")
  createdWatchlists            Watchlist[]
  watchlistAdditions           WatchlistCompany[]
  savedSearches                SavedSearch[]
  websiteScansCreated          WebsiteScan[]
  ownedContacts                Contact[]                 @relation("ContactOwner")
  createdCampaigns             Campaign[]
  approvedEmailDrafts          EmailDraft[]              @relation("EmailDraftApprovedBy")
  approvalDecisions            Approval[]
  loggedReplies                Reply[]

  ownedDeals Deal[]     @relation("DealOwner")
  reminders  Reminder[]

  createdQuotations        Quotation[]        @relation("QuotationCreatedBy")
  createdContracts         Contract[]         @relation("ContractCreatedBy")
  createdInvoices          Invoice[]          @relation("InvoiceCreatedBy")
  createdBusinessDocuments BusinessDocument[] @relation("BusinessDocumentCreatedBy")
  createdDocumentTemplates DocumentTemplate[] @relation("DocumentTemplateCreatedBy")
  documentVersionsChanged  DocumentVersion[]  @relation("DocumentVersionChangedBy")
  signaturesRequested      Signature[]        @relation("SignatureRequestedBy")

  boardReviewsRequested  BoardReview[]                @relation("BoardReviewRequestedBy")
  boardReviewsOverridden BoardReview[]                @relation("BoardReviewOverriddenBy")
  approvalPolicyUpdates  OrganizationApprovalPolicy[]

  projectMemberships ProjectMember[]
  timeEntries        TimeEntry[]
  comments           Comment[]
  deliveryReports    DeliveryReport[]
  partner            Partner?
  securityEvents     SecurityEvent[]
  deployments        Deployment[]

  // Marketplace & AI Skills Ecosystem (Phase 19)
  marketplacePublisherProfile MarketplacePublisher? @relation("MarketplacePublisherUser")
  createdMarketplaceVersions  MarketplaceVersion[]  @relation("MarketplaceVersionCreatedBy")
  marketplaceInstallsMade     MarketplaceInstall[]  @relation("MarketplaceInstalledBy")
  marketplaceInstallsRemoved  MarketplaceInstall[]  @relation("MarketplaceUninstalledBy")
  marketplaceReviews          MarketplaceReview[]   @relation("MarketplaceReviewAuthor")
  marketplaceOrdersPurchased  MarketplaceOrder[]    @relation("MarketplaceOrderBuyer")
  createdPromptTemplates      PromptTemplate[]      @relation("PromptTemplateCreatedBy")
  createdJobOpenings          JobOpening[]          @relation("JobOpeningCreatedBy")
  interviewsConducted         Interview[]           @relation("InterviewInterviewer")
  leaveRequests               LeaveRequest[]        @relation("LeaveRequestUser")
  leaveRequestsApproved       LeaveRequest[]        @relation("LeaveRequestApprovedBy")

  // Global Launch & Enterprise Readiness (Phase 20)
  consentRecords ConsentRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// The Auth.js Prisma adapter's expected shape for WebAuthn/passkey
// credentials (credentialID/providerAccountId/etc. naming is fixed by the
// adapter contract, not a stylistic choice).
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

enum UserTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

// Single-use, hashed-at-rest tokens for "prove you own this email" flows —
// mirrors ClientAuthToken's real pattern (src/lib/client-portal/tokens.ts)
// applied to main-app Users instead of client-portal users.
model UserToken {
  id         String           @id @default(cuid())
  userId     String
  purpose    UserTokenPurpose
  tokenHash  String           @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// Real, user-generated API keys for programmatic access — the key itself is
// shown once at creation time and only its SHA-256 hash + a short display
// prefix are ever persisted.
model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  name           String
  prefix         String
  hashedKey      String    @unique
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  // Closed set of permission strings this key is allowed to use — see
  // API_KEY_SCOPES in src/lib/auth/api-key-scopes.ts for the authoritative
  // list and per-scope descriptions. Empty means the key can authenticate
  // but is not granted any scoped capability.
  scopes           String[] @default([])
  // Requests/hour enforced per-key by checkApiKeyRateLimit (src/lib/auth/api-key.ts)
  // via the in-memory limiter in src/lib/rate-limit.ts.
  rateLimitPerHour Int      @default(1000)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
}

// Independent of Auth.js's own Session table — populated on every successful
// sign-in (any provider) purely to power the "active devices / device history"
// UI. Not used for request authentication.
model DeviceSession {
  id           String   @id @default(cuid())
  userId       String
  ipAddress    String?
  userAgent    String?
  deviceName   String?
  trusted      Boolean  @default(false)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  // Real composite client-side fingerprint (SHA-256 of timezone + screen
  // resolution + platform + hardwareConcurrency, collected by
  // src/lib/device-fingerprint.ts and submitted via a Server Action once per
  // session) — a stronger "is this the same physical device" signal than the
  // existing userId+userAgent heuristic alone, since a User-Agent string is
  // identical across every install of the same browser/OS combination. Kept
  // alongside, not instead of, that heuristic: this column is best-effort
  // (nullable) because it requires client-side JS to run before it's known,
  // and is never treated as a stronger identity check than the sign-in
  // itself, only as an additional device-matching signal.
  fingerprintHash String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fingerprintHash])
}

model UserPreference {
  id                   String  @id @default(cuid())
  userId               String  @unique
  theme                String  @default("dark")
  locale               String  @default("en")
  emailNotifications   Boolean @default(true)
  browserNotifications Boolean @default(true)
  slackNotifications   Boolean @default(false)
  teamsNotifications   Boolean @default(false)
  slackWebhookUrl      String?
  teamsWebhookUrl      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================= Organizations / multi-tenancy =======================

enum CompanySize {
  SIZE_1_10
  SIZE_11_50
  SIZE_51_200
  SIZE_201_1000
  SIZE_1000_PLUS
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  SALES
  MARKETING
  DEVELOPER
  SUPPORT
  FINANCE
  HR
  VIEWER
  AI_AGENT
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Organization {
  id   String @id @default(cuid())
  slug String @unique

  name               String
  logo               String?
  banner             String?
  industry           String?
  website            String?
  email              String?
  phone              String?
  gstNumber          String?
  registrationNumber String?
  linkedin           String?
  facebook           String?
  twitter            String?
  description        String?  @db.Text
  mission            String?  @db.Text
  vision             String?  @db.Text
  values             String[]

  companySize     CompanySize?
  annualRevenue   String?
  primaryMarket   String?
  countriesServed String[]
  primaryLanguage String?
  currency        String?
  timezone        String?

  services    String[]
  clientTypes String[]
  aiGoals     String[]

  // Tracks progress through the /onboarding wizard so a returning user can be
  // resumed on the right step and so "jump to a previously-completed step"
  // navigation can be gated. 0 = just created (no step saved yet), 1 =
  // company profile saved, 2 = business details saved, 3 = services & goals
  // saved (wizard complete, ready to hand off to the AI-agent intro step).
  onboardingStep Int @default(0)

  workingHours    Json?
  officeLocations Json?
  certificates    Json?
  awards          Json?

  // Phase 18: Agency Reseller Portal — an agency organization creates and
  // manages child tenant organizations under it (real parent/child, not a
  // membership/role trick). `isAgency` gates the Agency Portal UI itself;
  // `parentAgencyOrganizationId` is null for a normal, independent tenant.
  isAgency                   Boolean @default(false)
  parentAgencyOrganizationId String?
  // Phase 18: which Partner (if any) referred this organization, for
  // reseller commission tracking.
  referredByPartnerId        String?
  caseStudies                Json?
  portfolio                  Json?

  memberships Membership[]
  invitations Invitation[]
  workspace   Workspace?
  aiAgents    AIAgentInstance[]
  auditLogs   AuditLog[]

  meetings           Meeting[]
  tasks              Task[]
  decisions          Decision[]
  agentMemories      AgentMemory[]
  agentConversations AgentConversation[]
  notifications      Notification[]
  activities         Activity[]
  dashboards         Dashboard[]
  dashboardTemplates DashboardTemplate[]
  insights           Insight[]

  companies            Company[]
  clients              Client[]
  projects             Project[]
  proposals            Proposal[]
  documents            Document[]
  automationRules      AutomationRule[]
  billingAccount       BillingAccount?
  metricSnapshots      MetricSnapshot[]
  marketplaceInterests MarketplaceInterest[]
  watchlists           Watchlist[]
  savedSearches        SavedSearch[]
  recommendations      Recommendation[]
  websiteScans         WebsiteScan[]
  contacts             Contact[]
  campaigns            Campaign[]
  sequences            Sequence[]
  emailDrafts          EmailDraft[]
  approvals            Approval[]
  replies              Reply[]
  outreachMeetings     OutreachMeeting[]

  deals     Deal[]
  reminders Reminder[]

  // Phase 8: Partner & Referral Client Acquisition Engine — external
  // referral partners (freelancers/agencies/consultants) who refer real
  // prospect Companies into THIS organization's own CRM pipeline. Distinct
  // from the Phase 18 Partner model above (a platform-wide SaaS
  // reseller/affiliate who refers new tenant Organizations and earns
  // commission on their subscription revenue) — see ReferralPartner's own
  // doc comment for the full distinction.
  referralPartners ReferralPartner[]

  quotations        Quotation[]
  contracts         Contract[]
  invoices          Invoice[]
  businessDocuments BusinessDocument[]
  documentTemplates DocumentTemplate[]
  documentVersions  DocumentVersion[]
  signatures        Signature[]

  boardReviews           BoardReview[]
  approvalPolicy         OrganizationApprovalPolicy?
  predictionCalibrations PredictionCalibration[]

  projectMembers         ProjectMember[]
  sprints                Sprint[]
  projectRisks           ProjectRisk[]
  timeEntries            TimeEntry[]
  taskStatusChanges      TaskStatusChange[]
  comments               Comment[]
  clientPortalUsers      ClientPortalUser[]
  projectHealthSnapshots ProjectHealthSnapshot[]
  deliveryReports        DeliveryReport[]
  apiKeys                ApiKey[]
  integrationConnections IntegrationConnection[]
  projectFiles           ProjectFile[]
  actionItems            ActionItem[]
  bugReports             BugReport[]
  alerts                 Alert[]
  subscriptions          Subscription[]
  expenseEntries         ExpenseEntry[]
  workflows              Workflow[]
  eventLogs              EventLog[]
  secrets                Secret[]
  apiUsageRecords        APIUsage[]
  webhooks               Webhook[]
  knowledgeCategories    KnowledgeCategory[]
  knowledgeTags          KnowledgeTag[]
  ingestedDocuments      IngestedDocument[]
  embeddings             Embedding[]
  knowledgeGraphNodes    KnowledgeGraphNode[]
  relationships          Relationship[]
  citations              Citation[]
  searchHistory          SearchHistory[]
  bookmarks              Bookmark[]
  agentMemoryEvents      AgentMemoryEvent[]

  // Phase 18: Subscription/Billing/White Label/Reseller Platform
  platformInvoices           PlatformInvoice[]
  platformPayments           PlatformPayment[]
  usageRecords               UsageRecord[]
  aiUsageEvents              AIUsageEvent[]
  licenses                   License[]
  whiteLabelSettings         WhiteLabelSettings?
  featureOverrides           OrganizationFeatureOverride[]
  parentAgencyOrganization   Organization?                 @relation("AgencyChildren", fields: [parentAgencyOrganizationId], references: [id], onDelete: SetNull)
  agencyManagedOrganizations Organization[]                @relation("AgencyChildren")
  referredByPartner          Partner?                      @relation("ReferredByPartner", fields: [referredByPartnerId], references: [id], onDelete: SetNull)
  securityEvents             SecurityEvent[]

  // AI Company Understanding Engine
  companyDiscoveryRuns CompanyDiscoveryRun[]
  organizationDnas     OrganizationDNA[]

  // Autonomous AI Business Development System (Phase 17)
  leadDiscoveryConfig LeadDiscoveryConfig?
  competitorSnapshots CompetitorSnapshot[]
  executiveBriefings  ExecutiveBriefing[]

  // AI Business Growth Engine
  clientHealthSnapshots  ClientHealthSnapshot[]
  growthScoreSnapshots   GrowthScoreSnapshot[]
  growthImprovementPlans GrowthImprovementPlan[]
  churnRiskAssessments   ChurnRiskAssessment[]
  clientOpportunities    ClientOpportunity[]
  marketTrendSnapshots   MarketTrendSnapshot[]
  strategicPlans         StrategicPlan[]

  // Marketplace & AI Skills Ecosystem (Phase 19)
  marketplaceInstalls  MarketplaceInstall[]
  marketplaceReviews   MarketplaceReview[]
  marketplaceOrders    MarketplaceOrder[]
  promptTemplates      PromptTemplate[]
  jobOpenings          JobOpening[]
  candidates           Candidate[]
  leaveRequests        LeaveRequest[]
  seoKeywordResearches SeoKeywordResearch[]

  // Global Launch & Enterprise Readiness (Phase 20)
  accessReviews  AccessReview[]
  consentRecords ConsentRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  invitedAt      DateTime?
  joinedAt       DateTime         @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
  // The `{ organizationId, status: "ACTIVE" }` filter is the single most
  // common Membership query in this codebase (40+ call sites — every
  // requireActiveMembership-style access check, roster page, and
  // notification fan-out), but the lone `@@index([organizationId])` above
  // only covers the first column; Postgres still has to visit every row for
  // that org and re-check status in a Filter step. This composite index
  // covers the real, verified query shape directly.
  @@index([organizationId, status])
}

model Invitation {
  id             String           @id @default(cuid())
  email          String
  organizationId String
  role           MembershipRole
  token          String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String
  expiresAt      DateTime
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

// ============================= Workspace defaults =============================

model Workspace {
  id             String @id @default(cuid())
  organizationId String @unique
  name           String

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  knowledgeBase  KnowledgeBase?
  pipelineStages PipelineStage[]
  dealStages     DealStage[]

  createdAt DateTime @default(now())
}

model KnowledgeBase {
  id          String @id @default(cuid())
  workspaceId String @unique
  name        String @default("Knowledge Base")

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  articles  KnowledgeArticle[]

  createdAt DateTime @default(now())
}

model PipelineStage {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  order       Int

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads     Lead[]

  @@unique([workspaceId, order])
}

model Lead {
  id                 String  @id @default(cuid())
  pipelineStageId    String
  companyId          String?
  name               String
  company            String?
  email              String?
  // Estimated deal value in the organization's currency — the real (not
  // fabricated) basis for Pipeline Value / Revenue on the Command Center.
  // Null/absent leads simply don't contribute; there is no synthetic default.
  estimatedValue     Float?
  // Referral Engine attribution — set only via an explicit "Referred by"
  // picker on the Lead form, never AI-guessed. Null means "no known
  // referral", not "not referred".
  referredByClientId String?

  pipelineStage    PipelineStage @relation(fields: [pipelineStageId], references: [id], onDelete: Cascade)
  companyRecord    Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  referredByClient Client?       @relation("ClientReferrals", fields: [referredByClientId], references: [id], onDelete: SetNull)
  proposals        Proposal[]
  meetings         Meeting[]
  // Deals this Lead was converted into via "Convert to Deal" — a Lead can
  // only sensibly convert once in normal use, but this is left many-valued
  // (not a unique 1:1) so a mistaken duplicate conversion never fails a
  // write; the UI is what enforces "convert once".
  convertedDeals   Deal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================= Phase 10: Enterprise CRM (Deals) =============================
//
// A second, parallel pipeline sitting alongside Lead/PipelineStage above.
// Lead/PipelineStage stay exactly as they were — they remain the Lead
// Finder's top-of-funnel pipeline. Deal/DealStage is the enterprise
// Sales Pipeline described in the CRM phase brief (New Lead -> Qualified ->
// Research -> Opportunity -> Proposal -> Negotiation -> Contract -> Won ->
// Lost -> Archived), a first-class Opportunity/Deal object that a Lead can
// optionally be converted into. Kept separate rather than overloading Lead
// so Lead Finder's semantics (a raw discovered prospect) never change.

model DealStage {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  order       Int

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deals     Deal[]

  @@unique([workspaceId, order])
}

model Deal {
  id             String  @id @default(cuid())
  organizationId String
  dealStageId    String
  companyId      String?
  contactId      String?
  sourceLeadId   String?
  ownerUserId    String?

  name              String
  // Deal value in the organization's currency — same "real number or null,
  // never fabricated" discipline as Lead.estimatedValue.
  value             Float?
  // 0-100. Null means "not yet estimated" — never defaulted to a guess.
  probability       Int?
  expectedCloseDate DateTime?
  priority          MessagePriority @default(NORMAL)
  products          String[]
  services          String[]
  // Set when the deal lands in a "Lost" stage; null otherwise.
  lostReason        String?
  notes             String?         @db.Text

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealStage    DealStage    @relation(fields: [dealStageId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  sourceLead   Lead?        @relation(fields: [sourceLeadId], references: [id], onDelete: SetNull)
  owner        User?        @relation("DealOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  proposals          Proposal[]
  tasks              Task[]
  documents          Document[]
  reminders          Reminder[]
  quotations         Quotation[]
  contracts          Contract[]
  invoices           Invoice[]
  businessDocuments  BusinessDocument[]
  projects           Project[]
  // Phase 8: Partner & Referral Client Acquisition Engine — commission(s)
  // owed to a ReferralPartner when this Deal is Won. Normally at most one row
  // (the Deal's own referred Company has at most one referralPartnerId), but
  // left many-valued rather than a unique 1:1 for the same "never fail a
  // write over an edge case" reasoning as Lead.convertedDeals.
  partnerCommissions PartnerCommission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([dealStageId])
  @@index([ownerUserId])
  @@index([companyId])
}

enum AgentType {
  CEO
  SALES
  MARKETING
  PROPOSAL
  OUTREACH
  CRM
  ANALYTICS
  FINANCE
  LEGAL
  PROJECT_MANAGER
  // Added for the AI Delivery Board (Phase 5) — CEO and PROJECT_MANAGER are
  // reused as-is, these 3 are net-new seats.
  QA_DIRECTOR
  DEVOPS_DIRECTOR
  DELIVERY_DIRECTOR
  // Added for the Marketplace & AI Skills Ecosystem (Phase 19) — installable
  // via the AI Agent Marketplace, NOT auto-provisioned at onboarding (opt-in
  // by design, same as every other marketplace pack).
  HR
  SUPPORT
  RECRUITMENT
  SEO
  BUSINESS_ANALYST
  RESEARCH
  CUSTOMER_SUCCESS
}

enum AgentStatus {
  IDLE
  THINKING
  RESEARCHING
  PLANNING
  ANALYZING
  WAITING
  COMPLETED
}

model AIAgentInstance {
  id             String    @id @default(cuid())
  organizationId String
  type           AgentType
  name           String
  introMessage   String    @db.Text
  active         Boolean   @default(true)

  // Executive Board live-status fields — updated by the AI runtime as the
  // agent actually works (real Claude calls), never faked/animated client-side.
  status              AgentStatus @default(IDLE)
  currentTask         String?
  currentGoal         String?     @db.Text
  activeWorkflow      String?
  confidenceScore     Float?
  completedTasksCount Int         @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  meetingParticipation       MeetingParticipant[]
  meetingMessages            MeetingMessage[]
  tasksAssignedByMe          Task[]                @relation("TaskAssignedByAgent")
  tasksAssignedToMe          Task[]                @relation("TaskAssignedToAgent")
  decisionVotes              DecisionVote[]
  memories                   AgentMemory[]
  conversationsSent          AgentConversation[]   @relation("ConversationSender")
  conversationsReceived      AgentConversation[]   @relation("ConversationReceiver")
  activities                 Activity[]
  generatedProposals         Proposal[]
  generatedQuotations        Quotation[]
  generatedContracts         Contract[]
  generatedBusinessDocuments BusinessDocument[]
  companyIntelligenceRuns    CompanyIntelligence[]
  researchNotes              ResearchNote[]
  executiveReportsGenerated  ExecutiveReport[]
  emailDraftsGenerated       EmailDraft[]
  detectedProjectRisks       ProjectRisk[]
  companyEvidenceGenerated   CompanyEvidence[]
  decisionMakersGenerated    DecisionMaker[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, type])
}

// ============================= Phase 3: AI Executive Board =============================

enum MeetingStatus {
  SCHEDULED
  LIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model Meeting {
  id               String        @id @default(cuid())
  organizationId   String
  title            String
  agenda           String        @db.Text
  status           MeetingStatus @default(SCHEDULED)
  summary          String?       @db.Text
  // Structured { summary, actionItems[], risks[], recommendations[], nextSteps[] }
  // from generateMeetingSummary — `summary` above stays a flattened text render
  // for backward compatibility with anything reading it directly.
  notesJson        Json?
  // Optional real link to a Lead — the honest, non-fabricated basis for the
  // War Room's "Revenue Opportunity" stat. Null renders as "Not linked".
  relatedLeadId    String?
  // Optional real link to a Project — set for AI Delivery Board meetings
  // (Phase 5), null for every pre-existing War Room / Review Board meeting.
  relatedProjectId String?
  startedAt        DateTime?
  endedAt          DateTime?
  createdById      String

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User                 @relation(fields: [createdById], references: [id], onDelete: Cascade)
  relatedLead     Lead?                @relation(fields: [relatedLeadId], references: [id], onDelete: SetNull)
  relatedProject  Project?             @relation(fields: [relatedProjectId], references: [id], onDelete: SetNull)
  participants    MeetingParticipant[]
  messages        MeetingMessage[]
  decisions       Decision[]
  tasks           Task[]
  boardReview     BoardReview?
  recommendations Recommendation[]
  actionItems     ActionItem[]
  // Reverse side of OrganizationDNA.executiveMeetingId — set only when this meeting was the
  // auto-triggered Executive Board discussion of a freshly-generated Company DNA.
  organizationDna OrganizationDNA?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([relatedProjectId])
}

model MeetingParticipant {
  id        String  @id @default(cuid())
  meetingId String
  agentId   String?
  userId    String?

  meeting Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  agent   AIAgentInstance? @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user    User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([meetingId, agentId])
  @@unique([meetingId, userId])
}

enum MeetingMessageType {
  DISCUSSION
  SUGGESTION
  VOTE
  DECISION
  ACTION_ITEM
  SUMMARY
}

model MeetingMessage {
  id              String             @id @default(cuid())
  meetingId       String
  senderAgentId   String?
  senderUserId    String?
  type            MeetingMessageType @default(DISCUSSION)
  content         String             @db.Text
  // War Room briefing-card fields — populated by runMeetingAgentTurn's
  // structured Claude output for agent messages; left at defaults/null for
  // human messages, which honestly have none of these.
  priority        MessagePriority    @default(NORMAL)
  confidenceScore Float?
  suggestedAction String?            @db.Text
  evidence        String?            @db.Text
  // Populated only for AI Proposal Review Board turns (runReviewAgentTurn) —
  // {opinion, strengths[], weaknesses[], recommendations[{type,title,description}],
  // confidenceScore, winProbability?, profitMarginEstimate?}. Null for every
  // pre-existing/War-Room message; never backfilled or faked.
  reviewJson      Json?

  meeting     Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  senderAgent AIAgentInstance? @relation(fields: [senderAgentId], references: [id], onDelete: Cascade)
  senderUser  User?            @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([meetingId])
}

enum TaskStatus {
  PENDING
  RUNNING
  BLOCKED
  COMPLETED
  CANCELLED
  // Added for the Project Kanban board (Phase 14) — 5 project-lifecycle
  // statuses alongside the 5 original AI-agent-task statuses above, which
  // keep their exact original meaning for the War Room's global task inbox.
  BACKLOG
  REVIEW
  TESTING
  READY_FOR_CLIENT
  ARCHIVED
}

enum TaskType {
  CALL
  EMAIL
  MEETING
  PROPOSAL
  RESEARCH
  FOLLOW_UP
  DOCUMENTATION
  APPROVAL
  DEVELOPMENT
  SUPPORT
  // Added for the AI Delivery Board (Phase 5) — a real "File a Bug" workflow
  // primitive, the input signal for QA_FAILURE risk detection and the
  // Quality Score.
  BUG
}

model Task {
  id                 String          @id @default(cuid())
  organizationId     String
  meetingId          String?
  projectId          String?
  companyId          String?
  contactId          String?
  dealId             String?
  assignedByAgentId  String?
  assignedByUserId   String?
  assignedToAgentId  String?
  assignedToUserId   String?
  title              String
  description        String?         @db.Text
  status             TaskStatus      @default(PENDING)
  result             String?         @db.Text
  dueDate            DateTime?
  priority           MessagePriority @default(NORMAL)
  // 0-100, owner-editable on the War Room Task Board — a real, stored field,
  // not derived from checklist items, even though TaskChecklistItem now
  // exists, since a checklist is optional and a task without one still
  // needs a manually-set progress value.
  progress           Int             @default(0)
  // Carried over from ActionItem.kpi/expectedImpact on promotion
  // (promoteActionItemToTask) — the metric and business impact an AI
  // Executive Board execution plan attached to this item, if any.
  kpi                String?         @db.Text
  expectedImpact     String?         @db.Text
  type               TaskType?
  parentTaskId       String?
  labels             String[]
  isRecurring        Boolean         @default(false)
  // Free-text cadence ("DAILY" | "WEEKLY" | "MONTHLY" | "YEARLY") — no RRULE
  // parser exists in this app, so recurrence is intentionally this simple.
  recurrenceRule     String?
  recurrenceParentId String?

  // ===== Phase 14: Project Management additions =====
  sprintId          String?
  milestoneId       String?
  // Gantt needs a real start, not just dueDate.
  startDate         DateTime?
  estimatedHours    Float?
  // Cached sum of real TimeEntry rows for this task — recomputed by a
  // shared helper (src/lib/projects/health.ts), never hand-typed.
  actualHours       Float?    @default(0)
  visibleToClient   Boolean   @default(false)
  // "Raise Tickets" reuses Task (TaskType.SUPPORT) + this flag instead of a
  // parallel Ticket model — a client-raised ticket is a real Task.
  clientRaised      Boolean   @default(false)
  // Set once TASK_OVERDUE has actually fired for this task (by either the
  // on-write check in task-actions.ts or the real hourly Scheduler Service
  // job in scheduler/registry.ts) — the dedup guard that stops the hourly
  // cron from re-notifying the same overdue task every single run. Cleared
  // whenever dueDate/status changes take the task out of "overdue".
  overdueNotifiedAt DateTime?

  // ---- Phase 19: HR Agent onboarding checklists are real Task rows,
  // reusing the existing Task Board/notification/automation-trigger system
  // instead of a parallel "OnboardingTask" model. ----
  relatedCandidateId String?

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  relatedCandidate Candidate?       @relation(fields: [relatedCandidateId], references: [id], onDelete: SetNull)
  meeting          Meeting?         @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  project          Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  company          Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact          Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal             Deal?            @relation(fields: [dealId], references: [id], onDelete: SetNull)
  assignedByAgent  AIAgentInstance? @relation("TaskAssignedByAgent", fields: [assignedByAgentId], references: [id], onDelete: SetNull)
  assignedByUser   User?            @relation("TaskAssignedByUser", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  assignedToAgent  AIAgentInstance? @relation("TaskAssignedToAgent", fields: [assignedToAgentId], references: [id], onDelete: SetNull)
  assignedToUser   User?            @relation("TaskAssignedToUser", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  sprint           Sprint?          @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  milestone        Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  parentTask          Task?               @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks            Task[]              @relation("TaskSubtasks")
  recurrenceParent    Task?               @relation("TaskRecurrence", fields: [recurrenceParentId], references: [id], onDelete: SetNull)
  recurrenceInstances Task[]              @relation("TaskRecurrence")
  dependsOn           Task[]              @relation("TaskDependencies")
  blocks              Task[]              @relation("TaskDependencies")
  checklistItems      TaskChecklistItem[]
  reminders           Reminder[]
  timeEntries         TimeEntry[]
  statusChanges       TaskStatusChange[]
  linkedDocuments     Document[]
  risks               ProjectRisk[]
  actionItem          ActionItem?
  bugReport           BugReport?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([projectId])
  @@index([companyId])
  @@index([dealId])
  @@index([parentTaskId])
  @@index([sprintId])
  @@index([milestoneId])
  @@index([relatedCandidateId])
}

model TaskChecklistItem {
  id     String  @id @default(cuid())
  taskId String
  label  String
  done   Boolean @default(false)
  order  Int

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Reminder {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String
  remindAt       DateTime
  dismissed      Boolean  @default(false)

  relatedDealId    String?
  relatedTaskId    String?
  relatedContactId String?
  relatedCompanyId String?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedDeal    Deal?        @relation(fields: [relatedDealId], references: [id], onDelete: SetNull)
  relatedTask    Task?        @relation(fields: [relatedTaskId], references: [id], onDelete: SetNull)
  relatedContact Contact?     @relation(fields: [relatedContactId], references: [id], onDelete: SetNull)
  relatedCompany Company?     @relation(fields: [relatedCompanyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([userId, remindAt])
}

enum DecisionStatus {
