  taxPercent         Float?
  taxAmount          Float           @default(0)
  grandTotal         Float           @default(0)
  validUntil         DateTime?
  notes              String?         @db.Text
  terms              String?         @db.Text
  generatedByAgentId String?
  createdByUserId    String?

  trackingToken     String?   @unique
  openCount         Int       @default(0)
  firstOpenedAt     DateTime?
  downloadCount     Int       @default(0)
  firstDownloadedAt DateTime?
  sentAt            DateTime?
  acceptedAt        DateTime?
  rejectedAt        DateTime?

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company          Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact          Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal             Deal?               @relation(fields: [dealId], references: [id], onDelete: SetNull)
  generatedByAgent AIAgentInstance?    @relation(fields: [generatedByAgentId], references: [id], onDelete: SetNull)
  createdByUser    User?               @relation("QuotationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
