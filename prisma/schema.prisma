  REJECT
  ESCALATE
  DISCUSS
  DELAY
  DELEGATE
  APPROVE_WITH_CHANGES // AI Proposal Review Board only
  REQUEST_REVISION // AI Proposal Review Board only
}

enum DecisionCategory {
  PROPOSAL_APPROVAL
  CLIENT_CONTACT
  QUOTE_GENERATION
  MEETING_SCHEDULING
  ISSUE_ESCALATION
  GENERAL
  QUOTATION_APPROVAL
  CONTRACT_APPROVAL
  INVOICE_APPROVAL
  // Added for the AI Delivery Board (Phase 5).
  PROJECT_DELIVERY
}

model Decision {
  id                 String           @id @default(cuid())
  organizationId     String
  meetingId          String?
  topic              String
  description        String?          @db.Text
  category           DecisionCategory @default(GENERAL)
  status             DecisionStatus   @default(PENDING)
  finalizedAt        DateTime?
  // Structured Decision Engine fields (Phase 5) — optional, untouched by
