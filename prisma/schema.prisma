  invoiceNumber   String
  type            InvoiceType   @default(STANDARD)
  status          InvoiceStatus @default(DRAFT)
  issueDate       DateTime      @default(now())
  dueDate         DateTime?
  currency        String?
  subtotal        Float         @default(0)
  discountPercent Float?
  discountAmount  Float         @default(0)
  taxPercent      Float?
  taxAmount       Float         @default(0)
  grandTotal      Float         @default(0)
  amountPaid      Float         @default(0)
  isRecurring     Boolean       @default(false)
  recurrenceRule  String?
  notes           String?       @db.Text
  terms           String?       @db.Text
  createdByUserId String?

  trackingToken     String?   @unique
  openCount         Int       @default(0)
  firstOpenedAt     DateTime?
  downloadCount     Int       @default(0)
  firstDownloadedAt DateTime?
  sentAt            DateTime?
  paidAt            DateTime?
  // Dedup guard for the Scheduler Service's invoice-due-reminder job
  // (src/lib/scheduler/registry.ts) — set once a real reminder has been sent
  // for this unpaid invoice, so the job never re-notifies every run.
  reminderSentAt    DateTime?

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company         Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deal            Deal?                @relation(fields: [dealId], references: [id], onDelete: SetNull)
  client          Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdByUser   User?                @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lineItems       InvoiceLineItem[]
  documents       Document[]
  recommendations Recommendation[]
  // Phase 7 (Revenue Attribution Engine) — @@unique([organizationId, invoiceId,
  // attributionModel]) below keeps this effectively one row per invoice per
  // attribution-model version (currently a single "v1" model is used).
  attributions    RevenueAttribution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([dealId])
  @@index([status])
}

enum AttributionType {
  // A single, unambiguous, real evidence chain (proven via direct foreign
  // keys — a real SENT EmailDraft that received a real Reply from the same
  // contact, or a single real non-MANUAL CompanySource with no competing
  // campaign) connects exactly one source/campaign to this revenue.
  DIRECT
  // Two or more real, independently-proven touchpoints (campaigns and/or
  // sources) are genuinely connected to the same revenue's journey — the
  // system deliberately does not pick an arbitrary "winner" among them.
  ASSISTED
  // The relationship cannot be proven with real stored records (orphan
  // invoice/deal, no company, no campaign, no non-MANUAL source, or
  // incomplete historical data). Never guessed.
  UNKNOWN
}

enum AttributionConfidence {
  HIGH
  MEDIUM
  LOW
}

/**
 * Phase 7 (Revenue Attribution Engine) — deterministic, non-AI attribution
 * of REAL PAID revenue back to its real source/campaign chain.
 * ===== Revenue anchor: Invoice, not a separate Revenue/Payment model =====
 * This schema has no dedicated Revenue or Payment model — Client 360
 * (client-360.ts's deriveRevenue) already established `Invoice.amountPaid`
 * as the one authoritative "paid revenue" figure, and `Invoice.paidAt` as
 * its payment timestamp. Phase 7 reuses that exact definition rather than
 * inventing a new one: one `RevenueAttribution` row is computed per real
 * Invoice with `amountPaid > 0`, and `invoiceId` plays the role the spec's
 * illustrative `revenue_id`/`payment_id` fields would have played had those
 * models existed. `revenueAmount` is a snapshot of `amountPaid` at
 * computation time (recomputation updates it, e.g. after a partial payment).
 * ===== Deliberately NOT the same figure as acquisition-funnel.ts =====
 * `src/lib/analytics/acquisition-funnel.ts`'s existing `bySource`/
 * `byIndustry`/`byCountry`/`byService`/`byCampaign` all sum `Deal.value` on
 * Won deals — that is DEAL VALUE / PIPELINE, not paid revenue, and that
 * file is left untouched. Phase 7's views are captioned "Paid Revenue
 * (Attributed)" specifically to avoid being confused with that existing,
 * differently-defined number.
 * ===== Why a dedicated model (not read-time-only) =====
 * Attribution must be auditable/historical (§43), idempotent across reruns
 * (§45 — enforced by the compound unique below), and cheap to read on a
 * dashboard without re-walking the whole evidence chain on every request
 * (§47) — a plain read-time compose function could not satisfy all three.
 * Every non-organizationId/invoiceId/dealId/companyId/contactId/campaignId
 * reference below (leadId, opportunityId, proposalId, meetingId, replyId,
 * emailDraftId, sequenceId) is a plain scalar id, not a Prisma relation —
 * drilldown code resolves them with a direct `findUnique` by id rather than
 * `include`, which avoids adding back-relations to seven more models for
 * fields that are only ever read one at a time on the attribution detail
 * page, never joined/grouped-by.
 */
model RevenueAttribution {
  id             String  @id @default(cuid())
  organizationId String
  invoiceId      String
  dealId         String?
  companyId      String?
  contactId      String?
  leadId         String?
  opportunityId  String?
  proposalId     String?
  meetingId      String?
  replyId        String?
  emailDraftId   String?
  campaignId     String?
  sequenceId     String?

  // Snapshot of Company.source (the original, never-overwritten discovery
  // source) at computation time — the real "Lead Source" dimension (§14),
  // kept distinct from campaignId.
  source CompanySource?

  attributionType  AttributionType       @default(UNKNOWN)
  confidence       AttributionConfidence @default(LOW)
  // Which named, documented rule produced this result — see
  // revenue-attribution.ts's ATTRIBUTION RULES doc comment. Never a bare
  // AI explanation standing in for a real rule (§55).
  attributionRule  String
  // Attribution model/version — part of the idempotency key (§45). A future
  // second model (e.g. first-touch vs last-touch) would use a different
  // value here rather than overwriting this one's meaning.
  attributionModel String                @default("v1")

  revenueAmount Float
  currency      String?

  // Ordered, real chain: [{ stage, recordType, recordId, proofType:
  // "DIRECT_FK" | "COMPANY_ASSOCIATION", occurredAt?, description }].
  // Stages with no real record are simply omitted (§3) — never invented.
  evidence         Json @default("[]")
  // For ASSISTED only: every independently-proven touchpoint, e.g.
  // [{ type: "CAMPAIGN" | "SOURCE", id, label, evidenceSummary }].
  touchpoints      Json @default("[]")
  // Orphan/missing-link findings surfaced while building this row's chain
  // (§44) — e.g. "invoice has no dealId", "deal has no companyId".
  dataQualityFlags Json @default("[]")

  computedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([organizationId, invoiceId, attributionModel])
  @@index([organizationId])
  @@index([organizationId, attributionType])
  @@index([dealId])
  @@index([companyId])
  @@index([campaignId])
}

model InvoiceLineItem {
  id          String @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float  @default(1)
  rate        Float  @default(0)
  amount      Float  @default(0)
  order       Int    @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

