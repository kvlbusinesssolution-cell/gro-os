// The Pricing Engine's supported pricing models — shared across Proposal
// and Quotation rather than a separate "Pricing" table, since it's
// fundamentally a calculation mode plus the numeric fields each of those
// models already has (value/subtotal/tax/etc.), not its own entity.
enum PricingModel {
  FIXED
  HOURLY
  MONTHLY
  RETAINER
  AMC
  ENTERPRISE
  CUSTOM
}

model Proposal {
  id                 String            @id @default(cuid())
  organizationId     String
  companyId          String?
  leadId             String?
  dealId             String?
  projectId          String?
  title              String
  content            String            @db.Text
  status             ProposalStatus    @default(DRAFT)
  value              Float?
  industry           DocumentIndustry?
  pricingModel       PricingModel?
  // Structured AI Proposal Engine output: { executiveSummary, businessChallenges,
  // currentProblems, recommendedSolution, techStack, architecture, features,
  // modules, timeline, deliverables, support, warranty, terms, callToAction }.
  // `content` above stays a flattened text render for backward compatibility
  // with anything reading it directly (same pattern as Meeting.notesJson vs summary).
  sections           Json?
  // { resources: [{role,count}], milestones: [{name,dueOffsetDays,description}], totalHours }
  estimation         Json?
  generatedByAgentId String?
  createdByUserId    String?

  // ===== Tracking (same fields/semantics as EmailDraft's proven open/click tracking) =====
  trackingToken     String?   @unique
  openCount         Int       @default(0)
  firstOpenedAt     DateTime?
  downloadCount     Int       @default(0)
  firstDownloadedAt DateTime?
  sentAt            DateTime?
  acceptedAt        DateTime?
  rejectedAt        DateTime?
  // Dedup guard for the Scheduler Service's proposal-follow-up-reminder job
  // (src/lib/scheduler/registry.ts) — set once a real reminder has been sent
  // for this still-SENT proposal, so the job never re-notifies every run.
  reminderSentAt    DateTime?

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company          Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  lead             Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  deal             Deal?            @relation(fields: [dealId], references: [id], onDelete: SetNull)
  project          Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  generatedByAgent AIAgentInstance? @relation(fields: [generatedByAgentId], references: [id], onDelete: SetNull)
  createdByUser    User?            @relation("ProposalCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  documents        Document[]
  recommendations  Recommendation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([dealId])
}

model Document {
  id                       String  @id @default(cuid())
  organizationId           String
  name                     String
  // Relative path under the app-local storage/documents/ directory — never
  // under public/, always streamed through an auth-gated route handler.
  storageKey               String
  mimeType                 String
  sizeBytes                Int
  folder                   String?
  linkedCompanyId          String?
  linkedProjectId          String?
  linkedProposalId         String?
  linkedDealId             String?
  linkedQuotationId        String?
  linkedContractId         String?
  linkedInvoiceId          String?
  linkedBusinessDocumentId String?
  linkedTaskId             String?
