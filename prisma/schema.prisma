  // Structured AI Proposal Engine output: { executiveSummary, businessChallenges,
  // currentProblems, recommendedSolution, techStack, architecture, features,
  // modules, timeline, deliverables, support, warranty, terms, callToAction }.
  // `content` above stays a flattened text render for backward compatibility
  // with anything reading it directly (same pattern as Meeting.notesJson vs summary).
  sections           Json?
  // { resources: [{role,count}], milestones: [{name,dueOffsetDays,description}], totalHours }
  estimation         Json?
  generatedByAgentId String?
  createdByUserId    String?

  // ===== Tracking (same fields/semantics as EmailDraft's proven open/click tracking) =====
