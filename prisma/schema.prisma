// ============================= Phase 12: Enterprise Document Generation =============================
//
// Proposal (extended above) stays the flagship AI-authored document.
// Quotation/Contract/Invoice get dedicated models because they carry real
// structured/relational data (line items, tax math, signature/payment
// state) that Proposal doesn't. Every other "generate title + rich text,
// link to a company/deal/project, track status" document kind (NDA, MSA,
// SLA, Terms, Privacy Agreement, Acceptance Letter, Delivery Certificate,
// Scope of Work, Requirement Specification, Technical Architecture,
// Project Roadmap, Risk Register, Acceptance Criteria, Project Plan,
// Business Report) shares ONE model (BusinessDocument) discriminated by
// `kind` — building 14 near-identical tables would be pure duplication.
//
// DocumentVersion and Signature are intentionally polymorphic (docKind +
// docId, no hard FK) since Prisma has no native polymorphic relation and
// a real FK would require picking one target table — the same
// loose-reference pattern already used by Activity.metadata's dealId.
// Referential integrity for these two is enforced in application code.

enum DocumentKind {
  PROPOSAL
  QUOTATION
  CONTRACT
  INVOICE
  BUSINESS_DOCUMENT
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quotation {
  id                 String          @id @default(cuid())
  organizationId     String
  companyId          String?
  contactId          String?
  dealId             String?
  quotationNumber    String
  title              String
  status             QuotationStatus @default(DRAFT)
  pricingModel       PricingModel?
  currency           String?
  subtotal           Float           @default(0)
  discountPercent    Float?
  discountAmount     Float           @default(0)
  taxPercent         Float?
  taxAmount          Float           @default(0)
  grandTotal         Float           @default(0)
  validUntil         DateTime?
  notes              String?         @db.Text
  terms              String?         @db.Text
  generatedByAgentId String?
  createdByUserId    String?

  trackingToken     String?   @unique
  openCount         Int       @default(0)
  firstOpenedAt     DateTime?
  downloadCount     Int       @default(0)
  firstDownloadedAt DateTime?
  sentAt            DateTime?
  acceptedAt        DateTime?
  rejectedAt        DateTime?

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company          Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact          Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal             Deal?               @relation(fields: [dealId], references: [id], onDelete: SetNull)
  generatedByAgent AIAgentInstance?    @relation(fields: [generatedByAgentId], references: [id], onDelete: SetNull)
  createdByUser    User?               @relation("QuotationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lineItems        QuotationLineItem[]
  documents        Document[]
  recommendations  Recommendation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, quotationNumber])
  @@index([organizationId])
  @@index([dealId])
}

model QuotationLineItem {
  id              String @id @default(cuid())
  quotationId     String
  description     String
  quantity        Float  @default(1)
  rate            Float  @default(0)
  discountPercent Float?
  amount          Float  @default(0)
  order           Int    @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

enum ContractType {
  SOFTWARE_DEVELOPMENT_AGREEMENT
