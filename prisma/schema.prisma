  MOBILE_APP
  ADMIN_PANEL
  ANALYTICS_DASHBOARD
  WORKFLOW_AUTOMATION
  API_INTEGRATION
  CLOUD_MIGRATION
}

// A real, server-side scan of a live website — never a fabricated report.
// companyId is optional: a scan can stand alone (not yet a CRM company) or be
// linked to/promote an existing Company, mirroring Client.companyId's
// optional-relation convention.
model WebsiteScan {
  id               String     @id @default(cuid())
  organizationId   String
  companyId        String?
  createdByUserId  String
  url              String
  finalUrl         String?
  websiteName      String?
  companyNameInput String?
  industryInput    String?
  websiteType      String?
  status           ScanStatus @default(PENDING)
  httpStatus       Int?
  errorMessage     String?    @db.Text
  scannedAt        DateTime?

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company       Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdByUser User         @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  technologies     Technology[]
  domainInfo       DomainInfo?
  seoAudit         SEOAudit?
  performanceAudit PerformanceAudit?
  securityAudit    SecurityAudit?
  uxAudit          UXAudit?
  opportunity      Opportunity?
  recommendations  ScanRecommendation[]
  executiveReport  ExecutiveReport?
  // Reverse side of OrganizationDNA.websiteScanId — set only when this scan was run as the
  // AI Company Understanding Engine's Digital Audit step (§3 of that feature), never for a
  // manually-triggered scan from the Website Scanner page.
  organizationDna  OrganizationDNA?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
}

// Every row cites its own evidence — the real header/HTML string that
// triggered detection — never a bare guess.
model Technology {
  id       String             @id @default(cuid())
  scanId   String
  name     String
  category TechnologyCategory
  evidence String             @db.Text

  scan WebsiteScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
}

// Real RDAP (the modern, HTTP/JSON successor to WHOIS — no API key needed,
// no rate-limit-gated third-party service) lookup against the registry the
// domain's TLD actually delegates to (via the IANA RDAP bootstrap registry).
// lookupSucceeded=false + lookupError set is a normal, honest outcome (many
// registries rate-limit or don't run RDAP yet) — never backfilled with a
// guessed date.
model DomainInfo {
  id              String    @id @default(cuid())
  scanId          String    @unique
  domain          String
  registrar       String?
  registeredAt    DateTime?
  domainAgeDays   Int?
  expiresAt       DateTime?
  rdapSource      String?
  lookupSucceeded Boolean   @default(false)
  lookupError     String?

  scan WebsiteScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
}

model SEOAudit {
  id                     String    @id @default(cuid())
  scanId                 String    @unique
  metaTitle              String?
  metaDescription        String?   @db.Text
  hasCanonical           Boolean
  hasOpenGraph           Boolean
  hasTwitterCard         Boolean
  hasSchema              Boolean
  h1Count                Int
  headingStructureValid  Boolean
  internalLinksCount     Int
  externalLinksCount     Int
  // Broken-link checking is a bounded spot-check, never an exhaustive crawl —
  // brokenLinksChecked records how many were actually sampled, so the UI can
  // honestly say "3 broken links found across 10 sampled" rather than imply
  // a full-site check.
  brokenLinksSampleCount Int
  brokenLinksChecked     Int
  imagesTotal            Int
  imagesWithoutAlt       Int
  hasSitemap             Boolean
  hasRobotsTxt           Boolean
  isIndexable            Boolean
  // Real SERP ranking lookup — genuinely pluggable, never simulated. Null
  // fields mean "no rank-check provider is configured" (see
  // src/lib/scanner/seo-rank.ts), not "ranked outside the results". Populated
  // only when a real provider key (e.g. SERPAPI_KEY) is set.
  rankCheckKeyword       String?
  rankCheckPosition      Int?
  rankCheckProvider      String?
  rankCheckedAt          DateTime?
  seoScore               Int
  findings               Json

  scan WebsiteScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
}

// Estimated from real static-response signals (timing, headers, structural
// tag counts) — explicitly NOT a Lighthouse/Core Web Vitals measurement,
// which would require a real rendered browser (not available here). Every UI
// surface of this data must carry that disclaimer.
model PerformanceAudit {
  id                        String  @id @default(cuid())
  scanId                    String  @unique
  responseTimeMs            Int
  htmlSizeBytes             Int
  scriptTagCount            Int
  stylesheetCount           Int
  imageTagCount             Int
  hasCaching                Boolean
  hasCompression            Boolean
  // Real DOM fact: <script> tags in <head> without async/defer, which block
  // initial render.
  renderBlockingScriptCount Int     @default(0)
  // Real inspection of <img> src extensions (webp/avif vs legacy formats).
  modernImageFormatPct      Int     @default(100)
  // Real inspection of <img loading="lazy"> attribute usage.
  lazyLoadedImagePct        Int     @default(100)
  // Real Core Web Vitals from an actual headless-Chromium render (Playwright,
  // src/lib/scanner/browser-metrics.ts) — only populated when
  // ENABLE_BROWSER_SCAN=true AND the render genuinely succeeded. Null means
  // "not measured this way", never a guessed/interpolated value; the
  // static-signal fields above remain the fallback the score is based on.
  largestContentfulPaintMs  Int?
  cumulativeLayoutShift     Float?
  totalBlockingTimeMs       Int?
  measuredByRealBrowser     Boolean @default(false)
  performanceScore          Int
  findings                  Json

  scan WebsiteScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
}

model UXAudit {
  id                            String  @id @default(cuid())
  scanId                        String  @unique
  hasNav                        Boolean
  formCount                     Int
  ctaCount                      Int
  altTextCoveragePct            Int
  // Real Flesch-Kincaid readability score computed on extracted visible text.
  readabilityScore              Float
  viewportMetaPresent           Boolean
  // Human-readable summary of the contrast check outcome — either the real
  // declared color/background pair found in the site's own CSS, or an
  // honest "no usable pair found" note.
  colorContrastNote             String
  // Real WCAG relative-luminance contrast ratio computed from a
  // color/background pair actually declared in inline <style> or the first
  // same-origin external stylesheet. Null when no usable pair was found —
  // heuristic on real declared CSS, not a rendered/computed-style check.
  contrastRatio                 Float?
  // True when contrastRatio/colorContrastNote came from a real rendered
  // computed-style check (Playwright, src/lib/scanner/browser-metrics.ts)
  // instead of the declared-CSS heuristic in contrast.ts — a genuinely
  // stronger check (resolves cascade/specificity/CSS variables), only
  // available when ENABLE_BROWSER_SCAN=true and the render succeeded.
  contrastMeasuredByRealBrowser Boolean @default(false)
  uxScore                       Int
  findings                      Json

  scan WebsiteScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
}

// A high-level, non-invasive assessment (public HTTP headers/cookies/HTTPS/
// TLS-handshake/known-sensitive-paths only) — never a penetration test.
// Always disclaimed as such in the UI.
model SecurityAudit {
  id                        String   @id @default(cuid())
  scanId                    String   @unique
  isHttps                   Boolean
  hasHsts                   Boolean
  hasCsp                    Boolean
  hasXFrameOptions          Boolean
  hasXContentTypeOptions    Boolean
  hasReferrerPolicy         Boolean  @default(false)
  hasPermissionsPolicy      Boolean  @default(false)
  cookiesSecureFlag         Boolean?
  cookiesHttpOnlyFlag       Boolean?
  mixedContentCount         Int
  // Real check: Access-Control-Allow-Origin: * combined with
  // Access-Control-Allow-Credentials: true on the main response.
  corsMisconfigured         Boolean  @default(false)
  // Real bounded fetch of a handful of well-known sensitive paths
  // (/.env, /.git/config) — genuine misconfiguration detection.
  exposedSensitiveFileCount Int      @default(0)
  // Real TLS handshake (node:tls) against the live host — Node's own
  // certificate-chain/hostname validation, not a third-party API.
  tlsAuthorized             Boolean?
  tlsProtocol               String?
  tlsDaysUntilExpiry        Int?
  // Real parse of the Strict-Transport-Security header's max-age directive —
  // null when HSTS isn't set at all (distinct from hasHsts=true, weak).
  hstsMaxAgeSeconds         Int?
  // Real substring check on the Content-Security-Policy header value itself.
  cspHasUnsafeDirectives    Boolean?
  // Real Set-Cookie attribute parse — null when no cookies were observed
  // (same "no data" semantics as cookiesSecureFlag/cookiesHttpOnlyFlag).
  cookiesSameSiteFlag       Boolean?
  // Real count of <script src> tags pointing cross-origin without an
  // integrity="..." attribute — a genuine supply-chain risk signal.
  missingSriScriptCount     Int      @default(0)
  securityScore             Int
  findings                  Json

  scan WebsiteScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
}

// The deterministic Opportunity Score — a documented weighted combination of
// the 4 real audit scores, never a per-scan AI call (same rationale as
// LeadScore: fast, cheap, transparent formula).
model Opportunity {
  id                      String          @id @default(cuid())
  scanId                  String          @unique
  digitalScore            Int
  automationScore         Int
  growthScore             Int
  aiReadinessScore        Int
  seoScore                Int
  performanceScore        Int
  securityScore           Int
  uxScore                 Int
  overallOpportunityScore Int
  band                    OpportunityBand
  estimatedValueMin       Float?
  estimatedValueMax       Float?
  estimatedTimeline       String?
  confidenceLevel         ConfidenceLevel
  computedAt              DateTime        @default(now())

  scan WebsiteScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
}

// Named ScanRecommendation (not Recommendation) to avoid colliding with the
// existing Lead-Intelligence Recommendation model, which is a distinct
// org-wide concept.
model ScanRecommendation {
  id        String                 @id @default(cuid())
  scanId    String
  category  RecommendationCategory
  title     String
  rationale String                 @db.Text
  priority  MessagePriority        @default(NORMAL)

  scan WebsiteScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([scanId])
}

// The AI-composed narrative sitting on top of the verified audits — one real
// Claude call reasoning strictly over the real findings above (see
// src/lib/scanner/ai-report-generator.ts). Always badged "AI-generated" in
// the UI, never presented as a verified fact.
model ExecutiveReport {
  id                         String   @id @default(cuid())
  scanId                     String   @unique
  executiveSummary           String   @db.Text
  strengths                  String[]
  weaknesses                 String[]
  businessOpportunities      String[]
  // What this business does and who it appears to serve — inferred by the
  // model strictly from real scraped page text/metadata, never a template
  // guess. Distinct from technologyOverview, which is about the stack, not
  // the business itself.
  businessPurposeSummary     String   @default("") @db.Text
  technologyOverview         String   @db.Text
  seoFindingsSummary         String   @db.Text
  performanceFindingsSummary String   @db.Text
  securityObservations       String   @db.Text
  uxFindings                 String   @db.Text
  businessImpact             String   @db.Text
  nextSteps                  String[]
  generatedByAgentId         String?

  scan             WebsiteScan      @relation(fields: [scanId], references: [id], onDelete: Cascade)
  generatedByAgent AIAgentInstance? @relation(fields: [generatedByAgentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

// ============================= Audit log =============================

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  organizationId String?
  action         String
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime @default(now())

  // Hash chain (see src/lib/audit-chain-verify.ts): `previousHash` is the
  // `hash` of the prior AuditLog row in the same organizationId scope (or
  // the literal genesis value for the first row in that scope); `hash` is
  // sha256(previousHash + canonicalized row content), computed by
  // logAudit() at write time. This makes a row edited/deleted directly in
  // the database — bypassing logAudit()'s create-only application code —
  // detectable by re-walking the chain, since it breaks the hash link to
  // every row written after it. It is NOT a database-level append-only
  // guarantee: a privileged DB user can still rewrite a row AND every
  // hash after it to make the chain re-verify, so this is tamper-evidence
  // against accidental or narrowly-scoped tampering, not a cryptographic
  // guarantee against a fully compromised database.
  previousHash String?
  hash         String?

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
  @@index([action])
}

// ============================= Phase 9: AI Outreach Assistant =============================

enum CampaignType {
  STANDARD
  INDUSTRY
  COUNTRY
  CUSTOM
  TAG_BASED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ApprovalMode {
  MANUAL
  SEMI_AUTOMATIC
  AUTOMATIC
}

enum ContactStatus {
  NEW
  CONTACTED
  REPLIED
  INTERESTED
  NOT_INTERESTED
  MEETING_BOOKED
  UNSUBSCRIBED
}

// Phase 16 — real email/phone verification state. UNVERIFIED means "a
// verification call was made but did not confirm validity" (provider said
// unknown/undeliverable-unconfirmed); INVALID/RISKY are real provider
// verdicts; VERIFIED requires an actual provider confirmation, never set
// just because the field has a value. No verification provider is wired up
// yet in this environment (see phone-verification.ts's own doc comment) —
// every Contact today genuinely sits at the honest default, UNKNOWN.
enum ContactVerificationStatus {
  UNKNOWN
  VERIFIED
  UNVERIFIED
  INVALID
  RISKY
  // Phase 25 (verification states): a value that was once VERIFIED/RISKY
  // but has aged past a real freshness threshold — see
  // contact-freshness.ts. Never applied to UNKNOWN/UNVERIFIED (nothing to
  // go stale).
  STALE
}

// Phase 25 (requirement: decision-maker classification) — real buying-
// influence role, distinct from DecisionMakerRole (a job-title taxonomy).
// Deterministically derived from job-title/seniority signals
// (contact-classification.ts) — never AI-guessed. UNKNOWN is the honest
// default when signals are genuinely ambiguous.
enum ContactBuyerRole {
  ECONOMIC_BUYER
  TECHNICAL_BUYER
  BUSINESS_BUYER
  INFLUENCER
  CHAMPION
  EXECUTIVE
  UNKNOWN
}

enum DraftChannel {
  EMAIL
  LINKEDIN
  // Phase 8 (WhatsApp Business Outreach) — sent/received only through the
  // org's connected, officially-approved WhatsApp Business provider
  // (Twilio's WhatsApp API today — see whatsapp-provider.ts). Never an
  // unofficial WhatsApp Web/QR-session channel.
  WHATSAPP
  // Phase 10 (AI Voice Sales Engine) — used ONLY on the real Reply row that
  // carries an actual call's real transcript text (see voice-call.ts) so
  // Phase 6 Conversation Intelligence can analyze it unchanged — never used
  // on an EmailDraft (a phone call is not a "draft message").
  VOICE
}

enum DraftPurpose {
  INTRODUCTION
  FOLLOW_UP
  MEETING_REQUEST
  PRODUCT_INTRODUCTION
  PROPOSAL_REQUEST
  CASE_STUDY
  THANK_YOU
  REMINDER
  RE_ENGAGEMENT
  CONNECTION_REQUEST
  CONVERSATION_SUMMARY
  // Phase 20 (Autonomous AI Job Application Agent) — a real recruiter/
  // hiring-manager email sent as part of a JobApplication's submission,
  // going through this exact same DRAFT -> APPROVED -> QUEUED -> SENT
  // pipeline (see application-submission.ts) rather than a separate send
  // path, so it gets the same real Resend deliveredAt confirmation.
  JOB_APPLICATION
}

enum EmailTone {
  PROFESSIONAL
  ENTERPRISE
  FRIENDLY
  FORMAL
  CONSULTATIVE
}

enum DraftStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  QUEUED
  SENT
  FAILED
  REJECTED
  BOUNCED
  // Phase 8 — only ever set from a real, provider-confirmed WhatsApp
  // status-callback webhook event (never assumed from SENT — §11).
  DELIVERED
  READ
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum OutreachMeetingStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  COMPLETED
  CANCELLED
}

enum ReplySentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

// Phase 6: AI Reply Intelligence — what the sender actually wants next.
// Deliberately kept separate from ReplySentiment (tone) — a reply can be
// e.g. NEUTRAL in tone but a clear REQUEST_CALL in intent.
enum ReplyIntent {
  INTERESTED
  NOT_INTERESTED
  NEEDS_INFORMATION
  REQUEST_CALL
  REQUEST_PROPOSAL
  FOLLOW_UP_LATER
  PRICE_QUESTION
  WRONG_CONTACT
  OUT_OF_OFFICE
  UNSUBSCRIBE
  UNKNOWN
}

// The person-level entity Company/Lead/Client don't have today. Lead Score /
// Opportunity Score are deliberately NOT duplicated here — always read live
// off the linked Company's leadScore / websiteScans[].opportunity.
model Contact {
  id                String        @id @default(cuid())
  organizationId    String
  companyId         String?
  firstName         String
  lastName          String?
  email             String
  jobTitle          String?
  phone             String?
  country           String?
  city              String?
  tags              String[]
  ownerUserId       String?
  status            ContactStatus @default(NEW)
  notes             String?       @db.Text
  linkedin          String?
  department        String?
  // 0-100, owner-editable on the CRM Contact detail view — a real, stored
  // field like Task.progress, not derived from anything (there is no
  // interaction-frequency model to compute it from honestly).
  relationshipScore Int?

  // ===== Phase 1 (GrowthOS Data & Enrichment Engine) =====
  // Real FK to a verified DecisionMaker row at this same company, replacing
  // personalization.ts's prior fragile name-string match as the source of
  // truth once a confident link is made (see decision-maker-matching.ts's
  // findMatchingDecisionMaker) — null means "no confident match found yet",
  // never a guessed link. Deliberately SetNull (never cascade-delete a
  // Contact just because its matched DecisionMaker row is removed).
  decisionMakerId          String?
  // 0-1, a deterministic (never AI-guessed) estimate from job-title keyword
  // matching — see enrichment.ts's SENIORITY_SIGNALS. Distinct from
  // DecisionMaker.confidence (identity-verification confidence for a named
  // public decision-maker) — this scores "how likely is THIS contact,
  // whoever they are, to be a decision maker" from their own stored title.
  decisionMakerProbability Float?
  enrichmentStatus         EnrichmentStatus @default(NEVER_ENRICHED)
  lastEnrichedAt           DateTime?

  // Phase 16 (Advanced Enrichment + Buying Intent Intelligence) — real
  // verification state for the stored email/phone, never inferred from
  // "a value exists". Defaults to UNKNOWN (no real verification provider
  // call has been made against this contact yet) rather than defaulting to
  // VERIFIED — see the field docs on the enums below.
  emailVerificationStatus ContactVerificationStatus @default(UNKNOWN)
  phoneVerificationStatus ContactVerificationStatus @default(UNKNOWN)

  // Phase 25 (job-title/seniority normalization) — the real, deterministic
  // label from estimateSeniority() (enrichment.ts), stored in its own
  // field. Previously this value was incorrectly written into `department`
  // as a fallback (a real bug, fixed this phase) — a contact with no real
  // department must stay department: null, never "VP".
  seniority String?
  // Phase 25 (decision-maker classification) — real buying-influence role,
  // deterministically derived, distinct from DecisionMaker.role (a
  // job-title taxonomy on the separate DecisionMaker model).
  buyerRole ContactBuyerRole @default(UNKNOWN)

  // Phase 25 (requirement #4, contact merge safety) — same real soft-merge
  // pattern as Company (Phase 24): the merge-away Contact row is never
  // deleted, only flagged, and excluded from findOrCreateContact matching
  // going forward (mergedIntoId: null filter) — full history stays
  // reachable via the `mergedInto` relation.
  mergedIntoId String?
  mergedAt     DateTime?
  mergedInto   Contact?  @relation("ContactMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Contact[] @relation("ContactMerge")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner         User?          @relation("ContactOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  decisionMaker DecisionMaker? @relation(fields: [decisionMakerId], references: [id], onDelete: SetNull)

  campaigns                CampaignContact[]
  emailDrafts              EmailDraft[]
  replies                  Reply[]
  outreachMeetings         OutreachMeeting[]
  tasks                    Task[]
  deals                    Deal[]
  reminders                Reminder[]
  quotations               Quotation[]
  rateNegotiations         RateNegotiation[]
  conversationIntelligence ConversationIntelligence[]
  revenueAttributions      RevenueAttribution[]
  whatsappConversations    WhatsAppConversation[]
  calls                    Call[]
  voiceConsent             VoiceConsent?
  evidence                 ContactEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([decisionMakerId])
  @@index([mergedIntoId])
}

// Phase 25 (requirement: evidence per field) — mirrors CompanyEvidence
// exactly (Phase 24), same immutable/append-only discipline, same
// fieldName/verificationStatus/source/confidence shape.
model ContactEvidence {
  id                 String                      @id @default(cuid())
  contactId          String
  kind               EvidenceKind
  fact               String                      @db.Text
  source             EvidenceSource
  sourceUrl          String?
  confidence         Float
  discoveredAt       DateTime                    @default(now())
  fieldName          String?
  verificationStatus EvidenceVerificationStatus  @default(UNVERIFIED)

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([contactId, fieldName])
}

model Campaign {
  id                        String         @id @default(cuid())
  organizationId            String
  name                      String
  type                      CampaignType
  status                    CampaignStatus @default(DRAFT)
  targetIndustry            String?
  targetCountry             String?
  targetCompanySize         String?
  goal                      String?        @db.Text
  approvalMode              ApprovalMode   @default(MANUAL)
  // AI Campaign Planner's grounded narrative — the estimatedSuccessPotential
  // number itself is computed deterministically (see campaign-planner.ts),
  // never AI-invented.
  aiPlanNotes               String?        @db.Text
  estimatedSuccessPotential Int?
  createdByUserId           String

  // ===== Phase 4 (Email Deliverability & Sender Health Engine) =====
  // Set only when `status` was moved to PAUSED by the automatic circuit
  // breaker (email-health.ts) — never set for a manual pause via the
  // existing setCampaignStatus, so the UI can distinguish "a human paused
  // this" from "the safety system paused this and why".
  pausedReason String?   @db.Text
  pausedAt     DateTime?

  organization          Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser         User                        @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  contacts              CampaignContact[]
  sequences             Sequence[]
  emailDrafts           EmailDraft[]
  replies               Reply[]
  outreachMeetings      OutreachMeeting[]
  analyticsSnapshots    CampaignAnalyticsSnapshot[]
  revenueAttributions   RevenueAttribution[]
  whatsappConversations WhatsAppConversation[]
  calls                 Call[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model CampaignContact {
  id         String   @id @default(cuid())
  campaignId String
  contactId  String
  enrolledAt DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
}

// steps is an ordered array of {order, type: EMAIL|WAIT|LINKEDIN|REMINDER|MEETING_REQUEST,
// delayDays, purpose?, tone?} — same "structured Json for a flexible ordered
// list" convention as Widget.position / SavedSearch.filters.
model Sequence {
  id             String  @id @default(cuid())
  organizationId String
  campaignId     String?
  name           String
  steps          Json

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  emailDrafts  EmailDraft[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// One model covers cold email, LinkedIn drafts, follow-ups, and
// meeting-request messages — they share one lifecycle (DRAFT ->
// PENDING_APPROVAL -> APPROVED -> QUEUED -> SENT|FAILED|REJECTED).
model EmailDraft {
  id                   String       @id @default(cuid())
  organizationId       String
  campaignId           String?
  contactId            String
  sequenceId           String?
  sequenceStepIndex    Int?
  // Phase 6 (AI Conversation Intelligence) — set only for a real AI-
  // suggested reply generated in direct response to analyzing a specific
  // inbound Reply. Makes the "suggested reply -> the message it's replying
  // to" relationship explicit and traceable, without inventing a second
  // draft-lifecycle model (this draft still goes through the exact same
  // DRAFT -> PENDING_APPROVAL -> APPROVED -> QUEUED -> SENT pipeline as
  // every other EmailDraft).
  inReplyToId          String?
  channel              DraftChannel
  purpose              DraftPurpose
  tone                 EmailTone
  subject              String?
  body                 String       @db.Text
  // Email Center Phase 3 — real CC/BCC recipients, persisted and actually
  // passed to the send provider (src/lib/outreach/email-provider.ts).
  // Empty array (never null) when unused — matches this schema's existing
  // String[] convention elsewhere (e.g. Company.technologies).
  cc                   String[]     @default([])
  bcc                  String[]     @default([])
  // Which real fields were actually woven in — powers "Highlight
  // personalization" in the preview UI, never fabricated after the fact.
  personalizationNotes Json?
  status               DraftStatus  @default(DRAFT)
  abVariant            String?
  abTestGroupId        String?
  generatedByAgentId   String?
  approvedByUserId     String?
  approvedAt           DateTime?
  // Phase 3 Email Center — a real future send time set from Compose's
  // "Schedule" action. Distinct from `queuedAt`, which existing code
  // (approval-actions.ts's queueDraft/sendQueuedDraft) sets only the
  // instant a draft is queued for IMMEDIATE send — this field means "send
  // no earlier than this real timestamp." Null for every draft sent through
  // the normal Approve -> Queue -> Send path unchanged by this feature; a
  // scheduled-send job promotes a still-APPROVED draft with a due
  // `scheduledFor` to QUEUED, at which point the existing send pipeline
  // takes over unmodified.
  scheduledFor         DateTime?
  queuedAt             DateTime?
  sentAt               DateTime?
  failedReason         String?
  trackingToken        String?      @unique
  openCount            Int          @default(0)
  firstOpenedAt        DateTime?
  clickCount           Int          @default(0)
  firstClickedAt       DateTime?
  // Resend's own message id (the `id` field of a successful POST
  // https://api.resend.com/emails response), persisted at send time so the
  // Resend webhook (src/app/api/webhooks/resend/route.ts) can correlate a
  // later bounce/complaint event's `data.email_id` back to this draft.
  // Never set for SMTP-sent drafts — Resend-specific.
  resendMessageId      String?      @unique
  // Set only from a real, signature-verified Resend webhook event
  // (src/app/api/webhooks/resend/route.ts) — never inferred/guessed.
  bouncedAt            DateTime?
  bounceReason         String?
  complainedAt         DateTime?
  // Phase 4: "hard" | "soft" | "unknown" — best-effort extraction from
  // Resend's real bounce payload where a sub-type field is present; "unknown"
  // (never a silently-assumed "soft") when it isn't, so suppression logic can
  // treat an unclassifiable bounce conservatively rather than pretending
  // certainty it doesn't have.
  bounceType           String?
  // Set once by linkedInReminderJob (src/lib/scheduler/registry.ts) after it
  // nudges the owner about a LINKEDIN draft that's sat APPROVED/QUEUED past
  // the reminder threshold — prevents re-reminding on every subsequent tick.
  // Cleared implicitly once the draft reaches SENT (a fresh draft never has
  // this set).
  reminderSentAt       DateTime?

  // ===== Phase 8 (WhatsApp Business Outreach) =====
  // Generic provider message id (Twilio's MessageSid today) — distinct from
  // the Resend-specific field above; the real correlation key the WhatsApp
  // webhook uses to match a status-callback event back to this row.
  providerMessageId      String?   @unique
  // Set only from a real, signature-verified Twilio status-callback webhook
  // event — never assumed from SENT (§11: sent != delivered != read).
  deliveredAt            DateTime?
  readAt                 DateTime?
  failedAt               DateTime?
  whatsappConversationId String?
  whatsappTemplateId     String?

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign             Campaign?             @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contact              Contact               @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sequence             Sequence?             @relation(fields: [sequenceId], references: [id], onDelete: SetNull)
  whatsappConversation WhatsAppConversation? @relation(fields: [whatsappConversationId], references: [id], onDelete: SetNull)
  whatsappTemplate     WhatsAppTemplate?     @relation(fields: [whatsappTemplateId], references: [id], onDelete: SetNull)
  inReplyTo            Reply?                @relation("DraftInReplyToReply", fields: [inReplyToId], references: [id], onDelete: SetNull)
  generatedByAgent     AIAgentInstance?      @relation(fields: [generatedByAgentId], references: [id], onDelete: SetNull)
  approvedByUser       User?                 @relation("EmailDraftApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvals            Approval[]
  replies              Reply[]
  outreachMeetings     OutreachMeeting[]
  attachments          Document[]
  providerEvents       EmailProviderEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([contactId])
  @@index([campaignId])
}

// ===== Phase 4 (Email Deliverability & Sender Health Engine) =====
// No "Sending Identity" concept existed before this phase — the real sender
// was only ever a flat EMAIL_FROM env var / white-label resolved address
// (Resend/SMTP) or the org's own connected mailbox (Gmail/Outlook), with
// zero per-identity send counters, limits, or health tracking anywhere.
// This is the genuinely missing registry, lazily upserted by email address
// the first time a send actually happens through it (see
// src/lib/outreach/sending-identity.ts) — never a manual-setup requirement
// that would block existing sends.
enum SendingIdentityProvider {
  RESEND
  SMTP
  GMAIL
  OUTLOOK
  // Phase 8 — recorded on EmailProviderEvent rows sourced from the WhatsApp
  // webhook; WhatsappSendingIdentity (its own model, phone-keyed rather than
  // email+domain-keyed) is the real rate-limit/health record for this value.
  TWILIO_WHATSAPP
}

enum SendingIdentityStatus {
  ACTIVE
  THROTTLED
  COOLDOWN
  PAUSED
}

model SendingIdentity {
  id             String                  @id @default(cuid())
  // Required, always tenant-scoped — deliberately NOT nullable/"global",
  // per rule 13 (never let one tenant's sending health/suppression data
  // leak into another's). Postgres NULL also isn't reliably unique-
  // constrainable, which would have made the [organizationId, email]
  // uniqueness guarantee below unsafe for a shared/global row anyway.
  organizationId String
  email          String
  domain         String
  provider       SendingIdentityProvider
  status         SendingIdentityStatus   @default(ACTIVE)

  // Configurable, documented defaults (see sending-identity.ts) — never
  // silently invented at read time, always a real stored value an admin can
  // change.
  dailyLimit  Int @default(300)
  hourlyLimit Int @default(50)

  // Real running counters, reset by the scheduled health-check job (see
  // registry.ts's "email-health-check") — never recomputed via an expensive
  // full-table scan on every send.
  sentToday       Int      @default(0)
  sentThisHour    Int      @default(0)
  countersResetAt DateTime @default(now())

  cooldownUntil  DateTime?
  cooldownReason String?   @db.Text
  pausedAt       DateTime?
  pausedReason   String?   @db.Text

  lastSendAt      DateTime?
  lastErrorAt     DateTime?
  lastErrorReason String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events EmailProviderEvent[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([status])
}

// Real, idempotent provider-event log — "the same provider event must not
// be counted twice" (spec, verbatim). `providerEventId` is Resend's own
// webhook delivery id (Svix's `svix-id`) where available; a unique
// constraint makes re-delivery a genuine no-op at the database level, not
// just an application-level check that could race.
enum EmailProviderEventType {
  SENT
  DELIVERED
  BOUNCED
  HARD_BOUNCE
  SOFT_BOUNCE
  OPENED
  CLICKED
  REPLIED
  UNSUBSCRIBED
  COMPLAINT
  FAILED
  RATE_LIMITED
  // Phase 8 — WhatsApp-only; email in this app has no read-receipt concept.
  READ
}

model EmailProviderEvent {
  id                String                  @id @default(cuid())
  organizationId    String
  emailDraftId      String?
  sendingIdentityId String?
  provider          SendingIdentityProvider
  eventType         EmailProviderEventType
  recipient         String
  // Resend/Svix's own event id — the real idempotency key. Null for events
  // synthesized from this app's own tracking (open/click pixel), which
  // already have their own dedup via EmailDraft.firstOpenedAt/firstClickedAt.
  providerEventId   String?                 @unique
  metadata          Json?
  receivedAt        DateTime                @default(now())

  emailDraft      EmailDraft?      @relation(fields: [emailDraftId], references: [id], onDelete: SetNull)
  sendingIdentity SendingIdentity? @relation(fields: [sendingIdentityId], references: [id], onDelete: SetNull)

  @@index([organizationId, receivedAt])
  @@index([sendingIdentityId])
}

// Real suppression list — the single choke-point checkSuppression()
// (src/lib/outreach/suppression.ts) reads before EVERY send, across every
// provider. Always tenant-scoped (see SendingIdentity's doc comment above
// for why this phase deliberately drops the earlier "nullable = global"
// idea — rule 13 tenant isolation + Postgres NULL-uniqueness safety). This
// directly fixes a confirmed real gap: before this phase, only
// Contact.status === UNSUBSCRIBED was checked, only by the manual/scheduled
// send path — bouncedAt/complainedAt were never checked anywhere, and KVL's
// own automated first-touch path checked neither.
enum SuppressionReason {
  UNSUBSCRIBED
  SPAM_COMPLAINT
  HARD_BOUNCE
  MANUAL_SUPPRESSION
  LEGAL_REQUEST
  OTHER
}

// Phase 8 (WhatsApp Business Outreach) — extended in place (never a second
// suppression model, per that phase's explicit §6/§7 rule) with `channel` +
// `phone`. `email` is now nullable: an EMAIL-channel row still always has a
// real email and no phone; a WHATSAPP-channel row always has a real E.164
// phone and no email. Two separate unique indexes (not one compound on all
// three columns) because Postgres treats each NULL as distinct, so
// `[organizationId, channel, email]` alone would never collide across
// multiple phone-only WhatsApp rows (email always NULL there) — the second
// index is what actually enforces "no duplicate phone suppression per org".
model SuppressionEntry {
  id             String            @id @default(cuid())
  organizationId String
  channel        DraftChannel      @default(EMAIL)
  email          String?
  phone          String?
  reason         SuppressionReason
  source         String
  createdAt      DateTime          @default(now())

  @@unique([organizationId, channel, email])
  @@unique([organizationId, channel, phone])
  @@index([email])
  @@index([phone])
}

/**
 * Phase 8 (WhatsApp Business Outreach) — one real, active WhatsApp
 * conversation per (organizationId, contactId) with the org's connected
 * provider (Twilio's WhatsApp API — see whatsapp-provider.ts). Deliberately
 * a NEW model: there is no existing generic "conversation" row for any
 * channel in this schema (Email's "conversation" is just the implicit
 * (organizationId, contactId) grouping used throughout Phases 5/6) — this
 * genuinely new stateful entity (status, assignment, provider correlation
 * id) has no existing table to extend.
 */
model WhatsAppConversation {
  id                     String                     @id @default(cuid())
  organizationId         String
  companyId              String?
  contactId              String
  provider               SendingIdentityProvider    @default(TWILIO_WHATSAPP)
  // The real WhatsApp Business phone number this conversation is with (the
  // Contact's own phone at the time the conversation started — kept here so
  // a later phone-field edit on Contact never silently rewrites history).
  phoneNumber            String
  status                 WhatsAppConversationStatus @default(OPEN)
  // Twilio has no single "conversation id" for a WhatsApp session the way
  // some providers do — null today, reserved for a provider that does
  // (e.g. Meta's own conversation-id concept) rather than fabricated.
  providerConversationId String?
  startedAt              DateTime                   @default(now())
  lastMessageAt          DateTime?
  lastInboundAt          DateTime?
  lastOutboundAt         DateTime?
  assignedUserId         String?
  campaignId             String?
  opportunityId          String?
  // Set only from a real provider-reported restriction (e.g. a 24-hour
  // session window closed, an account-level restriction) — never inferred.
  restrictedReason       String?                    @db.Text

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedUser User?        @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  messages     EmailDraft[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, contactId])
  @@index([organizationId, status])
}

enum WhatsAppConversationStatus {
  OPEN
  CLOSED
  RESTRICTED
}

/**
 * Phase 8 — approved WhatsApp message templates. A genuinely new concept:
 * email has no provider-side template-approval workflow in this app.
 * `approvalStatus` mirrors the provider's own real state (Twilio Content
 * API approval) — never a locally-invented "approved" flag.
 */
model WhatsAppTemplate {
  id                 String                         @id @default(cuid())
  organizationId     String
  providerTemplateId String
  name               String
  language           String
  category           String
  variables          String[]                       @default([])
  approvalStatus     WhatsAppTemplateApprovalStatus @default(PENDING)
  lastSyncedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     EmailDraft[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, providerTemplateId])
}

enum WhatsAppTemplateApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  DISABLED
  UNKNOWN
}

/**
 * Phase 8 — rate-limit/health state for the org's WhatsApp Business sender
 * number. Mirrors SendingIdentity's exact counters/cooldown algorithm
 * (sending-identity.ts) but is its own model rather than reusing that table
 * directly: SendingIdentity is keyed on `email`+`domain` (both required,
 * both meaningless for a phone-based sender) — forcing a phone number into
 * an `email` column would be a dishonest field repurpose, not real reuse.
 */
model WhatsAppSendingIdentity {
  id              String                @id @default(cuid())
  organizationId  String
  phoneNumber     String
  status          SendingIdentityStatus @default(ACTIVE)
  dailyLimit      Int                   @default(250)
  hourlyLimit     Int                   @default(50)
  sentToday       Int                   @default(0)
  sentThisHour    Int                   @default(0)
  countersResetAt DateTime              @default(now())
  cooldownUntil   DateTime?
  cooldownReason  String?               @db.Text
  pausedAt        DateTime?
  pausedReason    String?               @db.Text
  lastSendAt      DateTime?
  lastErrorAt     DateTime?
  lastErrorReason String?               @db.Text

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, phoneNumber])
  @@index([organizationId])
}

// Audit trail of decisions on a draft — multiple rows per draft are allowed
// (a "changes requested" round-trip creates a new row), never overwritten.
model Approval {
  id              String           @id @default(cuid())
  organizationId  String
  emailDraftId    String
  requestedAt     DateTime         @default(now())
  decidedByUserId String?
  decision        ApprovalDecision @default(PENDING)
  comment         String?          @db.Text
  decidedAt       DateTime?

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  emailDraft    EmailDraft   @relation(fields: [emailDraftId], references: [id], onDelete: Cascade)
  decidedByUser User?        @relation(fields: [decidedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([emailDraftId])
}

// Every row is real content a prospect actually wrote back — either a human's
// own manual entry, or (KVL's own org only, see kvl-reply-sync-job.ts) the
// real body of a real received email, auto-captured via IMAP — never
// AI-fabricated either way. sentiment is real AI classification run over
// that real content, always labeled AI-inferred in the UI.
model Reply {
  id                String          @id @default(cuid())
  organizationId    String
  contactId         String
  campaignId        String?
  emailDraftId      String?
  channel           DraftChannel
  content           String          @db.Text
  sentiment         ReplySentiment?
  // Phase 6: AI Reply Intelligence — granular "what does the sender want
  // next" classification, distinct from sentiment (tone). All three are
  // populated by the same single AI call as sentiment, or left null
  // together when AI isn't connected — never independently fabricated.
  intent            ReplyIntent?
  intentConfidence  Float?
  suggestedResponse String?         @db.Text
  loggedByUserId    String
  receivedAt        DateTime        @default(now())
  // Phase 3 Email Center — explicit "marked as read" action, persisted
  // independent of message ordering. Distinct from inbox.ts's computed
  // `unread` (latest-event comparison, still used as the default state for
  // a reply nobody has opened yet) — this is the real, sticky record of a
  // human actually opening the thread. Null means never explicitly opened.
  readAt            DateTime?

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact                Contact                 @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaign               Campaign?               @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  emailDraft             EmailDraft?             @relation(fields: [emailDraftId], references: [id], onDelete: SetNull)
  loggedByUser           User                    @relation(fields: [loggedByUserId], references: [id], onDelete: Cascade)
  // Phase 6: real AI-suggested EmailDraft(s) generated in direct response to this reply.
  suggestedReplyDrafts   EmailDraft[]            @relation("DraftInReplyToReply")
  // KVL's own owner-escalation workflow (see RateNegotiation below) — a
  // reply classified PRICE_QUESTION gets exactly one negotiation thread.
  rateNegotiation        RateNegotiation?
  // Phase 21 — set only when this Reply's Contact is tagged
  // "career-application" (see application-submission.ts) and real career
  // classification actually ran. Every other org's ordinary sales Reply
  // never gets this row.
  recruiterCommunication RecruiterCommunication?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([contactId])
}

// ===== Phase 10 (AI Voice Sales Engine) =====
//
// ===== Consent, not suppression =====
// Phase 4's SuppressionEntry (extended for WHATSAPP in Phase 8) is a
// NEGATIVE list — "assume eligible unless explicitly opted out." Voice
// calling cannot use that default (§8: "Do not treat having a phone number
// as consent... If consent is required and absent: DO NOT CALL"). This is
// a genuinely new, POSITIVE consent record — absence of a row (or a row
// with status UNKNOWN) means NOT eligible, the inverse of every other
// channel's default in this app. Suppression is still checked in addition
// (an explicit VOICE opt-out always blocks regardless of any consent on
// file) — see voice-eligibility.ts.
enum VoiceConsentStatus {
  GRANTED
  DENIED
  UNKNOWN
}

enum VoiceRecordingConsent {
  RECORDING_ALLOWED
  RECORDING_REQUIRES_CONSENT
  RECORDING_NOT_ALLOWED
  UNKNOWN
}

model VoiceConsent {
  id             String @id @default(cuid())
  organizationId String
  contactId      String @unique

  status           VoiceConsentStatus @default(UNKNOWN)
  // Never inferred from a website/listing/email/LinkedIn/job title/company
  // size (§8) — must be a real, named, human-auditable source, e.g. "Signed
  // MSA clause 4.2", "Verbal consent on call CALL_ID at 00:01:12", "Opt-in
  // form submission #123".
  source           String?            @db.Text
  capturedAt       DateTime?
  capturedByUserId String?
  // Free-text jurisdiction/purpose — this app has no jurisdiction rule
  // engine; these are recorded for a human/legal reviewer, never used to
  // auto-approve a call.
  jurisdiction     String?
  purpose          String?
  evidence         String?            @db.Text

  recordingConsent VoiceRecordingConsent @default(UNKNOWN)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  capturedByUser User?        @relation(fields: [capturedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

enum CallDirection {
  OUTBOUND
  INBOUND
}

// §6 — only ELIGIBLE may proceed to call execution.
enum CallEligibilityStatus {
  ELIGIBLE
  CONSENT_REQUIRED
  DO_NOT_CALL
  OPTED_OUT
  INVALID_NUMBER
  OUTSIDE_ALLOWED_TIME
  PROVIDER_RESTRICTED
  JURISDICTION_RESTRICTED
  UNKNOWN
}

// §13 — real, provider-confirmed states only.
enum CallStatus {
  CALL_REQUESTED
  RINGING
  ANSWERED
  NO_ANSWER
  BUSY
  VOICEMAIL
  FAILED
  COMPLETED
  CANCELLED
}

enum CallOutcome {
  INTERESTED
  NOT_INTERESTED
  CALLBACK
  MEETING_REQUESTED
  QUALIFIED
  DISQUALIFIED
  NO_ANSWER
  BUSY
  VOICEMAIL
  UNKNOWN
}

// §14 — outcome provenance is always recorded, so "QUALIFIED" can never be
// silently attributed to "the AI sounded positive."
enum CallOutcomeSetBy {
  PROVIDER_STATUS
  HUMAN
  AI_SUGGESTED
}

enum CallTranscriptStatus {
  TRANSCRIPT_AVAILABLE
  TRANSCRIPT_NOT_AVAILABLE
  TRANSCRIPT_NOT_PERMITTED
  TRANSCRIPT_FAILED
}

/**
 * Phase 10 (AI Voice Sales Engine) — one real row per real call attempt.
 * `status`/`recordingStatus`/`transcriptStatus` only ever change on a real
 * provider event (webhook) or an explicit human action — never assumed.
 * `eligibilityStatus`/`consentStatus`/`recordingConsentStatus` are a
 * SNAPSHOT of the real eligibility/consent check performed immediately
 * before this call was placed (voice-eligibility.ts) — kept here so a
 * later consent change never rewrites the historical record of what was
 * actually true at call time.
 */
model Call {
  id             String  @id @default(cuid())
  organizationId String
  companyId      String?
  contactId      String
  leadId         String?
  opportunityId  String?
  campaignId     String?

  provider       String  @default("TWILIO")
  providerCallId String? @unique

  direction CallDirection

  eligibilityStatus      CallEligibilityStatus
  consentStatus          VoiceConsentStatus
  recordingConsentStatus VoiceRecordingConsent
  // Set only once the real disclosure statement was actually played/sent
  // to the recipient (§11) — never assumed true.
  aiDisclosureGiven      Boolean               @default(false)

  status       CallStatus        @default(CALL_REQUESTED)
  outcome      CallOutcome?
  outcomeSetBy CallOutcomeSetBy?

  startedAt       DateTime?
  answeredAt      DateTime?
  endedAt         DateTime?
  durationSeconds Int?

  recordingStatus      VoiceRecordingConsent @default(UNKNOWN)
  // Provider REFERENCE only — the actual audio stays with the provider,
  // never duplicated into this app's own storage (§16: "prefer storing a
  // secure reference ... rather than unnecessarily duplicating sensitive
  // data").
  recordingProviderRef String?

  transcriptStatus  CallTranscriptStatus @default(TRANSCRIPT_NOT_AVAILABLE)
  // The real Reply row (channel: VOICE) carrying the actual transcript
  // text, once available — plain scalar id (not a relation) since it's
  // looked up directly, never joined/grouped-by, mirroring
  // RevenueAttribution's leadId/opportunityId convention (Phase 7).
  transcriptReplyId String?

  cost     Float?
  currency String?

  failedReason String? @db.Text
  cancelReason String? @db.Text

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([contactId])
  @@index([companyId])
  @@index([campaignId])
}

// ===== Phase 6 (AI Conversation Intelligence) =====
// A "thread" in this codebase is the real, already-existing grouping by
// (organizationId, contactId) — the same grouping the Inbox UI
// (/dashboard/outreach/inbox/[contactId]) and getContactTimeline already
// use. There is no separate Thread/Message model anywhere (confirmed
// before adding this), so `contactId` IS the thread identity — never a
// second thread concept.
//
// Append-only history (one row per analysis run), mirroring this session's
// own established precedent (IntentScoreHistory, EnrichmentRun,
// PredictionCalibration) for "needs real versioning, never overwritten" —
// the latest row per contactId (by generatedAt) is the current
// intelligence; older rows remain queryable, satisfying spec §21.
enum ConversationIntent {
  INFORMATION_REQUEST
  INTERESTED
  EVALUATING
  REQUEST_FOR_PROPOSAL
  REQUEST_FOR_DEMO
  NEGOTIATING
  READY_TO_BUY
  NOT_INTERESTED
  FOLLOW_UP
  SUPPORT
  GENERAL
  UNKNOWN
}

enum ConversationSentiment {
  POSITIVE
  NEUTRAL
  MIXED
  NEGATIVE
  UNKNOWN
}

enum ConversationUrgency {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  UNKNOWN
}

enum BudgetSignalType {
  EXPLICIT_BUDGET
  BUDGET_RANGE
  BUDGET_CONCERN
  PRICE_SENSITIVITY
  NO_BUDGET_MENTION
  UNKNOWN
}

enum DecisionMakerSignalType {
  KNOWN_DECISION_MAKER
  POTENTIAL_DECISION_MAKER
  NOT_IDENTIFIED
}

enum ConversationAnalysisStatus {
  COMPLETED
  PARTIAL
  FAILED
}

model ConversationIntelligence {
  id             String  @id @default(cuid())
  organizationId String
  companyId      String?
  contactId      String
  // Alias of contactId, per the spec's own field name — kept as a real
  // column (not just a doc comment) so API responses can use the exact
  // vocabulary the spec asked for without the reader needing to know the
  // "contactId = threadId" mapping.
  threadId       String

  intent                 ConversationIntent    @default(UNKNOWN)
  sentiment              ConversationSentiment @default(UNKNOWN)
  urgency                ConversationUrgency   @default(UNKNOWN)
  // Evidence-only — NEVER auto-overwrites the real IntentScore.buyingStage
  // (Phase 2). Nullable: absent when the transcript gives no real evidence.
  detectedBuyingStage    BuyingStage?
  detectedBuyingStageWhy String?               @db.Text

  // Each Json array element: { value/type, description, sourceMessageId,
  // sourceQuote, confidence: HIGH|MEDIUM|LOW, classification:
  // CONFIRMED|INFERRED|UNKNOWN } — requirements additionally carry
  // classification CLIENT_STATED_REQUIREMENT vs AI_RECOMMENDATION.
  objections         Json @default("[]")
  requirements       Json @default("[]")
  questions          Json @default("[]")
  requestedServices  Json @default("[]")
  competitorMentions Json @default("[]")

  budgetSignal       BudgetSignalType @default(UNKNOWN)
  budgetSignalDetail String?          @db.Text

  timelineSignalRaw        String? @db.Text
  timelineSignalNormalized String?
  timelineSourceMessageId  String?

  decisionMakerSignal    DecisionMakerSignalType @default(NOT_IDENTIFIED)
  decisionMakerSignalWhy String?                 @db.Text

  // { clientRequestedAction, internalAction, aiRecommendedAction } — each
  // separately labeled, never merged into one ambiguous "next action".
  nextAction Json @default("{}")

  // The spec §20 structured summary — { status, clientNeed, objection,
  // timeline, requestedService, nextAction, evidence: string[] }.
  summary Json @default("{}")

  confidence String                     @default("UNKNOWN") // HIGH | MEDIUM | LOW | UNKNOWN — explainable via the evidence in each field above, never a bare number
  status     ConversationAnalysisStatus @default(COMPLETED)
  error      String?                    @db.Text

  // Cost control (§31): the exact set of EmailDraft/Reply ids this run
  // actually analyzed — the next analysis compares the thread's CURRENT
  // message-id set against this to detect "nothing new since last run"
  // without needing a separate hash column.
  analyzedMessageIds String[] @default([])

  // Human override (§38) — never erases the AI original (this whole row
  // stays exactly as generated); an override is a NEW row that copies the
  // prior fields and records what a human changed and why.
  overriddenField    String?
  overriddenValue    String?
  overriddenByUserId String?
  overrideReason     String? @db.Text

  model         String?
  provider      String?
  promptVersion String   @default("v1")
  generatedAt   DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([contactId, generatedAt])
  @@index([companyId])
}

enum RateNegotiationStatus {
  // AI has emailed the real owner with the client's ask + a grounded rate
  // recommendation; waiting for the owner's real reply.
  AWAITING_OWNER
  // Owner replied (captured via the same real IMAP mailbox as client
  // replies — kvl-reply-sync-job.ts) with their final decision.
  OWNER_RESPONDED
  // The owner-approved reply-to-client draft has been sent, and the
  // owner<->client closing meeting has been requested.
  CLIENT_REPLIED
}

// KVL-only (this org's own outreach, same "hardcoded to KVL" convention as
// kvl-sector-discovery-job.ts / kvl-reply-sync-job.ts) real owner-in-the-loop
// pricing escalation: a client's PRICE_QUESTION reply triggers a real email
// to the real business owner with a grounded rate recommendation (never a
// fabricated number); the owner's own real reply (captured via IMAP) is the
// final word, relayed back to the client as a human-approved EmailDraft, plus
// a real OutreachMeeting request so the owner personally closes the deal —
// see src/lib/business-development/rate-negotiation.ts.
model RateNegotiation {
  id             String @id @default(cuid())
  organizationId String
  companyId      String
  contactId      String
  replyId        String @unique

  // Real excerpt of the client's own reply that triggered this — never
  // paraphrased into something the client didn't actually say.
  clientMessage           String @db.Text
  // What real, already-persisted context (LeadOpportunity/CompanyIntelligence/
  // CompanyEvidence) the AI recommendation below was actually grounded in —
  // an honest "no real scope information yet" when there isn't any, never
  // invented project detail.
  scopeSummary            String @db.Text
  // In INR. Null when there's genuinely not enough real scope context to
  // recommend anything beyond KVL's own floor (see kvl-service-catalog.ts) —
  // never a guessed number standing in for real analysis.
  recommendedRateINR      Int?
  recommendationReasoning String @db.Text

  status             RateNegotiationStatus @default(AWAITING_OWNER)
  ownerEmailSentAt   DateTime?
  // Real, unedited body text of the owner's own reply email — the actual
  // final word on rate, never AI-paraphrased.
  ownerReplyContent  String?               @db.Text
  ownerRespondedAt   DateTime?
  clientReplyDraftId String?
  outreachMeetingId  String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  reply        Reply        @relation(fields: [replyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([companyId])
}

// Named OutreachMeeting (not Meeting) — the AI Executive Board's internal
// multi-agent Meeting model already owns that name.
model OutreachMeeting {
  id               String                @id @default(cuid())
  organizationId   String
  contactId        String
  campaignId       String?
  emailDraftId     String?
  title            String
  agenda           String?               @db.Text
  discussionTopics String[]
  proposedTimes    Json?
  status           OutreachMeetingStatus @default(REQUESTED)
  scheduledAt      DateTime?
  icsGenerated     Boolean               @default(false)
  notes            String?               @db.Text

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  emailDraft   EmailDraft?  @relation(fields: [emailDraftId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// Real daily rollups per campaign — same convention as the existing
// MetricSnapshot / ensureTodaySnapshot().
model CampaignAnalyticsSnapshot {
  id                   String   @id @default(cuid())
  campaignId           String
  date                 DateTime
  emailsSent           Int      @default(0)
  opensCount           Int      @default(0)
  clicksCount          Int      @default(0)
  repliesCount         Int      @default(0)
  positiveRepliesCount Int      @default(0)
  meetingsBookedCount  Int      @default(0)
  failedCount          Int      @default(0)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([campaignId, date])
}

// ============================= Phase 13: AI Proposal Review Board =============================
// A BoardReview sits on top of the existing Meeting/MeetingParticipant/
// MeetingMessage/Decision/DecisionVote engine (Phase 3: AI Executive Board)
// — it is a thin query anchor + the two genuinely new structured analyses
// (RiskAnalysis, ProfitAnalysis), not a parallel meeting system. docKind
// reuses the existing DocumentKind enum; docId is polymorphic and
// app-enforced, same convention as DocumentVersion/Signature.

enum BoardReviewDecision {
  APPROVED
  APPROVED_WITH_CHANGES
  NEEDS_REVISION
  REJECTED
}

model BoardReview {
  id                String               @id @default(cuid())
  organizationId    String
  meetingId         String               @unique
  decisionId        String?              @unique
  docKind           DocumentKind
  docId             String
  finalDecision     BoardReviewDecision?
  overallConfidence Float?
  winProbability    Float?
  requestedByUserId String?

  overriddenAt       DateTime?
  overriddenByUserId String?
  overrideReason     String?   @db.Text

  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting          Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  decision         Decision?       @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  requestedByUser  User?           @relation("BoardReviewRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  overriddenByUser User?           @relation("BoardReviewOverriddenBy", fields: [overriddenByUserId], references: [id], onDelete: SetNull)
  riskAnalysis     RiskAnalysis?
  profitAnalysis   ProfitAnalysis?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([docKind, docId])
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ============================= Self-improvement: prediction calibration =============================
// Real, closed feedback loop — not another dashboard stat. BoardReview.win-
// Probability (an AI-estimated, honestly-elicited win probability, never
// fabricated — see runReviewAgentTurn's system prompt) already sits next to
// a real terminal outcome (Proposal.status ACCEPTED/REJECTED, joined via
// BoardReview.docKind/docId). This model is the computed comparison between
// the two, and its latest row is fed back into future review rounds
// (review-orchestrator.ts) so past real outcomes change what a future
// agent's win-probability estimate is grounded in.
//
// One row per computation run (append-only, never upserted) — same shape as
// ExecutiveBriefing, not per-band rows, because the only real read pattern
// is "give me the latest snapshot for org X," not a cross-run join.
model PredictionCalibration {
  id             String   @id @default(cuid())
  organizationId String
  // Real terminal (ACCEPTED/REJECTED) proposals this run was computed from.
  // computePredictionCalibration() refuses to persist below a minimum
  // sample size — same "honest or nothing" convention as everywhere else in
  // this codebase, never a stat from a noisy handful of outcomes.
  sampleSize     Int
  // CalibrationBand[] (src/lib/ai/prediction-calibration.ts) — bands with
  // zero samples are kept, never hidden, so the UI and the injected
  // feedback text can honestly show "no data yet" per band.
  bandsJson      Json
  // Deterministic (not AI-generated) one-line narrative — zero AI cost to
  // compute nightly for every org.
  summary        String   @db.Text
  computedAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, computedAt])
}

// The Legal Agent's structured deep-dive for one BoardReview — real,
// LLM-produced output (see runReviewAgentTurn's LegalReviewTurnSchema),
// never a fabricated/default checklist.
model RiskAnalysis {
  id               String    @id @default(cuid())
  boardReviewId    String    @unique
  contractTermsOk  Boolean?
  missingClauses   String[]
  ndaRequired      Boolean?
  liabilityRisk    String?   @db.Text
  warrantyRisk     String?   @db.Text
  complianceNotes  String?   @db.Text
  overallRiskLevel RiskLevel @default(LOW)
  riskFactors      String[]

  boardReview BoardReview @relation(fields: [boardReviewId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum PaymentRiskLevel {
  LOW
  MEDIUM
  HIGH
}

// The Finance Agent's structured deep-dive for one BoardReview (see
// runReviewAgentTurn's FinanceReviewTurnSchema).
model ProfitAnalysis {
  id               String           @id @default(cuid())
  boardReviewId    String           @unique
  estimatedRevenue Float?
  estimatedCost    Float?
  grossMargin      Float?
  netMargin        Float?
  profit           Float?
  discountImpact   Float?
  paymentRiskLevel PaymentRiskLevel @default(LOW)
  paymentRiskNotes String?          @db.Text

  boardReview BoardReview @relation(fields: [boardReviewId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ===== Approval Policy Engine =====
// Reusable gate (src/lib/approval-engine.ts) in front of the existing
// "Send to client" actions from Phase 12. Deliberately minimal — future
// phases (Projects, Billing, Enterprise Workflow Automation) extend
// appliesToDocKinds / mode rather than rebuilding checkApprovalGate.

enum ApprovalPolicyMode {
  ADVISORY
  APPROVAL_REQUIRED
}

model OrganizationApprovalPolicy {
  id                 String             @id @default(cuid())
  organizationId     String             @unique
  mode               ApprovalPolicyMode @default(ADVISORY)
  appliesToDocKinds  DocumentKind[]
  allowOwnerOverride Boolean            @default(true)
  updatedByUserId    String?

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedByUser User?        @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================= Phase 14: Enterprise Project Management + Client Portal =============================
// Project/Task were extended in place above (see "Phase 14" comments on
// each). Everything below is genuinely new: the project delivery layer
// (members/milestones/sprints/risk/time-tracking/status-change log/generic
// comments) and a Client Portal authentication system fully isolated from
// the internal User/Membership/Auth.js stack — separate models, separate
// opaque-token session cookie, separate guard function. A ClientPortalUser
// is anchored to Client (not to Projects specifically) so this same auth
// system is reusable by future white-label portals without schema changes.

enum ProjectRole {
  PROJECT_MANAGER
  DEVELOPER
  DESIGNER
  QA
  DEVOPS
  CONSULTANT
  STAKEHOLDER
}

model ProjectMember {
  id                   String      @id @default(cuid())
  projectId            String
  userId               String
  organizationId       String
  role                 ProjectRole
  // Enables real budget-burn math from real TimeEntry data — never a
  // fabricated cost estimate.
  hourlyRate           Float?
  capacityHoursPerWeek Float?
  joinedAt             DateTime    @default(now())

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([organizationId])
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
}

model Milestone {
  id                       String          @id @default(cuid())
  projectId                String
  name                     String
  description              String?         @db.Text
  dueDate                  DateTime?
  completedAt              DateTime?
  status                   MilestoneStatus @default(PENDING)
  order                    Int             @default(0)
  // Client Portal visibility — real milestones seeded on project creation
  // default to visible; internal-only milestones can be hidden.
  visibleToClient          Boolean         @default(true)
  clientApprovedAt         DateTime?
  // Real client-submitted signal, not a fabricated one — the ONLY data
  // source anywhere in this phase for a "client satisfaction" metric.
  clientSatisfactionRating Int?

  clientApprovedByPortalUserId String?

  project                    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientApprovedByPortalUser ClientPortalUser? @relation(fields: [clientApprovedByPortalUserId], references: [id], onDelete: SetNull)
  tasks                      Task[]

  @@index([projectId])
}

enum SprintStatus {
  PLANNING
  ACTIVE
  COMPLETED
}

model Sprint {
  id                 String       @id @default(cuid())
  projectId          String
  organizationId     String
  name               String
  goal               String?      @db.Text
  startDate          DateTime
  endDate            DateTime
  capacityHours      Float?
  status             SprintStatus @default(PLANNING)
  retrospectiveNotes String?      @db.Text

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@index([projectId])
  @@index([organizationId])
}

enum ProjectRiskCategory {
  DELAYED_TASK
  OVER_BUDGET
  MISSING_RESOURCE
  BLOCKED_TASK
  LATE_APPROVAL
  CLIENT_RISK
  OTHER
  // Added for the AI Delivery Board (Phase 5).
  DEVELOPER_OVERLOAD
  QA_FAILURE
  SECURITY_ISSUE
  DEPLOYMENT_RISK
}

enum ProjectRiskStatus {
  OPEN
  MITIGATED
  RESOLVED
}

// Named ProjectRisk (not Risk) to avoid confusion with the existing,
// unrelated RiskAnalysis (the Legal Agent's per-document-review deep-dive
// from the AI Proposal Review Board phase).
model ProjectRisk {
  id                String              @id @default(cuid())
  projectId         String
  organizationId    String
  category          ProjectRiskCategory
  // Reuses the existing RiskLevel enum (LOW/MEDIUM/HIGH/CRITICAL) rather
  // than declaring a duplicate.
  severity          RiskLevel
  status            ProjectRiskStatus   @default(OPEN)
  title             String
  description       String              @db.Text
  detectedByAgentId String?
  relatedTaskId     String?
  resolvedAt        DateTime?
  createdAt         DateTime            @default(now())

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  detectedByAgent AIAgentInstance? @relation(fields: [detectedByAgentId], references: [id], onDelete: SetNull)
  relatedTask     Task?            @relation(fields: [relatedTaskId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([organizationId])
}

// ============================= Phase 5: AI Delivery Board =============================

// One real row per project per day, lazily upserted on first view each day —
// exact shape/precedent of MetricSnapshot's ensureTodaySnapshot pattern,
// applied per-project instead of per-org. The CURRENT score is always
// computed fresh on read (computeProjectHealthScore); this table exists only
// for trend history, never backfilled with fake past data points.
model ProjectHealthSnapshot {
  id                     String   @id @default(cuid())
  projectId              String
  organizationId         String
  date                   DateTime @db.Date
  deliveryScore          Int
  qualityScore           Int
  velocityScore          Int
  riskScore              Int
  budgetScore            Int
  customerHappinessScore Int
  overallScore           Int
  createdAt              DateTime @default(now())

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([projectId, date])
  @@index([organizationId, date])
}

enum DeliveryReportType {
  DAILY
  WEEKLY
  MONTHLY
  PROJECT_HEALTH
  RISK
}

// Owner-triggered (no cron exists in this app) — a real log of "this report
// was generated and emailed to N owners". sendEmail has no attachment
// support, so the email body is the summary + a link back into the app,
// never a fabricated PDF attachment.
model DeliveryReport {
  id              String             @id @default(cuid())
  organizationId  String
  projectId       String?
  type            DeliveryReportType
  summary         String             @db.Text
  recipientCount  Int
  createdByUserId String?
  generatedAt     DateTime           @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdByUser User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([projectId])
}

enum TimeEntrySource {
  MANUAL
  TIMER
  // Real browser-side idle detection (see time/_components/idle-tracker.tsx)
  // — never a fabricated/estimated duration. AUTO is a background timer that
  // keeps running while the tab is open and the user is active; IDLE is the
  // segment automatically split off once the browser's idle detector fires
  // (no keyboard/mouse activity past the threshold), so idle time is visible
  // and editable rather than silently billed.
  AUTO
  IDLE
}

model TimeEntry {
  id              String          @id @default(cuid())
  organizationId  String
  projectId       String
  taskId          String?
  userId          String
  startedAt       DateTime
  endedAt         DateTime?
  // Computed on stop (or manual entry) — never hand-typed to a fabricated
  // value while the timer is genuinely still running (null until then).
  durationMinutes Int?
  billable        Boolean         @default(true)
  source          TimeEntrySource @default(MANUAL)
  note            String?
  createdAt       DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([projectId])
  @@index([taskId])
  @@index([userId])
}

// Deterministic log of every Task.status transition — powers real sprint
// burndown/velocity without repurposing the unstructured Activity feed or
// the org-wide-daily-grain MetricSnapshot (neither fits). Written by every
// task status-change action from day one, not backfilled later.
model TaskStatusChange {
  id             String      @id @default(cuid())
  taskId         String
  organizationId String
  fromStatus     TaskStatus?
  toStatus       TaskStatus
  changedAt      DateTime    @default(now())

  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([organizationId, changedAt])
}

enum CommentDocKind {
  TASK
  PROJECT
  MILESTONE
  KNOWLEDGE_ARTICLE
}

// Semi-polymorphic: docKind+docId is app-enforced (same convention as
// BoardReview/DocumentVersion/Signature elsewhere in this app), but the
// author side is two real concrete FKs (not open-ended) since there are
// only two kinds of comment author in this app: an internal User or a
// portal Client.
model Comment {
  id                       String         @id @default(cuid())
  organizationId           String
  docKind                  CommentDocKind
  docId                    String
  authorUserId             String?
  authorClientPortalUserId String?
  content                  String         @db.Text
  mentionedUserIds         String[]
  // Phase 19 (Support Agent): true for internal team notes on a
  // TaskType.SUPPORT ticket that must never be visible to the client
  // portal author's side of the same thread. False (the default) for every
  // pre-existing Comment use — an ordinary comment stays visible as before.
  isInternalNote           Boolean        @default(false)
  createdAt                DateTime       @default(now())

  organization           Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authorUser             User?             @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  authorClientPortalUser ClientPortalUser? @relation(fields: [authorClientPortalUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([docKind, docId])
}

// ===== Client Portal Authentication — fully isolated from User/Membership/Auth.js =====
// Separate session cookie, separate opaque-token table (never a JWT, so
// individual/bulk revocation is a plain DB update), separate device and
// security-settings models. A portal login is only ever possible for an
// email that matches a real Client contact — no open signup.

model ClientPortalUser {
  id                  String    @id @default(cuid())
  clientId            String
  organizationId      String
  email               String    @unique
  name                String?
  // Null until the client opts in from Security Settings — magic link is
  // the always-available default, password is additive.
  passwordHash        String?
  // Persistent password-login lockout — same mechanism as User.failedLoginAttempts
  // / User.lockedUntil in src/auth.ts, so loginWithPassword() gets real
  // brute-force protection instead of none.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  // Stamped the first time a LOGIN magic link is successfully consumed —
  // clicking a real emailed link IS proof of ownership.
  emailVerifiedAt     DateTime?
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  sessions           ClientSession[]
  devices            ClientDevice[]
  authTokens         ClientAuthToken[]
  securitySettings   ClientSecuritySettings?
  comments           Comment[]
  approvedMilestones Milestone[]

  @@index([clientId])
  @@index([organizationId])
}

enum ClientTokenPurpose {
  LOGIN
  EMAIL_VERIFY
  PASSWORD_RESET
}

model ClientAuthToken {
  id                 String             @id @default(cuid())
  clientPortalUserId String
  // Hashed — the raw token is only ever in the emailed URL, never stored.
  tokenHash          String             @unique
  purpose            ClientTokenPurpose
  expiresAt          DateTime
  consumedAt         DateTime?
  createdAt          DateTime           @default(now())

  clientPortalUser ClientPortalUser @relation(fields: [clientPortalUserId], references: [id], onDelete: Cascade)

  @@index([clientPortalUserId])
}

model ClientDevice {
  id                 String   @id @default(cuid())
  clientPortalUserId String
  // Random id persisted in a long-lived cookie — a stable per-browser
  // identifier, NOT real hardware/browser fingerprinting.
  fingerprint        String
  label              String?
  userAgent          String?
  trusted            Boolean  @default(false)
  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @default(now())

  clientPortalUser ClientPortalUser @relation(fields: [clientPortalUserId], references: [id], onDelete: Cascade)
  sessions         ClientSession[]

  @@unique([clientPortalUserId, fingerprint])
}

model ClientSession {
  id                 String    @id @default(cuid())
  clientPortalUserId String
  deviceId           String?
  // Hashed opaque session token — NOT a JWT, so "logout everywhere" and
  // per-session revocation are plain DB updates, not a token-blacklist hack.
  tokenHash          String    @unique
  ipAddress          String?
  userAgent          String?
  // Controls expiresAt length and the cookie's Max-Age.
  rememberMe         Boolean   @default(false)
  expiresAt          DateTime
  lastActiveAt       DateTime  @default(now())
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())

  clientPortalUser ClientPortalUser @relation(fields: [clientPortalUserId], references: [id], onDelete: Cascade)
  device           ClientDevice?    @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([clientPortalUserId])
}

model ClientSecuritySettings {
  id                 String    @id @default(cuid())
  clientPortalUserId String    @unique
  // Architecture only, per explicit product decision — no working TOTP
  // verification flow is built this phase. The UI must render this as a
  // visible "coming soon" state, never a toggle that silently no-ops.
  twoFactorEnabled   Boolean   @default(false)
  twoFactorSecret    String?
  // Architecture only — no WebAuthn implementation this phase.
  passkeysEnabled    Boolean   @default(false)
  passwordSetAt      DateTime?
  updatedAt          DateTime  @updatedAt

  clientPortalUser ClientPortalUser @relation(fields: [clientPortalUserId], references: [id], onDelete: Cascade)
}

enum ScheduledJobRunStatus {
  RUNNING
  SUCCESS
  FAILED
  RETRYING
}

// Registry of recurring background jobs, run by the Scheduler Service
// (src/lib/scheduler/*). Provider-agnostic by design: today the only
// concrete provider is node-cron (src/lib/scheduler/providers/node-cron-provider.ts),
// running in-process. Business-logic job handlers (src/lib/scheduler/registry.ts)
// never call node-cron directly — they implement JobDefinition.handler against
// the SchedulerProvider interface, so swapping to BullMQ+Redis or Temporal later
// only means writing a new provider, never touching a handler.
model ScheduledJob {
  id             String    @id @default(cuid())
  key            String    @unique // stable handler key, e.g. "daily-board-meeting"
  name           String
  cronExpression String
  enabled        Boolean   @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  // BullMQ job priority (1 highest – 5 lowest), mirrored from JobDefinition.priority
  // so the Job Management Dashboard can display it without importing registry.ts.
  priority       Int?

  runs ScheduledJobRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScheduledJobRun {
  id         String                @id @default(cuid())
  jobId      String
  status     ScheduledJobRunStatus @default(RUNNING)
  startedAt  DateTime              @default(now())
  finishedAt DateTime?
  attempt    Int                   @default(1)
  error      String?               @db.Text
  // Freeform structured log lines the handler emits, e.g.
  // [{ at, level, message, organizationId? }] — shown verbatim in the Job
  // Management Dashboard's log viewer, never summarized/fabricated.
  logs       Json?

  job ScheduledJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, startedAt])
  @@index([status])
}

