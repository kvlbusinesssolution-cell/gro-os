// ============================= Phase 20: Global Launch & Enterprise Readiness =============================
// Everything below reuses existing infrastructure wherever it already covers the requirement
// (ComplianceReport = the SOC2/ISO27001/GDPR "ComplianceAudit" artifact, Incident.category =
// the "SecurityIncident" register, Backup/Restore = "BackupHistory", SystemHealthSnapshot =
// availability monitoring) — the models below are only the genuinely new surfaces: a
// security-specific risk register, per-org RBAC access-review campaigns, real (never
// fabricated) load-test results, a real launch-readiness checklist snapshot, a catalog of
// generated enterprise documentation, GDPR consent persistence, and platform emergency
// contacts.

enum SecurityRiskCategory {
  DATA_SECURITY
  ACCESS_CONTROL
  THIRD_PARTY
  AVAILABILITY
  COMPLIANCE
  OPERATIONAL
}

enum SecurityRiskStatus {
  OPEN
  MITIGATING
  MITIGATED
  ACCEPTED
}

enum RiskBand {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// SOC2/ISO27001 risk register — platform-wide (this is the platform's own
// security posture as a vendor, not any one tenant's business risk; see
// the pre-existing, unrelated RiskLevel/ChurnRiskAssessment for business
// risk). riskScore/band are always deterministic (likelihood * impact),
// never AI-guessed.
model SecurityRisk {
  id              String               @id @default(cuid())
  title           String
  description     String               @db.Text
  category        SecurityRiskCategory
  likelihood      Int // 1-5
  impact          Int // 1-5
  riskScore       Int // likelihood * impact, deterministic
  band            RiskBand
  status          SecurityRiskStatus   @default(OPEN)
  mitigationPlan  String?              @db.Text
  ownerUserId     String?
  createdByUserId String?
  reviewedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, band])
}

enum AccessReviewStatus {
  IN_PROGRESS
  COMPLETED
}

// A periodic RBAC certification campaign for one organization's own
// membership roster — an OWNER/ADMIN confirms or revokes each real
// Membership's role. `findings` is a real snapshot taken at campaign start
// ([{membershipId, userName, email, role, decision, decidedAt}]); decisions
// are recorded into the same array entries, never a separate fabricated
// summary.
model AccessReview {
  id                String             @id @default(cuid())
  organizationId    String
  initiatedByUserId String
  status            AccessReviewStatus @default(IN_PROGRESS)
  periodLabel       String
  findings          Json
  completedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
}

enum LoadTestScenario {
  SMOKE_10
  RAMP_100
  RAMP_500
  RAMP_1000
  RAMP_10000
}

// A real, actually-executed k6 run's results — a row is only ever written
// after a real k6/autocannon process completes against a real target (see
// scripts/load-test.js). RAMP_1000/RAMP_10000 rows are only ever written
// if that scale was genuinely run against real infrastructure; the
// Performance dashboard must render an honest "not yet run at this scale"
// state rather than let a missing row imply failure.
model LoadTestResult {
  id                String           @id @default(cuid())
  scenario          LoadTestScenario
  targetConcurrency Int
  requestsCompleted Int
  durationMs        Int
  p50Ms             Int
  p95Ms             Int
  p99Ms             Int
  errorRate         Float
  requestsPerSecond Float
  bottlenecks       Json?
  rawOutputPath     String?
  runByUserId       String?

  runAt DateTime @default(now())

  @@index([scenario, runAt])
}

enum LaunchCheckStatus {
  PASS
  WARN
  FAIL
}

// A real, point-in-time snapshot of the deterministic launch-readiness
// checker (env vars, DB, storage, queue, Redis, SMTP, AI/payment/OAuth
// providers, marketplace, automation, monitoring, security, backups) —
// `checks` is real Json ([{key, label, category, status, detail}]),
// `overallScore` is computed from real pass/warn/fail counts, never set
// independently of them.
model LaunchChecklistRun {
  id           String  @id @default(cuid())
  checks       Json
  overallScore Int
  passCount    Int
  warnCount    Int
  failCount    Int
  runByUserId  String?

  runAt DateTime @default(now())

  @@index([runAt])
}

enum EnterpriseDocCategory {
  ARCHITECTURE
  API
  DEVELOPER
  ADMINISTRATOR
  DEPLOYMENT
  DISASTER_RECOVERY
  SECURITY
  COMPLIANCE
  MARKETPLACE
  AI_AGENT
  INTEGRATION
  WHITE_LABEL
}

// Catalog of the real Markdown files generated under docs/enterprise/ —
// `wordCount` is computed from the actual file contents at generation
// time, so the admin docs index can honestly report "12/12 present"
// instead of a hardcoded claim.
model EnterpriseDocument {
  id                String                @id @default(cuid())
  slug              String                @unique
  title             String
  category          EnterpriseDocCategory
  filePath          String
  wordCount         Int
  generatedByUserId String?

  lastGeneratedAt DateTime
  createdAt       DateTime @default(now())

  @@index([category])
}

enum ConsentType {
  COOKIES_ANALYTICS
  COOKIES_MARKETING
  MARKETING_EMAILS
  DATA_PROCESSING
}

// Server-side GDPR consent persistence for authenticated users — the
// existing cookie-consent-banner.tsx already handles anonymous,
// pre-auth consent client-side (localStorage); this model is the real gap
// it doesn't cover: a durable, queryable record ("did user X consent to Y
// on date Z") that DSR exports and the Compliance dashboard can read.
model ConsentRecord {
  id             String      @id @default(cuid())
  organizationId String
  userId         String
  consentType    ConsentType
  granted        Boolean
  ipAddress      String?
  source         String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId, userId, consentType])
}

// Real platform-wide escalation contacts for the Business Continuity /
// Disaster Recovery dashboard — plain admin-managed data (a name/role/
// email is not something that can be "computed", so it's honestly just
// configuration, not a fabricated on-call roster).
model EmergencyContact {
  id              String  @id @default(cuid())
  name            String
  role            String
  email           String
  phone           String?
  escalationOrder Int     @default(1)
  active          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([escalationOrder])
}

// ===================== Phase 20 compliance-center expansion =====================
// Five real, admin-authored registers that close the SOC2/ISO27001/GDPR gaps the
// pre-existing compliance.ts honestly reported as MISSING or "manual" (Policy
// Center, Vendor/sub-processor register + DPA tracking, Asset Inventory,
// Statement of Applicability, Change Management). Same philosophy as
// SecurityRisk/AccessReview above: real, queryable, admin-maintained rows —
// never pre-seeded with fabricated examples or fake official standard text.

enum PolicyCategory {
  ACCESS_CONTROL
  DATA_PROTECTION
  INCIDENT_RESPONSE
  BUSINESS_CONTINUITY
  ACCEPTABLE_USE
  VENDOR_MANAGEMENT
  CHANGE_MANAGEMENT
  RISK_MANAGEMENT
  OTHER
}

enum PolicyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// SOC2 CC1-CC5 / ISO27001 A.5 "information security policies" — real
// admin-authored policy documents with version history and a review
// cadence, not static markdown in docs/.
model SecurityPolicy {
  id              String         @id @default(cuid())
  title           String
  category        PolicyCategory
  content         String         @db.Text
  version         Int            @default(1)
  status          PolicyStatus   @default(DRAFT)
  ownerUserId     String?
  publishedAt     DateTime?
  reviewDueAt     DateTime?
  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, category])
}

enum VendorCategory {
  HOSTING
  PAYMENTS
  EMAIL_SMS
  AI_ML
  ANALYTICS
  STORAGE
  OTHER
}

enum VendorRiskLevel {
  LOW
  MEDIUM
  HIGH
}

// SOC2 CC9.2 "vendor management" + GDPR Art.28 sub-processor register +
// Data Processing Register in one model — a real sub-processor gets one
// row recording what data flows to them and whether a DPA is on file.
// Replaces compliance.ts's previous hardcoded-manual checkSubProcessorAgreements.
model VendorRecord {
  id              String          @id @default(cuid())
  name            String
  category        VendorCategory
  purpose         String          @db.Text
  dataProcessed   String          @db.Text
  riskLevel       VendorRiskLevel @default(MEDIUM)
  dpaSigned       Boolean         @default(false)
  dpaSignedAt     DateTime?
  dpaReference    String?
  reviewDueAt     DateTime?
  active          Boolean         @default(true)
  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, active])
  @@index([dpaSigned, active])
}

enum AssetType {
  HARDWARE
  SOFTWARE
  CLOUD_SERVICE
  DATA_STORE
  DOCUMENT
  OTHER
}

enum DataClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum AssetStatus {
  ACTIVE
  RETIRED
}

// ISO27001 A.5.9 "inventory of information and other associated assets" —
// real admin-tracked assets (infra components, data stores, key documents),
// each with an owner and a classification.
model AssetRecord {
  id              String             @id @default(cuid())
  name            String
  assetType       AssetType
  description     String             @db.Text
  classification  DataClassification @default(INTERNAL)
  ownerUserId     String?
  location        String?
  status          AssetStatus        @default(ACTIVE)
  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetType, status])
  @@index([classification])
}

enum SoATheme {
  ORGANIZATIONAL
  PEOPLE
  PHYSICAL
  TECHNOLOGICAL
}

enum SoAImplementationStatus {
  NOT_IMPLEMENTED
  PARTIALLY_IMPLEMENTED
  IMPLEMENTED
  NOT_APPLICABLE
}

// ISO27001 Statement of Applicability — for each Annex A control the
// organization decides to scope in/out, a real admin records the control
// id/title THEY enter (this app never fabricates official ISO 27001:2022
// Annex A control text), applicability decision, justification, and
// implementation status.
model StatementOfApplicabilityEntry {
  id                   String                  @id @default(cuid())
  controlId            String                  @unique
  controlTitle         String
  theme                SoATheme
  applicable           Boolean                 @default(true)
  justification        String                  @db.Text
  implementationStatus SoAImplementationStatus @default(NOT_IMPLEMENTED)
  evidenceReference    String?
  reviewedByUserId     String?
  reviewedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([theme, applicable])
}

enum ChangeType {
  FEATURE
  BUGFIX
  INFRASTRUCTURE
  SECURITY
  CONFIGURATION
  EMERGENCY
}

enum ChangeRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ChangeRequestStatus {
  PROPOSED
  APPROVED
  REJECTED
  DEPLOYED
  ROLLED_BACK
}

// SOC2 CC8.1 "change management" — a real approval trail for production
// changes, optionally linked to the real Deployment row it produced.
model ChangeRequest {
  id                String              @id @default(cuid())
  title             String
  description       String              @db.Text
  changeType        ChangeType
  riskLevel         ChangeRiskLevel     @default(LOW)
  status            ChangeRequestStatus @default(PROPOSED)
  rollbackPlan      String?             @db.Text
  requestedByUserId String?
  approvedByUserId  String?
  approvedAt        DateTime?
  deployedAt        DateTime?
  deploymentId      String?

  deployment Deployment? @relation(fields: [deploymentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, riskLevel])
}
