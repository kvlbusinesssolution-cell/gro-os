  isOwnerOrg Boolean @default(false)

  memberships             Membership[]
  invitations             Invitation[]
  careerProfiles          CareerProfile[]
  jobMatches              JobMatch[]
  jobApplications         JobApplication[]
  recruiterCommunications RecruiterCommunication[]
  agentRuns               AgentRun[]
  careerInterviews        CareerInterview[]
  careerFollowUps         CareerFollowUp[]
  workspace               Workspace?
  aiAgents                AIAgentInstance[]
  auditLogs               AuditLog[]

  meetings           Meeting[]
  tasks              Task[]
  decisions          Decision[]
  agentMemories      AgentMemory[]
  agentConversations AgentConversation[]
  notifications      Notification[]
  activities         Activity[]
  dashboards         Dashboard[]
  dashboardTemplates DashboardTemplate[]
  insights           Insight[]

  companies                 Company[]
  clients                   Client[]
  projects                  Project[]
  proposals                 Proposal[]
  documents                 Document[]
  automationRules           AutomationRule[]
  billingAccount            BillingAccount?
  metricSnapshots           MetricSnapshot[]
  marketplaceInterests      MarketplaceInterest[]
  watchlists                Watchlist[]
  savedSearches             SavedSearch[]
  recommendations           Recommendation[]
  websiteScans              WebsiteScan[]
  contacts                  Contact[]
  campaigns                 Campaign[]
  sequences                 Sequence[]
  emailDrafts               EmailDraft[]
  approvals                 Approval[]
  replies                   Reply[]
  outreachMeetings          OutreachMeeting[]
  conversationIntelligence  ConversationIntelligence[]
  revenueAttributions       RevenueAttribution[]
  whatsappConversations     WhatsAppConversation[]
  whatsappTemplates         WhatsAppTemplate[]
  whatsappSendingIdentities WhatsAppSendingIdentity[]
  calls                     Call[]
