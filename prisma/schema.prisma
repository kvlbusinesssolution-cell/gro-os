}

model Company {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  industry       String?
  website        String?
  email          String?
  phone          String?
  address        String?
  employeeCount  Int?
  notes          String?       @db.Text
  source         CompanySource @default(MANUAL)
  status         CompanyStatus @default(PROSPECT)

  // ===== Company Intelligence profile fields (Lead Finder phase) =====
  logo                String?
  description         String?         @db.Text
  headquartersCountry String?
  headquartersState   String?
  headquartersCity    String?
  // Best-effort geocoded via Nominatim (see src/lib/geo/geocode.ts) — null
  // when geocoding hasn't run or failed, never a guessed coordinate.
  latitude            Float?
  longitude           Float?
  // Array of { label, address } — additional office locations beyond HQ.
  locations           Json?
  estimatedRevenue    Float?
  foundedYear         Int?
  technologies        String[]
  products            String[]
  servicesOffered     String[]
  targetCustomers     String?         @db.Text
  // { linkedin?, facebook?, twitter?, instagram? }
  socialLinks         Json?
  googleMapsUrl       String?
  contactFormUrl      String?
  businessType        String?
  remoteHybrid        String?
  publicPrivate       String?
  growthRate          Float?
  fundingStage        String?
  fundingAmount       Float?
  language            String?
  ownerUserId         String?
  priority            MessagePriority @default(NORMAL)

  // ===== Phase 24 (Enterprise Company Data Intelligence) — additive identity
  // fields the spec explicitly asked for. Null until a real source supplies
  // them — never guessed/inferred as a fact. `parentCompanyId` is a plain
  // self-relation (no cycle-prevention beyond app-level checks, matching
  // this schema's existing convention for other nullable self/optional FKs).
  subindustry        String?
  region             String?
  fundingDate        DateTime?
  parentCompanyId    String?
  parentCompany      Company?  @relation("CompanyParent", fields: [parentCompanyId], references: [id], onDelete: SetNull)
  subsidiaries       Company[] @relation("CompanyParent")
  // Registered legal entity name, when it differs from the working/trade
  // name already in `name` (e.g. "Acme Inc." vs "Acme Technologies Pvt
  // Ltd") — null until a real source (registry lookup, manual entry)
  // supplies it.
  legalName          String?
  // Distinct from the generic `growthRate` (revenue/business growth) —
  // specifically headcount trend, e.g. from a LinkedIn employee-count
  // delta. Null, never inferred from a single snapshot.
  employeeGrowthRate Float?
  // A real source-reported range (e.g. "$10M-$50M" bucket), kept separate
  // from the single-point `estimatedRevenue` estimate above — both may be
  // null, both may be set, they're not required to agree.
  revenueMin         Float?
  revenueMax         Float?
  // Alternate/former/trading names a real source has reported for this
  // company (e.g. a rebrand, a DBA name) — used to widen duplicate
  // detection, never auto-populated by guessing string similarity.
  companyAliases     String[]  @default([])

  // Company-merge safety (Phase 24, requirement #4): a merged-away Company
  // row is NEVER deleted (audit/history preservation) — it's flagged here
  // and redirected. See src/lib/business-development/company-merge.ts.
  mergedIntoId String?
  mergedAt     DateTime?
  mergedInto   Company?  @relation("CompanyMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Company[] @relation("CompanyMerge")

  // ===== Discovery-source tracking (Phase 1 AI Business Development System) =====
  // `source` above stays the ORIGINAL discovery source only. These track every
  // re-discovery of this same Company over time, e.g. found first by Lead
  // Finder then re-surfaced by the autonomous discovery job.
  sourceCount      Int      @default(1)
  discoverySources String[] @default([])
  lastDiscoveredAt DateTime @default(now())

  // Phase 8: Partner & Referral Client Acquisition Engine — which
  // ReferralPartner (if any) referred this Company. Null means "no known
  // referral partner", never guessed. This is the real Partner -> Referral
  // attribution mechanism: a Company with a non-null referralPartnerId is
  // this partner's referred company, and every Lead/Deal that traces back to
  // it (via Lead.companyId / Deal.companyId) is attributable to the same
  // partner for the Partner Portal's stats and commission calculation.
  referralPartnerId String?

  // ===== Phase 1 (GrowthOS Data & Enrichment Engine) =====
  // Bare lowercase hostname (no protocol/www/path), computed the same way
  // as dedup.ts's normalizeWebsiteHost — a fast, indexable identity signal
  // distinct from `website` (which keeps whatever the source gave, e.g. a
  // full URL with a path). Null until enrichment/dedup has actually
  // resolved it, never guessed.
  domain                  String?
  // Orchestration-level state for enrichment.ts's enrichCompany() — distinct
  // from the individual CompanyIntelligence/IntentScore/DecisionMaker rows
  // it produces, which already track their own timestamps. This is "did a
  // full enrichment pass run, and how did it go", nothing more.
  enrichmentStatus        EnrichmentStatus @default(NEVER_ENRICHED)
  lastEnrichedAt          DateTime?
  enrichmentFailureReason String?          @db.Text

  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referralPartner   ReferralPartner?       @relation(fields: [referralPartnerId], references: [id], onDelete: SetNull)
  owner             User?                  @relation("CompanyOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  leads             Lead[]
  clients           Client[]
  projects          Project[]
  proposals         Proposal[]
  documents         Document[]
  tasks             Task[]
  leadScore         LeadScore?
  intelligenceRuns  CompanyIntelligence[]
  researchNotes     ResearchNote[]
  timelineEvents    CompanyTimelineEvent[]
  watchlistEntries  WatchlistCompany[]
  recommendations   Recommendation[]
  websiteScans      WebsiteScan[]
  contacts          Contact[]
  deals             Deal[]
  reminders         Reminder[]
  quotations        Quotation[]
  contracts         Contract[]
  invoices          Invoice[]
  businessDocuments BusinessDocument[]
  subscriptions     Subscription[]

  // Autonomous AI Business Development System (Phase 17)
  leadOpportunities        LeadOpportunity[]
  buyerPersonas            BuyerPersona[]
  // Phase 1: raw observed facts + AI interpretations backing intelligence/
  // opportunity output, each traceable to its originating source.
  evidence                 CompanyEvidence[]
  // Phase 3: real, publicly-sourced named decision-makers at this company.
  decisionMakers           DecisionMaker[]
  // Phase 4: deterministic buying-intent score, computed from this
  // company's own CompanyIntelligence signal lists + CompanyEvidence rows.
  intentScore              IntentScore?
  // Phase 2 (Buying Intent Intelligence Engine): append-only score/stage change log.
  intentScoreHistory       IntentScoreHistory[]
  // KVL-only owner rate-negotiation escalation threads for this company.
  rateNegotiations         RateNegotiation[]
  // Phase 6 (AI Conversation Intelligence): append-only per-thread analysis log.
  conversationIntelligence ConversationIntelligence[]
  // Phase 7 (Revenue Attribution Engine).
  revenueAttributions      RevenueAttribution[]
  // Phase 8 (WhatsApp Business Outreach).
  whatsappConversations    WhatsAppConversation[]
  // Phase 10 (AI Voice Sales Engine).
  calls                    Call[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Phase 24 (requirement #18, retry safety): a real DB-level uniqueness
  // guarantee behind findOrCreateCompany — without this, two concurrent
  // discovery calls can both pass the "no existing match" read and both
  // insert a real duplicate Company row for the same company. Postgres
  // treats every NULL domain as distinct from every other NULL (standard
  // SQL NULL semantics), so companies with no known domain are correctly
  // NOT deduped against each other by this constraint — only a genuine,
  // known, shared domain within the same org is rejected. A UNIQUE
  // constraint also serves as the index, so this replaces the plain
  // @@index the previous partial change added.
  @@unique([organizationId, domain])
  @@index([organizationId])
  @@index([referralPartnerId])
  @@index([parentCompanyId])
  @@index([mergedIntoId])
}

