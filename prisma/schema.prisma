  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  CONTRACT_SIGNED
  INVOICE_PAID
  INVOICE_OVERDUE
  // Added for the Workflow Automation Engine (Phase 16) — everything else
  // above is reused as-is by Workflow.triggerType, not duplicated.
  LEAD_UPDATED
  PROJECT_CREATED
  CLIENT_MESSAGE
  MEETING_SCHEDULED
