  partner     Partner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  commissions Commission[]

  createdAt DateTime @default(now())
}

// ============================= Phase 8: Partner & Referral Client Acquisition Engine =============================
//
// IMPORTANT — this is a DELIBERATELY SEPARATE bounded context from the
// `Partner`/`Commission`/`Payout` models above (Phase 18's platform-wide
// SaaS reseller/affiliate program). That existing system: one `Partner` row
// per platform USER (`Partner.userId @unique`, no organizationId at all —
// it is NOT scoped to a tenant), who refers brand-new tenant `Organization`
// signups via a referral code/link, earning `commissionRatePercent` of that
// referred organization's PLATFORM BILLING revenue
// (see src/lib/partners/commissions.ts's generateCommissionForPayment).
//
// This phase's spec ("Partner Types: Freelancers, Digital agencies, SEO
// agencies, Marketing/IT/Business/Technology consultants, Designers" +
// "Referral flow: Partner -> Referral -> Lead -> Qualification ->
// Opportunity -> Deal -> Revenue -> Commission") describes something else
// entirely: a real-world business partner (an agency/freelancer/consultant)
// who refers PROSPECT COMPANIES into ONE SPECIFIC ORGANIZATION's own CRM/
// sales pipeline (Company -> Lead -> Deal, the exact same pipeline Phase
// 1-7's business-development system already populates), earning commission
// on that ORGANIZATION's OWN DEAL REVENUE — not platform subscription
// billing. It is inherently per-organization (`organizationId` below),
// which the existing Partner model structurally cannot be without breaking
// its own semantics. Reusing/renaming the existing Partner model would
// conflate two unrelated relationships (a SaaS affiliate vs. a client
// referral source) under one row shape, which is worse than a second,
// clearly-documented model. Hence: `ReferralPartner`, `PartnerCommission`
// (also deliberately distinctly named from the existing `Commission` model).
//
// Attribution mechanism (the actual "Partner -> Referral -> Lead" link):
// Company.referralPartnerId, set only manually via an explicit picker or by
// the AI Partner Discovery job creating a CANDIDATE partner row — never
// inferred/guessed. Every Lead/Deal under that Company is transitively this
// partner's referral. "Qualification -> Opportunity" is the existing
// Lead/LeadOpportunity pipeline on that same Company; "Deal -> Revenue" is
// the existing Deal (dealStage.name === "Won", the same codebase-wide
// convention used in src/lib/analytics.ts, kvl-sector-discovery-job.ts,
// etc.); "Commission" is the new PartnerCommission row generated when that
// Deal is won (see src/lib/business-development/partner-commission.ts).

enum PartnerType {
  FREELANCER
  DIGITAL_AGENCY
  SEO_AGENCY
  MARKETING_CONSULTANT
  IT_CONSULTANT
  BUSINESS_CONSULTANT
  DESIGNER
  TECHNOLOGY_CONSULTANT
}

enum ReferralPartnerStatus {
  // A real, evidence-backed prospective partner identified by the AI Partner
  // Discovery job (src/lib/business-development/partner-discovery.ts) —
  // "prospective/not yet recruited", the closest real equivalent to the
  // existing Partner model's PENDING state, deliberately renamed since no
  // application/signup happened here (a human recruits a CANDIDATE
  // manually; nothing here auto-recruits or messages them — see the
  // discovery job's own doc comment).
  CANDIDATE
  // A human operator has actually recruited/onboarded this partner — the
  // relationship is live and referrals/commissions are tracked normally.
  ACTIVE
  // Recruited previously but the relationship is no longer active; referral
  // history and past commissions are preserved, nothing new accrues.
  INACTIVE
}

model ReferralPartner {
  id                    String                @id @default(cuid())
  organizationId        String
  name                  String
  type                  PartnerType?
  status                ReferralPartnerStatus @default(CANDIDATE)
  email                 String?
  website               String?
  notes                 String?               @db.Text
  // Real number, a config/policy value the org sets (or the discovery job
  // defaults) — never a fabricated fact about the partner, unlike
  // discoveryEvidence below which must always trace to real search results.
  commissionRatePercent Float                 @default(10)

  // AI Partner Discovery provenance — populated only for a CANDIDATE row the
  // discovery job created; null for a manually-added partner. Mirrors
  // DecisionMaker.source/sourceUrl's non-fabrication discipline: real
  // evidence (a company/agency website, a public profile, a directory
  // listing) or nothing at all.
  discoverySource String?
  discoveryUrl    String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referredCompanies Company[]
  commissions       PartnerCommission[]

  @@index([organizationId])
  @@index([organizationId, status])
}

enum PartnerCommissionStatus {
  PENDING
  PAID
}

model PartnerCommission {
  id        String                  @id @default(cuid())
  partnerId String
  dealId    String
  // Real number computed as Deal.value * partner.commissionRatePercent at
  // the moment the Deal was won — never invented, never recomputed later
  // even if the partner's rate subsequently changes (this row is the
  // historical record of what was actually owed for that specific deal).
  amount    Float
  status    PartnerCommissionStatus @default(PENDING)

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  partner ReferralPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  deal    Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)

  // One commission per (partner, deal) — makes commission generation on
  // deal-won idempotent (a re-fired DEAL_STAGE_CHANGED never double-pays).
  @@unique([partnerId, dealId])
  @@index([partnerId, status])
}

enum LicenseType {
  API
  SEAT
  ENTERPRISE
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model License {
  id               String        @id @default(cuid())
  organizationId   String
  billingAccountId String
  type             LicenseType
  key              String        @unique
  status           LicenseStatus @default(ACTIVE)
  seats            Int?
  issuedAt         DateTime      @default(now())
  expiresAt        DateTime?
  activatedAt      DateTime?
  lastVerifiedAt   DateTime?

  // ---- Phase 19 additions: marketplace-purchase provenance, purely informational ----
  marketplaceListingId String?

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingAccount     BillingAccount      @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  // Reverse side of MarketplaceInstall.licenseId.
  marketplaceInstall MarketplaceInstall?

  createdAt DateTime @default(now())

  @@index([organizationId])
}

model WhiteLabelSettings {
  id                  String  @id @default(cuid())
  organizationId      String  @unique
  brandName           String?
  logoStorageKey      String? @db.Text
  faviconStorageKey   String? @db.Text
  primaryColor        String?
  secondaryColor      String?
  fontFamily          String?
  customLoginHeadline String?
  emailFromName       String?
  emailFromAddress    String?
  pdfFooterText       String?
  // Free-form overrides for specific email/notification templates this org
  // has customized, keyed by template name — a full per-template model
  // would be premature normalization before more than a couple of real
  // templates need it.
  templateOverrides   Json?
  enabled             Boolean @default(false)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domains      CustomDomain[]

