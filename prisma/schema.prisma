// Global catalog — not per-organization. Seeded with genuine roadmap items,
// each honestly marked AVAILABLE or COMING_SOON; no fake "installed" state.
// Phase 19 extends this in place into a real installable catalog entry —
// every new field is nullable/defaulted so the original 8 rows need zero
// backfill. `AVAILABLE`/`PUBLISHED` are treated as equivalent "installable"
// states by every reader.
model MarketplaceListing {
  id            String                   @id @default(cuid())
  name          String
  description   String                   @db.Text
  category      MarketplaceCategory
  status        MarketplaceListingStatus @default(COMING_SOON)
  icon          String?
  interestCount Int                      @default(0)

  // ---- Phase 19 additions ----
  slug               String?                 @unique
  tagline            String?
  // Null = platform-authored listing (the original 8 rows, plus every
  // Workflow/Proposal/Dashboard/Knowledge/Integration listing that just
  // wraps an existing catalog row rather than a 3rd-party submission).
  publisherId        String?
  // Shape documented + zod-validated per MarketplaceCategory in
  // src/lib/marketplace/manifest-schema.ts — describes exactly what
  // installing this listing creates. Null on legacy rows with nothing
  // installable yet.
  manifest           Json?
  currentVersionId   String?
  pricingModel       MarketplacePricingModel @default(FREE)
  priceCents         Int?
  currency           String?
  // Reuses the existing Plan.interval enum rather than declaring a new one.
  billingInterval    BillingIntervalUnit?
  // Publisher revenue-share cut for this listing; null = platform default rate.
  platformFeePercent Float?
  // SUBSCRIPTION-priced listings only — { STRIPE?: string, RAZORPAY?: string,
  // PADDLE?: string } real gateway-side recurring price/plan/variant ids,
  // same shape/precedent as Plan.gatewayPriceIds. A provider missing here is
  // honestly unavailable for this listing's subscription checkout, never
  // fabricated. ONE_TIME-priced listings don't need this — checkout.ts
  // creates an ad-hoc inline price at purchase time instead.
  gatewayPriceIds    Json?
  industryTags       String[]                @default([])
  companySizeTags    String[]                @default([])
  installCount       Int                     @default(0)
  ratingAverage      Float                   @default(0)
  ratingCount        Int                     @default(0)
  isVerified         Boolean                 @default(false)

  publisher      MarketplacePublisher?   @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  currentVersion MarketplaceVersion?     @relation("MarketplaceListingCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       MarketplaceVersion[]    @relation("MarketplaceListingVersions")
  installs       MarketplaceInstall[]
  reviews        MarketplaceReview[]
  orders         MarketplaceOrder[]
  dependents     MarketplaceDependency[] @relation("MarketplaceDependencyTarget")
  interests      MarketplaceInterest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([category, status])
  @@index([publisherId])
}

model MarketplaceInterest {
  id             String @id @default(cuid())
  listingId      String
  organizationId String
  userId         String

  listing      MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User               @relation("MarketplaceInterestUser", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([listingId, organizationId])
}

enum MarketplaceVersionStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
  YANKED
}

// Immutable once PUBLISHED — an org's MarketplaceInstall.versionId always
// resolves to one exact, frozen manifest, so "rollback" is just repointing
// an install at a prior row here and re-running the install engine, never a
// diff/undo operation.
model MarketplaceVersion {
  id              String                   @id @default(cuid())
  listingId       String
  version         String // semver, e.g. "1.2.0"
  manifest        Json // frozen copy of the listing's manifest shape at publish time
  changelog       String?                  @db.Text
  status          MarketplaceVersionStatus @default(DRAFT)
  publishedAt     DateTime?
  createdByUserId String?

  listing           MarketplaceListing      @relation("MarketplaceListingVersions", fields: [listingId], references: [id], onDelete: Cascade)
  currentForListing MarketplaceListing[]    @relation("MarketplaceListingCurrentVersion")
  createdByUser     User?                   @relation("MarketplaceVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  dependencies      MarketplaceDependency[]
  installs          MarketplaceInstall[]
  orders            MarketplaceOrder[]

  createdAt DateTime @default(now())

  @@unique([listingId, version])
  @@index([listingId, status])
}

// versionId REQUIRES dependsOnListingId to be ACTIVE for the installing org
// (optionally >= minVersion) before install-engine.ts dispatches — checked
// at both submit time (for a paid checkout, fail fast before charging) and
// install time.
model MarketplaceDependency {
  id                 String  @id @default(cuid())
  versionId          String
  dependsOnListingId String
  minVersion         String?
  optional           Boolean @default(false)

  version          MarketplaceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  dependsOnListing MarketplaceListing @relation("MarketplaceDependencyTarget", fields: [dependsOnListingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([versionId])
  @@index([dependsOnListingId])
}

enum MarketplaceInstallStatus {
  ACTIVE
  UNINSTALLED
  FAILED
  ROLLED_BACK
}

// Central per-org entitlement record, generic across every pack kind — the
// single source of truth for "what has this org installed." For
// pricingModel === SUBSCRIPTION listings this row IS the subscription
// tracker too (same field vocabulary as BillingAccount, kept per-install
// rather than per-org since one org can hold many independent marketplace
// subscriptions).
model MarketplaceInstall {
  id                String                   @id @default(cuid())
  organizationId    String
  listingId         String
  versionId         String
  installedByUserId String
  status            MarketplaceInstallStatus @default(ACTIVE)
  // Itemized record of every row this install created, keyed by the
  // existing model it touched, e.g. { agentInstanceIds: string[],
  // workflowIds: string[], documentTemplateIds: string[],
  // dashboardTemplateIds: string[], knowledgeArticleIds: string[],
  // promptTemplateIds: string[], integrationConnectionId?: string,
  // featureFlagOverrideId?: string }. Uninstall/rollback reads this to know
  // exactly what to deactivate — never re-derives it from the manifest.
  createdRowsLog    Json

  // Recurring-billing fields — only set when pricingModel === SUBSCRIPTION,
  // synced by the marketplace-subscription-renewal-sweep job.
  gatewayProvider       PaymentGatewayProvider?
  gatewaySubscriptionId String?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean                 @default(false)

  licenseId String? @unique // reuses the existing License model

  installedAt         DateTime  @default(now())
  uninstalledAt       DateTime?
  uninstalledByUserId String?
  lastError           String?   @db.Text

  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listing           MarketplaceListing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  version           MarketplaceVersion        @relation(fields: [versionId], references: [id], onDelete: Restrict)
  installedByUser   User                      @relation("MarketplaceInstalledBy", fields: [installedByUserId], references: [id], onDelete: Restrict)
  uninstalledByUser User?                     @relation("MarketplaceUninstalledBy", fields: [uninstalledByUserId], references: [id], onDelete: SetNull)
  license           License?                  @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  review            MarketplaceReview?
  order             MarketplaceOrder?
  events            MarketplaceInstallEvent[]
  commissions       Commission[]

  createdAt DateTime @default(now())

  @@unique([organizationId, listingId])
  @@index([organizationId, status])
  @@index([listingId])
}

enum MarketplaceInstallEventType {
  INSTALLED
  UPGRADED
  UNINSTALLED
  ROLLED_BACK
  FAILED
}

// Append-only history log, distinct from MarketplaceInstall's current-state
// row — powers install-analytics and audit review without mutating the
// entitlement record itself.
model MarketplaceInstallEvent {
  id           String                      @id @default(cuid())
  installId    String
  eventType    MarketplaceInstallEventType
  fromVersion  String?
  toVersion    String?
  errorMessage String?                     @db.Text

  install MarketplaceInstall @relation(fields: [installId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([installId, createdAt])
}

model MarketplaceReview {
  id                   String    @id @default(cuid())
  listingId            String
  organizationId       String
  userId               String
  // Ties the review to a REAL install — this IS the "verified install"
  // badge, not a spoofable boolean.
  installId            String    @unique
  rating               Int // 1-5, zod-validated at the action layer
  title                String?
  body                 String?   @db.Text
  publisherResponse    String?   @db.Text
  publisherRespondedAt DateTime?

  listing      MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User               @relation("MarketplaceReviewAuthor", fields: [userId], references: [id], onDelete: Cascade)
  install      MarketplaceInstall @relation(fields: [installId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, organizationId])
  @@index([listingId])
}

enum MarketplacePublisherStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

// Wraps (not duplicates) the existing Partner/Commission/Payout reseller
// machinery — a MarketplacePublisher's earnings flow through the exact same
// Commission/Payout rows a referral Partner's do, differentiated only by
// Commission.sourceType.
model MarketplacePublisher {
  id             String                     @id @default(cuid())
  userId         String                     @unique
  partnerId      String?                    @unique
  displayName    String
  companyName    String?
  contactEmail   String
  website        String?
  status         MarketplacePublisherStatus @default(PENDING)
  bio            String?                    @db.Text
  logoStorageKey String?                    @db.Text

  user     User                 @relation("MarketplacePublisherUser", fields: [userId], references: [id], onDelete: Cascade)
  partner  Partner?             @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  listings MarketplaceListing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum MarketplaceOrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELED
}

// The money row for a marketplace purchase, deliberately thin — the actual
// charge/refund state lives on a real, reused PlatformInvoice/PlatformPayment
// under the buyer org's existing BillingAccount, so refundPlatformPayment()
// and every existing invoice UI keep working completely unmodified.
model MarketplaceOrder {
  id             String                  @id @default(cuid())
  organizationId String
  listingId      String
  versionId      String
  buyerUserId    String
  pricingModel   MarketplacePricingModel // snapshot at purchase time
  amountCents    Int
  currency       String
  status         MarketplaceOrderStatus  @default(PENDING)

  gatewayProvider          PaymentGatewayProvider?
  gatewayCheckoutSessionId String?

  platformInvoiceId String? @unique // reuse: real invoice/payment/refund lives here
  installId         String? @unique // set once the install engine completes post-payment
  commissionId      String? @unique // reuse: publisher payout lives here

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listing         MarketplaceListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  version         MarketplaceVersion  @relation(fields: [versionId], references: [id], onDelete: Restrict)
  buyerUser       User                @relation("MarketplaceOrderBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict)
  install         MarketplaceInstall? @relation(fields: [installId], references: [id], onDelete: SetNull)
  commission      Commission?         @relation(fields: [commissionId], references: [id], onDelete: SetNull)
  platformInvoice PlatformInvoice?    @relation(fields: [platformInvoiceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([listingId])
}

// Daily snapshot of headline metrics — nothing else in the schema stores
// history, so Analytics trend charts would otherwise have no historical
// basis. Populated lazily (upserted for "today" on Analytics/Dashboard load)
// rather than via a cron job, since no job runner exists.
model MetricSnapshot {
  id                 String   @id @default(cuid())
  organizationId     String
  date               DateTime @db.Date
  companyHealthScore Int
  revenueMonthToDate Float
  leadsCount         Int
  dealsCount         Int
  pipelineValue      Float
  // Real recurring-revenue figures — 0 (not null) when no Subscription rows
  // exist yet, same "real zero, never fabricated" discipline as every other
  // field here. Computed by src/lib/revenue/subscriptions.ts.
  mrr                Float    @default(0)
  arr                Float    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([organizationId, date])
}

// ============================= Phase 6: Lead Finder & Company Intelligence =============================

enum LeadScoreBand {
  HOT
  WARM
  COLD
}

// Latest score only (not history) — re-scoring upserts this row. All 9
// sub-scores and the overall are deterministic, computed from real stored
// fields (see src/lib/lead-scoring.ts) — never a per-company AI call.
model LeadScore {
  id                   String        @id @default(cuid())
  companyId            String        @unique
  industryMatchScore   Int
  companySizeScore     Int
  growthScore          Int
  technologyFitScore   Int
  opportunitySizeScore Int
  budgetPotentialScore Int
  locationScore        Int
  digitalMaturityScore Int
  automationNeedScore  Int
  overallScore         Int
  band                 LeadScoreBand
  scoredAt             DateTime      @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// Phase 4: "How strong is the evidence this company may need something NOW?"
// — deliberately SEPARATE from LeadScore (relevance/fit, above) and from
// LeadOpportunity.opportunityScore (below). Purely deterministic, computed
// from this company's own already-AI-generated CompanyIntelligence signal
// lists (growthSignals/hiringSignals/expansionIndicators) plus real
// CompanyEvidence RAW_FACT problem facts — never a fresh AI call, and never
// fabricated: "no signal should be treated as intent without evidence" (see
// src/lib/business-development/intent-scoring.ts). Latest score only (not
// history) — re-scoring upserts this row, same discipline as LeadScore.
enum IntentBand {
  HIGH
  MEDIUM
  LOW
  NONE
}

model IntentScore {
  id        String     @id @default(cuid())
  companyId String     @unique
  score     Int
  band      IntentBand
  // Structured breakdown: Array<{ signal, source, detail, points }> — the
  // real "why" behind the score, never a black box. See IntentSignal in
  // src/lib/business-development/intent-scoring.ts for the shape.
  signals   Json
  // One human-readable paragraph summarizing the actual signals that
  // contributed — honest and specific, never generic boilerplate.
  reasoning String     @db.Text
  scoredAt  DateTime   @default(now())

  // ===== Phase 2 (Buying Intent Intelligence Engine) =====
  // Deterministic, rule-based classification (see classifyBuyingStage in
  // intent-scoring.ts) from real CRM/outreach state — Deal stage, Proposal
  // status, Reply intent, meeting activity — NEVER derived from the score
  // number alone ("do not classify a company as DECISION merely because its
  // intent score is high"). Defaults exist only so this migration is safe
  // against IntentScore rows that predate Phase 2 — every fresh
  // computeIntentScore call always sets a real, reasoned value.
  buyingStage           BuyingStage @default(UNKNOWN)
  buyingStageReasoning  String      @default("Not yet classified.") @db.Text
  buyingStageConfidence Float       @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// Phase 2 (Buying Intent Intelligence Engine) — the buying-journey stage
// taxonomy the spec asked for, deliberately distinct from IntentBand (signal
// STRENGTH: HIGH/MEDIUM/LOW/NONE) and from the workspace-configurable
// PipelineStage/DealStage (free-text, admin-defined pipeline steps) — no
// existing enum already covered this concept (confirmed before adding it).
enum BuyingStage {
  UNKNOWN
  TARGET
  AWARENESS
  CONSIDERATION
  DECISION
  NEGOTIATION
  CUSTOMER
  LOST
}

// Phase 2 (Buying Intent Intelligence Engine) — append-only change log,
// mirroring PredictionCalibration's established "one row per computation,
// never upserted" pattern (see prisma/schema.prisma's own doc comment on
// that model) rather than inventing a new history convention. A row is only
// ever written when computeIntentScore (intent-scoring.ts) finds the score,
// band, OR stage genuinely changed since the current IntentScore row —
// never on a no-op recompute, so this never grows into log noise. History
// rows are never updated or deleted.
model IntentScoreHistory {
  id             String       @id @default(cuid())
  organizationId String
  companyId      String
  previousScore  Int?
  newScore       Int
  scoreChange    Int
  previousBand   IntentBand?
  newBand        IntentBand
  previousStage  BuyingStage?
  newStage       BuyingStage
  reason         String       @db.Text
  triggerSignal  String?
  calculatedAt   DateTime     @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([companyId, calculatedAt])
}

// One row per AI Company Intelligence report generation — kept as a log
// (not upserted) so past reports remain visible; the UI shows the latest.
// Every field here is real Claude output, always rendered labeled
// "AI-generated" in the UI, never presented as verified fact.
model CompanyIntelligence {
  id                     String   @id @default(cuid())
  companyId              String
  businessSummary        String   @db.Text
  productsSummary        String?  @db.Text
  servicesSummary        String?  @db.Text
  techStackSummary       String?  @db.Text
  digitalPresenceSummary String?  @db.Text
  seoOverview            String?  @db.Text
  performanceOverview    String?  @db.Text
  growthSignals          String[]
  hiringSignals          String[]
  expansionIndicators    String[]
  businessOpportunities  String[]
  estimatedSoftwareNeeds String[]
  potentialPainPoints    String[]
  recommendedSolution    String?  @db.Text
  estimatedProjectValue  Float?
  confidenceScore        Float
  generatedByAgentId     String?

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  generatedByAgent AIAgentInstance? @relation(fields: [generatedByAgentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

enum ResearchTopic {
  COMPETITORS
  TECHNOLOGY
  BUSINESS_MODEL
  EXPANSION
  NEWS
  HIRING_TRENDS
  PUBLIC_SIGNALS
  GENERAL
}

// AI Research Engine's on-demand, topic-scoped structured research notes —
// distinct from the broader CompanyIntelligence report above.
model ResearchNote {
  id                 String        @id @default(cuid())
  companyId          String
  topic              ResearchTopic
  content            String        @db.Text
  generatedByAgentId String?

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  generatedByAgent AIAgentInstance? @relation(fields: [generatedByAgentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

enum EvidenceKind {
  RAW_FACT
  AI_INTERPRETATION
}

enum EvidenceSource {
  WEBSITE_SCAN
  WEB_SEARCH
  MANUAL
  CSV_IMPORT
  COMPANY_INTELLIGENCE
}

// Phase 1 AI Business Development System — the evidentiary backbone behind
// CompanyIntelligence/LeadOpportunity output. `kind` explicitly separates a
// raw observed fact (e.g. "Mobile performance score: 42/100", straight off a
// WebsiteScan) from an AI interpretation of that fact (e.g. "Potential mobile
// conversion improvement opportunity"), so downstream UI never presents an
// inference as an observed fact.
model CompanyEvidence {
  id                 String                     @id @default(cuid())
  companyId          String
  kind               EvidenceKind
  fact               String                     @db.Text
  source             EvidenceSource
  sourceUrl          String?
  confidence         Float
  discoveredAt       DateTime                   @default(now())
  generatedByAgentId String?
  // Phase 24 (requirement #5, evidence per field): which specific Company
  // scalar field this evidence supports (e.g. "employeeCount",
  // "estimatedRevenue") — lets a specific field's evidence trail actually
  // be queried, not just "some evidence exists for this company somewhere".
  // Null on every row written before this column existed — deliberately
  // NOT backfilled (an honest unknown, never a guess) — and null is also
  // valid going forward for evidence that doesn't map to one scalar field.
  fieldName          String?
  // Phase 24 (requirement #10, verification status): has a real human
  // explicitly confirmed this fact? Only a real user action can move this
  // to USER_VERIFIED — never set by AI output or a background job.
  verificationStatus EvidenceVerificationStatus @default(UNVERIFIED)

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  generatedByAgent AIAgentInstance? @relation(fields: [generatedByAgentId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, fieldName])
}

enum EvidenceVerificationStatus {
  UNVERIFIED
  USER_VERIFIED
}

// Phase 3: Decision Maker Intelligence — the most relevant PUBLICLY
// AVAILABLE business contact(s) at a discovered/qualified Company (real named
// individuals, never a guessed/invented identity). Distinct from
// `BuyerPersona` (an AI-inferred probable-role archetype with no real name,
// grounded only in CompanyIntelligence data): a DecisionMaker row is only
// ever written when a real web-search-grounded AI pass found genuine
// evidence (a company team/about page, a public professional profile, a
// press mention) tying a real name to a role at this specific company.
// `source` is a plain-language description of where it came from (e.g.
// "Company website /about page"); `sourceUrl`, when known, is the actual
// link. `confidence` is the AI's own honest self-assessment (0.0-1.0) of how
// certain this real-name+role pairing is — never a fixed/fabricated number.
enum DecisionMakerRole {
  FOUNDER
  CO_FOUNDER
  CEO
  DIRECTOR
  CTO
  COO
  MARKETING_HEAD
  SALES_HEAD
  BUSINESS_DEVELOPMENT_HEAD
  IT_HEAD
  PRODUCT_HEAD
}

model DecisionMaker {
  id                 String            @id @default(cuid())
  companyId          String
  name               String
  role               DecisionMakerRole
  source             String
  sourceUrl          String?
  confidence         Float
  verifiedAt         DateTime          @default(now())
  generatedByAgentId String?
  createdAt          DateTime          @default(now())

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  generatedByAgent AIAgentInstance? @relation(fields: [generatedByAgentId], references: [id], onDelete: SetNull)
  // Phase 1 (GrowthOS Data & Enrichment Engine): real Contacts confidently
  // matched to this named public decision-maker — see Contact.decisionMakerId.
  contacts         Contact[]

  @@index([companyId])
}

// ===== Phase 1 (GrowthOS Data & Enrichment Engine) =====
// Orchestration state for enrichment.ts's enrichCompany()/enrichContact() —
// distinct from CompanyIntelligence/CompanyEvidence/IntentScore/
// DecisionMaker, which each already track their own freshness. This tracks
// only "did an enrichment PASS run, across those existing systems, and how
// did it go" — never a replacement for any of them.
enum EnrichmentStatus {
  NEVER_ENRICHED
  QUEUED
  RUNNING
  PARTIAL
  COMPLETED
  FAILED
  STALE
}

enum EnrichmentEntityType {
  COMPANY
  CONTACT
}

enum EnrichmentTrigger {
  MANUAL
  SCHEDULED
  BATCH
}

enum EnrichmentRunStatus {
  QUEUED
  RUNNING
  PARTIAL
  COMPLETED
  FAILED
  RETRYING
}

// One row per enrichment attempt (manual button, batch action, or the
// scheduled stale-reenrichment job) — a real, queryable history distinct
// from CompanyEvidence (which logs individual FACTS, not enrichment RUNS).
// `organizationId`/`triggeredByUserId` are deliberately plain FK-shaped
// strings with no Prisma relation object, matching AuditLog's existing
// precedent for a log-type model — this is a history log, not a relation
// graph node, and doesn't need reverse-navigable relations on
// Organization/User for anything this phase requires.
model EnrichmentRun {
  id                String               @id @default(cuid())
  organizationId    String
  entityType        EnrichmentEntityType
  entityId          String
  companyId         String?
  triggeredBy       EnrichmentTrigger
  triggeredByUserId String?
  status            EnrichmentRunStatus  @default(QUEUED)
  // Which underlying steps (e.g. "COMPANY_INTELLIGENCE", "INTENT_SCORE",
  // "DECISION_MAKERS", "OPPORTUNITIES") actually completed vs failed this
  // run — the real basis for COMPLETED vs PARTIAL vs FAILED below, never
  // just "the function didn't throw".
  stepsCompleted    String[]             @default([])
  stepsFailed       String[]             @default([])
  factsFound        Int                  @default(0)
  error             String?              @db.Text
  retryCount        Int                  @default(0)
  startedAt         DateTime             @default(now())
  finishedAt        DateTime?

  // ===== Phase 3 (AI Company Research Engine) =====
  // Reuses this EXACT row as the "research run" history record the spec
  // asked for (QUEUED/RUNNING/PARTIAL/COMPLETED/FAILED/STALE — Company.
  // enrichmentStatus already has all 6 values; a second parallel research-
  // run model would duplicate this one). Both fields are honest-best-effort,
  // never fabricated: `confidence` is copied from the real
  // CompanyIntelligence.confidenceScore produced this run (null if that
  // step didn't run/failed); `aiProvider` is backfilled from the most
  // recent real AIUsageEvent in this org during [startedAt, finishedAt]
  // (null if none found — never guessed).
  confidence Float?
  aiProvider String?

  @@index([organizationId])
  @@index([companyId])
  @@index([entityType, entityId])
  @@index([status])
}

enum CompanyTimelineEventType {
  CREATED
  FUNDING
  WEBSITE_UPDATE
  ANNOUNCEMENT
  HIRING
  EXPANSION
  RESEARCH_NOTE
  INTERNAL_ACTIVITY
}

enum TimelineEventSource {
  SYSTEM
  AI_RESEARCH
  MANUAL
}

// Real per-company event log — the explicit verified (SYSTEM) vs AI-inferred
// (AI_RESEARCH) vs user-entered (MANUAL) distinction the brief requires.
model CompanyTimelineEvent {
  id          String                   @id @default(cuid())
  companyId   String
  type        CompanyTimelineEventType
  title       String
  description String?                  @db.Text
  source      TimelineEventSource
  occurredAt  DateTime

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([companyId, occurredAt])
}

model Watchlist {
  id              String  @id @default(cuid())
  organizationId  String
  name            String
  description     String? @db.Text
  createdByUserId String
  icon            String?

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser User               @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  companies     WatchlistCompany[]

  createdAt DateTime @default(now())

  @@index([organizationId])
}

model WatchlistCompany {
  id            String @id @default(cuid())
  watchlistId   String
  companyId     String
  addedByUserId String

  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  addedByUser User      @relation(fields: [addedByUserId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@unique([watchlistId, companyId])
}

model SavedSearch {
  id              String    @id @default(cuid())
  organizationId  String
  userId          String
  name            String
  // The full discovery filter object (see discoveryFiltersSchema) — re-run
  // verbatim by runSavedSearch.
  filters         Json
  notifyOnMatch   Boolean   @default(false)
  lastRunAt       DateTime?
  lastResultCount Int?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId, userId])
}

enum RecommendationType {
  BEST_OPPORTUNITY
  HIGHEST_VALUE_LEAD
  MOST_ACTIVE_COMPANY
  FASTEST_GROWING_COMPANY
  RECOMMENDED_INDUSTRY
  SUGGESTED_NEXT_STEP
  BETTER_PRICING
  ADDITIONAL_SERVICES
  UPSELL_OPPORTUNITY
  CROSS_SELL_OPPORTUNITY
  BETTER_TIMELINE
  RISK_WARNING
  SCOPE_IMPROVEMENT
  PROPOSAL_QUALITY_IMPROVEMENT
  COMPETITIVE_ADVANTAGE
  // Added for the AI Delivery Board (Phase 5) — a deliberate catch-all for
  // delivery/QA/DevOps concerns, mirroring how SCOPE_IMPROVEMENT/
  // PROPOSAL_QUALITY_IMPROVEMENT were added narrowly for the Review Board.
  DELIVERY_RECOMMENDATION
}

// Same shape as Insight, deliberately kept separate — scoped specifically to
// company/lead intelligence rather than org-wide health. Also reused by the
// AI Proposal Review Board: each agent's structured recommendations[] are
// flattened into real rows here after a review round, linked via
// relatedMeetingId plus whichever doc-kind FK applies.
model Recommendation {
  id                 String             @id @default(cuid())
  organizationId     String
  type               RecommendationType
  title              String
  description        String             @db.Text
  relatedCompanyId   String?
  relatedProposalId  String?
  relatedQuotationId String?
  relatedContractId  String?
  relatedInvoiceId   String?
  relatedMeetingId   String?
  relatedProjectId   String?

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  relatedCompany   Company?     @relation(fields: [relatedCompanyId], references: [id], onDelete: SetNull)
  relatedProposal  Proposal?    @relation(fields: [relatedProposalId], references: [id], onDelete: SetNull)
  relatedQuotation Quotation?   @relation(fields: [relatedQuotationId], references: [id], onDelete: SetNull)
  relatedContract  Contract?    @relation(fields: [relatedContractId], references: [id], onDelete: SetNull)
  relatedInvoice   Invoice?     @relation(fields: [relatedInvoiceId], references: [id], onDelete: SetNull)
  relatedMeeting   Meeting?     @relation(fields: [relatedMeetingId], references: [id], onDelete: SetNull)
  relatedProject   Project?     @relation(fields: [relatedProjectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
