  decisionId String
  agentId    String
  vote       VoteChoice
  reasoning  String     @db.Text

  decision Decision        @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  agent    AIAgentInstance @relation(fields: [agentId], references: [id], onDelete: Cascade)

