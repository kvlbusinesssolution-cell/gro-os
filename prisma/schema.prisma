enum SignatureProvider {
  MANUAL
  DOCUSIGN
  ADOBE_SIGN
  DROPBOX_SIGN
}

enum SignatureStatus {
  PENDING
  SIGNED
  DECLINED
  EXPIRED
}

// Digital-signature-ready architecture: MANUAL is fully implemented (a
// public token-based signing page records signerName/typedSignature/IP and
// flips the parent document to SIGNED). DOCUSIGN/ADOBE_SIGN/DROPBOX_SIGN
// are modeled so a future phase can wire in a real vendor integration
// without a schema change — no real API calls are made to any of them
// today (no vendor credentials exist in this environment).
model Signature {
  id                 String            @id @default(cuid())
  organizationId     String
  docKind            DocumentKind
  docId              String
  signerName         String
  signerEmail        String
  provider           SignatureProvider @default(MANUAL)
  status             SignatureStatus   @default(PENDING)
  signatureToken     String            @unique
  typedSignature     String?
  signedAt           DateTime?
  ipAddress          String?
  requestedByUserId  String?
  // Third-party envelope id (DocuSign envelopeId, Adobe Sign agreementId,
  // Dropbox Sign signature_request_id) — set only once a real envelope is
  // created via the Integration Layer (src/lib/integrations/*). Null for
  // MANUAL signatures. The webhook receivers under src/app/api/webhooks/
  // look a Signature up by this field to mark it SIGNED on a real
  // provider-pushed event, never by polling/guessing.
  providerEnvelopeId String?

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedByUser User?        @relation("SignatureRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([provider, providerEnvelopeId])
  @@index([organizationId])
  @@index([docKind, docId])
}

// ===== Phase 17: Enterprise Knowledge Base / AI Long-Term Memory / RAG Engine =====
// KnowledgeArticleKind/Status/visibility are additive to the pre-existing
// flat KnowledgeArticle (createdAt/updatedAt/tags/knowledgeBaseId unchanged,
// every existing row is valid under the new defaults: kind ARTICLE, status
// PUBLISHED — the old model had no draft concept, so treating pre-existing
// rows as already-published is the only honest default). `tags String[]`
// stays as the simple free-text tag column existing UI already reads/writes
// (src/app/dashboard/knowledge-base/_components/article-form.tsx); the new
// `tagEntities`/KnowledgeTag relation below is an additional, real
// tag-as-entity system (autocomplete, per-tag article counts, tag pages) —
// both coexist, neither replaces the other.
enum KnowledgeArticleKind {
  ARTICLE
  FAQ
  POLICY
  PROCEDURE
  PLAYBOOK
  TEMPLATE
  MEETING_NOTES
  SOP
  TECHNICAL_DOC
  SALES_DOC
  HR_DOC
  FINANCE_DOC
}

enum KnowledgeArticleStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

// PRIVATE: only createdByUserId can read/edit. ORG: every active member of
// the organization. There is no Department model anywhere else in this
// schema, so a DEPARTMENT visibility tier isn't backed by a real table yet —
// left out rather than faked; ORG is the honest ceiling today.
enum KnowledgeArticleVisibility {
  PRIVATE
  ORG
}

model KnowledgeArticle {
  id              String   @id @default(cuid())
  knowledgeBaseId String
  title           String
  content         String   @db.Text
  tags            String[]
  createdByUserId String?

  categoryId String?
  kind       KnowledgeArticleKind       @default(ARTICLE)
  status     KnowledgeArticleStatus     @default(PUBLISHED)
  visibility KnowledgeArticleVisibility @default(ORG)

  reviewedByUserId String?
  reviewedAt       DateTime?

  knowledgeBase KnowledgeBase             @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  createdByUser User?                     @relation("ArticleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  category      KnowledgeCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tagEntities   KnowledgeTag[]            @relation("ArticleTags")
  versions      KnowledgeArticleVersion[]
  attachments   KnowledgeAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([knowledgeBaseId])
  @@index([categoryId])
}

model KnowledgeCategory {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  parentId       String?

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       KnowledgeCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     KnowledgeCategory[] @relation("CategoryHierarchy")
  articles     KnowledgeArticle[]

  createdAt DateTime @default(now())

  @@unique([organizationId, slug])
  @@index([organizationId, parentId])
}

model KnowledgeTag {
  id             String @id @default(cuid())
  organizationId String
  name           String
  slug           String

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  articles     KnowledgeArticle[] @relation("ArticleTags")

  createdAt DateTime @default(now())

  @@unique([organizationId, slug])
  @@index([organizationId])
}

// Full-content snapshot taken on every real edit (not a diff store) — same
// "keep the whole prior version" simplicity as DocumentVersion elsewhere in
// this schema, not a byte-diff engine.
model KnowledgeArticleVersion {
  id             String  @id @default(cuid())
  articleId      String
  title          String
  content        String  @db.Text
  editedByUserId String?

  article      KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  editedByUser User?            @relation("KnowledgeArticleVersionEditor", fields: [editedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([articleId])
}

model KnowledgeAttachment {
  id               String  @id @default(cuid())
  articleId        String
  filename         String
  storageKey       String  @db.Text
  mimeType         String
  sizeBytes        Int
  uploadedByUserId String?

  article        KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  uploadedByUser User?            @relation("KnowledgeAttachmentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([articleId])
}

// ===== RAG Engine: document ingestion, chunking, embeddings =====

enum IngestedDocumentSourceKind {
  UPLOAD
  KNOWLEDGE_ARTICLE
  DEAL
  PROJECT
  MEETING
  PROPOSAL
}

enum IngestedDocumentStatus {
  PENDING
  PARSING
  CHUNKING
  EMBEDDING
  READY
  FAILED
}

// One row per real ingested source (an uploaded file, or a pointer at an
// existing KnowledgeArticle/Deal/Project/Meeting/Proposal this org already
// has) — DocumentChunk rows are its real, persisted chunks; nothing here is
// a cache that can be silently dropped, since Embedding rows reference
// DocumentChunk.id directly.
model IngestedDocument {
  id               String                     @id @default(cuid())
  organizationId   String
  title            String
  sourceKind       IngestedDocumentSourceKind
  sourceId         String?
  originalFilename String?
  mimeType         String?
  storageKey       String?                    @db.Text
  status           IngestedDocumentStatus     @default(PENDING)
  error            String?                    @db.Text
  uploadedByUserId String?

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedByUser User?           @relation("IngestedDocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  chunks         DocumentChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
}

model DocumentChunk {
  id                 String @id @default(cuid())
  ingestedDocumentId String
  organizationId     String
  chunkIndex         Int
  content            String @db.Text
  tokenCount         Int?

  ingestedDocument IngestedDocument @relation(fields: [ingestedDocumentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([ingestedDocumentId])
  @@index([organizationId])
}

enum EmbeddingProvider {
  OPENAI
  VOYAGE
  COHERE
  BGE
  JINA
}

enum EmbeddingSourceType {
  KNOWLEDGE_ARTICLE
  AGENT_MEMORY
  DOCUMENT_CHUNK
}

// vector is stored as a plain Float[] (a real, always-populated Postgres
// array column) rather than an Unsupported("vector(n)") pgvector column,
// because the `vector` Postgres extension is not installed in every
// deployment target — this column always works with zero extra
// infrastructure. src/lib/rag/vector-store.ts detects at runtime whether
// pgvector is actually available (`SELECT 1 FROM pg_extension WHERE
// extname='vector'`) and, if so, ALSO maintains a native
// `document_chunk_embedding_vector`-style side table (see
// prisma/optional-pgvector-upgrade.sql) for fast ANN search — this Float[]
// column is the one column every retrieval path can always fall back to,
// so it is never optional and never left stale.
model Embedding {
  id             String              @id @default(cuid())
  organizationId String
  sourceType     EmbeddingSourceType
  sourceId       String
  provider       EmbeddingProvider
  model          String
  dimensions     Int
  vector         Float[]

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([sourceType, sourceId, provider])
  @@index([organizationId, sourceType])
}

// ===== Knowledge Graph =====

enum GraphEntityType {
  CLIENT
  COMPANY
  PROJECT
  EMPLOYEE
  MEETING
  TASK
  DOCUMENT
  EMAIL
  DEAL
  AI_DECISION
  KNOWLEDGE_ARTICLE
}

model KnowledgeGraphNode {
  id             String          @id @default(cuid())
  organizationId String
  entityType     GraphEntityType
  entityId       String
  label          String
  metadata       Json?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outgoing     Relationship[] @relation("FromNode")
  incoming     Relationship[] @relation("ToNode")

  createdAt DateTime @default(now())

  @@unique([organizationId, entityType, entityId])
  @@index([organizationId, entityType])
}

enum RelationshipType {
  WORKS_ON
  OWNS
  BELONGS_TO
  ATTENDED
  MENTIONS
  RELATED_TO
  DECIDED_IN
  ASSIGNED_TO
  AUTHORED
}

model Relationship {
  id             String           @id @default(cuid())
  organizationId String
  fromNodeId     String
  toNodeId       String
  type           RelationshipType
  weight         Float?           @default(1)
  metadata       Json?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromNode     KnowledgeGraphNode @relation("FromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode       KnowledgeGraphNode @relation("ToNode", fields: [toNodeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([fromNodeId])
  @@index([toNodeId])
}

// ===== RAG answer grounding, search history, bookmarks =====

// One row per (source chunk/article/memory) an AI answer or search result
// actually drew from — queryId groups every Citation belonging to one
// answer/search turn so the UI can render "Sources" together.
model Citation {
  id             String              @id @default(cuid())
  organizationId String
  queryId        String
  sourceType     EmbeddingSourceType
  sourceId       String
  snippet        String              @db.Text
  relevanceScore Float

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId, queryId])
}

model SearchHistory {
  id               String  @id @default(cuid())
  organizationId   String
  userId           String
  query            String
  resultCount      Int
  isSemanticSearch Boolean @default(false)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId, userId])
  @@index([organizationId, createdAt])
}

enum BookmarkKind {
  BOOKMARK
  FAVORITE
}

// targetType/targetId is app-enforced semi-polymorphic, same convention as
// Comment's docKind/docId above — covers both "Bookmarks" and "Favorites"
// from the spec via `kind`, rather than two near-identical tables.
enum BookmarkableType {
  KNOWLEDGE_ARTICLE
  DEAL
  PROJECT
  COMPANY
  CONTACT
  DOCUMENT
  MEETING
  INGESTED_DOCUMENT
  AGENT_MEMORY
}

model Bookmark {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  kind           BookmarkKind
  targetType     BookmarkableType
  targetId       String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, kind, targetType, targetId])
  @@index([organizationId, userId])
}

enum AutomationTrigger {
  LEAD_CREATED
  TASK_COMPLETED
  MEETING_ENDED
  DECISION_MADE
  DEAL_STAGE_CHANGED
  DEAL_WON
  DEAL_LOST
  TASK_OVERDUE
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  CONTRACT_SIGNED
  INVOICE_PAID
  INVOICE_OVERDUE
  // Added for the Workflow Automation Engine (Phase 16) — everything else
  // above is reused as-is by Workflow.triggerType, not duplicated.
  LEAD_UPDATED
  PROJECT_CREATED
  CLIENT_MESSAGE
  MEETING_SCHEDULED
  WEBHOOK_RECEIVED
  TIMER
  CRON
  MANUAL
}

enum AutomationAction {
  CREATE_TASK
  SEND_NOTIFICATION
  ASSIGN_AGENT
}

model AutomationRule {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  description    String?           @db.Text
  trigger        AutomationTrigger
  action         AutomationAction
  actionConfig   Json
  active         Boolean           @default(true)
  runCount       Int               @default(0)
  lastRunAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

enum BillingPlan {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

enum BillingStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  // Added in Phase 18 (platform Subscription/Billing/Payment Gateway) —
  // real gateway-driven lifecycle states the old 3-value enum never needed
  // back when this was just a self-service, no-charge plan/seat label.
  TRIALING
  PAUSED
  INCOMPLETE
}

// Phase 18 additions below (stripeCustomerId onward) turn this from a plain
// plan/seat label into a real platform-billing anchor — every new
// gateway/period/trial field is nullable and every new relation is
// optional-on-this-side, so the pre-existing self-service plan switcher
// (src/app/dashboard/billing/actions.ts's updateBillingPlan, still keying
// off `plan`/`seatsIncluded` exactly as before) keeps working unchanged for
// organizations that never touch real payment processing.
model BillingAccount {
  id             String        @id @default(cuid())
  organizationId String        @unique
  plan           BillingPlan   @default(FREE)
  status         BillingStatus @default(ACTIVE)
  seatsIncluded  Int           @default(5)
  renewsAt       DateTime?

  // Real platform plan (Phase 18) — distinct from the legacy `plan` enum
  // above, which stays wired to the existing free self-service switcher.
  // A gateway-driven subscription sets `currentPlanId`; `plan` is kept in
  // sync as a best-effort human-readable label, never the source of truth
  // once `currentPlanId` is set.
  currentPlanId String?
  currentPlan   Plan?   @relation(fields: [currentPlanId], references: [id], onDelete: SetNull)

  gatewayProvider       PaymentGatewayProvider?
  gatewayCustomerId     String?
  gatewaySubscriptionId String?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  trialEndsAt           DateTime?
  cancelAtPeriodEnd     Boolean                 @default(false)
  canceledAt            DateTime?
  pausedAt              DateTime?

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices          PlatformInvoice[]
  payments          PlatformPayment[]
  paymentMethods    PaymentMethod[]
  billingAddress    BillingAddress?
  taxProfile        TaxProfile?
  usageRecords      UsageRecord[]
  aiUsageEvents     AIUsageEvent[]
  aiCreditLedger    AICreditLedger?
  couponRedemptions CouponRedemption[]
  licenses          License[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===== Phase 18: Subscription, Billing, Payment Gateway, White Label & Reseller Platform =====

enum PlanTier {
  FREE
  STARTER
  PROFESSIONAL
  BUSINESS
  ENTERPRISE
  CUSTOM
}

enum BillingIntervalUnit {
  MONTHLY
  QUARTERLY
  YEARLY
  LIFETIME
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
}

// Real, database-driven plan catalog — distinct from the legacy hardcoded
// PLAN_SEATS map in billing/actions.ts. Nullable limit fields mean
// "unlimited" (never a magic-number sentinel like -1 or 0, which would be
// ambiguous with a genuine zero-allowance plan).
model Plan {
  id              String              @id @default(cuid())
  tier            PlanTier
  name            String
  description     String?
  // Real gateway product/price ids this plan maps to, keyed by provider,
  // e.g. {"STRIPE": "price_123", "RAZORPAY": "plan_abc"} — populated once
  // an operator creates the matching Price/Plan object on each gateway's
  // own dashboard/API; a provider absent from this map simply isn't
  // purchasable via that gateway yet, never a fabricated id.
  gatewayPriceIds Json?
  interval        BillingIntervalUnit
  priceCents      Int
  currency        String              @default("USD")
  trialDays       Int                 @default(0)
  status          PlanStatus          @default(ACTIVE)
  isCustom        Boolean             @default(false)

  userLimit             Int?
  workspaceLimit        Int?
  aiCreditsMonthly      Int?
  storageMbLimit        Int?
  projectLimit          Int?
  clientLimit           Int?
  automationRunsMonthly Int?
  knowledgeBaseMbLimit  Int?
  apiCallsMonthly       Int?
  whiteLabelAccess      Boolean @default(false)
  customDomainAccess    Boolean @default(false)
  prioritySupport       Boolean @default(false)
  ssoAccess             Boolean @default(false)
  advancedAnalytics     Boolean @default(false)

  features        PlanFeature[]
  billingAccounts BillingAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tier, interval, currency])
}

// Per-plan feature toggles keyed by the same `key` FeatureFlag uses — lets
// isFeatureEnabled() (src/lib/billing/feature-flags.ts) resolve "does this
// org's plan include X" without a giant switch statement over PlanTier.
model PlanFeature {
  id      String  @id @default(cuid())
  planId  String
  key     String
  enabled Boolean @default(true)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
}

enum PaymentGatewayProvider {
  STRIPE
  RAZORPAY
  PAYPAL
  PADDLE
  LEMONSQUEEZY
  BANK_TRANSFER
  MANUAL
}

enum PlatformInvoiceType {
  TAX
  PROFORMA
  CREDIT_NOTE
  DEBIT_NOTE
  RECEIPT
  RECURRING
}

enum PlatformInvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
  REFUNDED
}

// Platform-level invoice (KVL GrowthOS billing a tenant organization for
// platform access) — a deliberately separate model/number sequence from
// the pre-existing client-facing `Invoice` (that one is an organization
// billing ITS OWN clients; conflating the two would leak platform billing
// data into a tenant's own CRM invoice list and vice versa).
model PlatformInvoice {
  id               String                @id @default(cuid())
  organizationId   String
  billingAccountId String
  invoiceNumber    String                @unique
  type             PlatformInvoiceType   @default(TAX)
  status           PlatformInvoiceStatus @default(DRAFT)
  currency         String
  subtotalCents    Int                   @default(0)
  taxCents         Int                   @default(0)
  discountCents    Int                   @default(0)
  totalCents       Int                   @default(0)
  amountPaidCents  Int                   @default(0)
  dueDate          DateTime?
  issuedAt         DateTime              @default(now())
  paidAt           DateTime?
  voidedAt         DateTime?
  gatewayInvoiceId String?
  pdfStorageKey    String?               @db.Text
  notes            String?               @db.Text

  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingAccount   BillingAccount        @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  items            PlatformInvoiceItem[]
  payments         PlatformPayment[]
  // A marketplace purchase is just another PlatformInvoice under the
  // buyer's existing BillingAccount — refundPlatformPayment(), issueCreditNote(),
  // and every existing invoice-list UI keep working completely unmodified.
  // Reverse side of MarketplaceOrder.platformInvoiceId.
  marketplaceOrder MarketplaceOrder?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([billingAccountId, status])
}

model PlatformInvoiceItem {
  id              String @id @default(cuid())
  invoiceId       String
  description     String
  quantity        Float  @default(1)
  unitAmountCents Int
  amountCents     Int
  order           Int    @default(0)

  invoice PlatformInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

enum PlatformPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model PlatformPayment {
  id                  String                 @id @default(cuid())
  organizationId      String
  billingAccountId    String
  invoiceId           String?
  provider            PaymentGatewayProvider
  status              PlatformPaymentStatus  @default(PENDING)
  amountCents         Int
  currency            String
  gatewayPaymentId    String?
  gatewayChargeId     String?
  failureReason       String?                @db.Text
  refundedAmountCents Int                    @default(0)
  paidAt              DateTime?

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingAccount BillingAccount   @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  invoice        PlatformInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([billingAccountId, status])
  @@index([gatewayPaymentId])
}

enum PaymentMethodType {
  CARD
  BANK_ACCOUNT
  PAYPAL
  MANUAL
}

model PaymentMethod {
  id                     String                 @id @default(cuid())
  billingAccountId       String
  provider               PaymentGatewayProvider
  type                   PaymentMethodType
  gatewayPaymentMethodId String?
  brand                  String?
  last4                  String?
  expiryMonth            Int?
  expiryYear             Int?
  isDefault              Boolean                @default(false)

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([billingAccountId])
}

model BillingAddress {
  id               String  @id @default(cuid())
  billingAccountId String  @unique
  legalName        String?
  line1            String?
  line2            String?
  city             String?
  state            String?
  postalCode       String?
  country          String?
  taxId            String?

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

enum TaxRuleType {
  GST
  VAT
  SALES_TAX
  NONE
}

// One real rate per billing account, resolved at subscribe/renew time from
// src/lib/billing/tax-rates.ts's static country/region table (documented
// there as approximate, real-world rates that need periodic review — never
// a fabricated placeholder percentage).
model TaxProfile {
  id               String      @id @default(cuid())
  billingAccountId String      @unique
  country          String
  region           String?
  taxRuleType      TaxRuleType @default(NONE)
  taxRatePercent   Float       @default(0)
  taxId            String?
  reverseCharge    Boolean     @default(false)

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

enum UsageMetricType {
  AI_TOKENS
  API_CALLS
  STORAGE_MB
  PROJECTS
  CRM_RECORDS
  AUTOMATION_RUNS
  KNOWLEDGE_BASE_MB
  USERS
  WORKSPACES
  BANDWIDTH_MB
}

// Append-only usage ledger — real, timestamped events, never overwritten.
// src/lib/billing/usage-metering.ts aggregates these per period (cached in
// Redis for fast enforcement checks) rather than maintaining a separately
// mutable running counter that could drift from the real event log.
model UsageRecord {
  id               String          @id @default(cuid())
  organizationId   String
  billingAccountId String
  metricType       UsageMetricType
  quantity         Float
  periodStart      DateTime
  periodEnd        DateTime
  metadata         Json?

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId, metricType, periodStart])
  @@index([billingAccountId, metricType])
}

enum AIUsageProvider {
  ANTHROPIC
  OPENAI
  GOOGLE_GEMINI
  GROQ
  OPENROUTER
  EMBEDDING
}

// One real row per AI call this session instruments (src/lib/ai/agent-runtime.ts,
// src/lib/rag/embeddings.ts) — inputTokens/outputTokens are the model's own
// real, reported usage (response.usage.input_tokens/output_tokens), never
// estimated. creditsUsed is derived via src/lib/billing/ai-credits.ts's
// documented per-provider conversion table.
model AIUsageEvent {
  id               String          @id @default(cuid())
  organizationId   String
  billingAccountId String
  provider         AIUsageProvider
  model            String
  inputTokens      Int             @default(0)
  outputTokens     Int             @default(0)
  creditsUsed      Float
  context          String?

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([billingAccountId, provider])
}

// One row per BillingAccount — the real, current AI-credit balance
// (monthly allotment reset each period + any separately purchased
// top-up), read on every AI call before it's allowed to proceed.
model AICreditLedger {
  id                        String    @id @default(cuid())
  billingAccountId          String    @unique
  monthlyCreditsGranted     Float     @default(0)
  monthlyCreditsUsed        Float     @default(0)
  purchasedCreditsRemaining Float     @default(0)
  periodResetAt             DateTime?

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

// Global feature registry + per-org manual overrides — resolution order in
// isFeatureEnabled() is: OrganizationFeatureOverride (if any) → the org's
// current Plan's PlanFeature (if any) → FeatureFlag.defaultEnabled. Lets an
// operator flip a feature on for one org (a beta tester, a support
// workaround) without touching that org's plan.
model FeatureFlag {
  id             String  @id @default(cuid())
  key            String  @unique
  name           String
  description    String?
  defaultEnabled Boolean @default(false)

  overrides OrganizationFeatureOverride[]

  createdAt DateTime @default(now())
}

model OrganizationFeatureOverride {
  id             String  @id @default(cuid())
  organizationId String
  featureFlagId  String
  enabled        Boolean

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  featureFlag  FeatureFlag  @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)

  @@unique([organizationId, featureFlagId])
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

// Covers both "Coupon Management" and "Promo Codes" from the spec via one
// model — `code` IS the promo code a customer types in; there is no
// separate underlying-rule-vs-human-code split (mirrors how Stripe itself
// models a coupon plus a human-friendly promotion code as the same
// concept for a system this size).
model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique
  type            CouponType
  value           Float
  currency        String?
  maxRedemptions  Int?
  redemptionCount Int        @default(0)
  expiresAt       DateTime?
  active          Boolean    @default(true)

  redemptions CouponRedemption[]

  createdAt DateTime @default(now())
}

model CouponRedemption {
  id               String   @id @default(cuid())
  couponId         String
  billingAccountId String
  redeemedAt       DateTime @default(now())

  coupon         Coupon         @relation(fields: [couponId], references: [id], onDelete: Cascade)
  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@unique([couponId, billingAccountId])
}

enum PartnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model Partner {
  id                    String        @id @default(cuid())
  userId                String        @unique
  referralCode          String        @unique
  status                PartnerStatus @default(PENDING)
  commissionRatePercent Float         @default(20)

  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  referredOrganizations Organization[]        @relation("ReferredByPartner")
  commissions           Commission[]
  payouts               Payout[]
  // Reverse side of MarketplacePublisher.partnerId — a marketplace
  // publisher's earnings flow through this same Partner's Commission/Payout rows.
  marketplacePublisher  MarketplacePublisher?

  createdAt DateTime @default(now())
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  VOID
}

enum CommissionSourceType {
  REFERRAL
  MARKETPLACE_SALE
}

model Commission {
  id             String           @id @default(cuid())
  partnerId      String
  organizationId String
  amountCents    Int
  currency       String
  status         CommissionStatus @default(PENDING)
  payoutId       String?

  // ---- Phase 19 additions ----
  sourceType           CommissionSourceType @default(REFERRAL)
  marketplaceInstallId String?

  partner            Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  payout             Payout?             @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  marketplaceInstall MarketplaceInstall? @relation(fields: [marketplaceInstallId], references: [id], onDelete: SetNull)
  // Reverse side of MarketplaceOrder.commissionId — a marketplace-sale
  // Commission is always reachable from the order that generated it.
  marketplaceOrder   MarketplaceOrder?

  createdAt DateTime @default(now())

  @@index([partnerId, status])
  @@index([marketplaceInstallId])
