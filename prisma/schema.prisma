enum ExpenseCategory {
  MARKETING
  SALES
  OTHER
}

// Manually-logged spend, the smallest honest input CAC needs — no
// accounting-system integration exists or is in scope. Same manual-entry
// discipline as Subscription/Deal.
model ExpenseEntry {
