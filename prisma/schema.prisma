enum MarketplaceCategory {
  INTEGRATION
  TEMPLATE
  AGENT_PACK
  // ============= Phase 19: Marketplace & AI Skills Ecosystem additions =============
  WORKFLOW
  CRM_TEMPLATE
  PROPOSAL_TEMPLATE
  AUTOMATION_TEMPLATE
  INDUSTRY_PACK
  DASHBOARD_PACK
  ANALYTICS_PACK
  INTEGRATION_CONNECTOR
  WHITE_LABEL_PACK
  PROMPT_PACK
  KNOWLEDGE_PACK
}

enum MarketplaceListingStatus {
  AVAILABLE
  COMING_SOON
  // ============= Phase 19 additions: publisher submission lifecycle =============
  DRAFT
  IN_REVIEW
  PUBLISHED
  REJECTED
  DEPRECATED
  SUSPENDED
}

enum MarketplacePricingModel {
  FREE
  ONE_TIME
  SUBSCRIPTION
}

// Global catalog — not per-organization. Seeded with genuine roadmap items,
// each honestly marked AVAILABLE or COMING_SOON; no fake "installed" state.
// Phase 19 extends this in place into a real installable catalog entry —
// every new field is nullable/defaulted so the original 8 rows need zero
// backfill. `AVAILABLE`/`PUBLISHED` are treated as equivalent "installable"
// states by every reader.
model MarketplaceListing {
  id            String                   @id @default(cuid())
  name          String
  description   String                   @db.Text
  category      MarketplaceCategory
  status        MarketplaceListingStatus @default(COMING_SOON)
  icon          String?
  interestCount Int                      @default(0)

  // ---- Phase 19 additions ----
  slug               String?                 @unique
  tagline            String?
  // Null = platform-authored listing (the original 8 rows, plus every
  // Workflow/Proposal/Dashboard/Knowledge/Integration listing that just
  // wraps an existing catalog row rather than a 3rd-party submission).
  publisherId        String?
  // Shape documented + zod-validated per MarketplaceCategory in
  // src/lib/marketplace/manifest-schema.ts — describes exactly what
  // installing this listing creates. Null on legacy rows with nothing
  // installable yet.
  manifest           Json?
  currentVersionId   String?
  pricingModel       MarketplacePricingModel @default(FREE)
  priceCents         Int?
  currency           String?
  // Reuses the existing Plan.interval enum rather than declaring a new one.
  billingInterval    BillingIntervalUnit?
  // Publisher revenue-share cut for this listing; null = platform default rate.
  platformFeePercent Float?
  // SUBSCRIPTION-priced listings only — { STRIPE?: string, RAZORPAY?: string,
  // PADDLE?: string } real gateway-side recurring price/plan/variant ids,
  // same shape/precedent as Plan.gatewayPriceIds. A provider missing here is
  // honestly unavailable for this listing's subscription checkout, never
  // fabricated. ONE_TIME-priced listings don't need this — checkout.ts
  // creates an ad-hoc inline price at purchase time instead.
  gatewayPriceIds    Json?
  industryTags       String[]                @default([])
  companySizeTags    String[]                @default([])
  installCount       Int                     @default(0)
  ratingAverage      Float                   @default(0)
  ratingCount        Int                     @default(0)
  isVerified         Boolean                 @default(false)

  publisher      MarketplacePublisher?   @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  currentVersion MarketplaceVersion?     @relation("MarketplaceListingCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       MarketplaceVersion[]    @relation("MarketplaceListingVersions")
  installs       MarketplaceInstall[]
  reviews        MarketplaceReview[]
  orders         MarketplaceOrder[]
  dependents     MarketplaceDependency[] @relation("MarketplaceDependencyTarget")
  interests      MarketplaceInterest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([category, status])
  @@index([publisherId])
}

model MarketplaceInterest {
  id             String @id @default(cuid())
  listingId      String
  organizationId String
  userId         String

  listing      MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User               @relation("MarketplaceInterestUser", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([listingId, organizationId])
}

enum MarketplaceVersionStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
  YANKED
}

// Immutable once PUBLISHED — an org's MarketplaceInstall.versionId always
// resolves to one exact, frozen manifest, so "rollback" is just repointing
// an install at a prior row here and re-running the install engine, never a
// diff/undo operation.
model MarketplaceVersion {
  id              String                   @id @default(cuid())
  listingId       String
  version         String // semver, e.g. "1.2.0"
  manifest        Json // frozen copy of the listing's manifest shape at publish time
  changelog       String?                  @db.Text
  status          MarketplaceVersionStatus @default(DRAFT)
  publishedAt     DateTime?
  createdByUserId String?

  listing           MarketplaceListing      @relation("MarketplaceListingVersions", fields: [listingId], references: [id], onDelete: Cascade)
  currentForListing MarketplaceListing[]    @relation("MarketplaceListingCurrentVersion")
  createdByUser     User?                   @relation("MarketplaceVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  dependencies      MarketplaceDependency[]
  installs          MarketplaceInstall[]
  orders            MarketplaceOrder[]

  createdAt DateTime @default(now())

  @@unique([listingId, version])
  @@index([listingId, status])
}

// versionId REQUIRES dependsOnListingId to be ACTIVE for the installing org
// (optionally >= minVersion) before install-engine.ts dispatches — checked
// at both submit time (for a paid checkout, fail fast before charging) and
// install time.
model MarketplaceDependency {
  id                 String  @id @default(cuid())
  versionId          String
  dependsOnListingId String
  minVersion         String?
  optional           Boolean @default(false)

  version          MarketplaceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  dependsOnListing MarketplaceListing @relation("MarketplaceDependencyTarget", fields: [dependsOnListingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([versionId])
  @@index([dependsOnListingId])
}

enum MarketplaceInstallStatus {
  ACTIVE
  UNINSTALLED
  FAILED
  ROLLED_BACK
}

// Central per-org entitlement record, generic across every pack kind — the
// single source of truth for "what has this org installed." For
// pricingModel === SUBSCRIPTION listings this row IS the subscription
// tracker too (same field vocabulary as BillingAccount, kept per-install
// rather than per-org since one org can hold many independent marketplace
// subscriptions).
model MarketplaceInstall {
  id                String                   @id @default(cuid())
  organizationId    String
  listingId         String
  versionId         String
  installedByUserId String
  status            MarketplaceInstallStatus @default(ACTIVE)
  // Itemized record of every row this install created, keyed by the
  // existing model it touched, e.g. { agentInstanceIds: string[],
  // workflowIds: string[], documentTemplateIds: string[],
  // dashboardTemplateIds: string[], knowledgeArticleIds: string[],
  // promptTemplateIds: string[], integrationConnectionId?: string,
  // featureFlagOverrideId?: string }. Uninstall/rollback reads this to know
  // exactly what to deactivate — never re-derives it from the manifest.
  createdRowsLog    Json

  // Recurring-billing fields — only set when pricingModel === SUBSCRIPTION,
  // synced by the marketplace-subscription-renewal-sweep job.
  gatewayProvider       PaymentGatewayProvider?
  gatewaySubscriptionId String?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean                 @default(false)

  licenseId String? @unique // reuses the existing License model

  installedAt         DateTime  @default(now())
  uninstalledAt       DateTime?
  uninstalledByUserId String?
  lastError           String?   @db.Text

  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listing           MarketplaceListing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  version           MarketplaceVersion        @relation(fields: [versionId], references: [id], onDelete: Restrict)
  installedByUser   User                      @relation("MarketplaceInstalledBy", fields: [installedByUserId], references: [id], onDelete: Restrict)
  uninstalledByUser User?                     @relation("MarketplaceUninstalledBy", fields: [uninstalledByUserId], references: [id], onDelete: SetNull)
  license           License?                  @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  review            MarketplaceReview?
  order             MarketplaceOrder?
  events            MarketplaceInstallEvent[]
  commissions       Commission[]

  createdAt DateTime @default(now())

  @@unique([organizationId, listingId])
  @@index([organizationId, status])
  @@index([listingId])
}

enum MarketplaceInstallEventType {
  INSTALLED
  UPGRADED
  UNINSTALLED
  ROLLED_BACK
  FAILED
}

// Append-only history log, distinct from MarketplaceInstall's current-state
// row — powers install-analytics and audit review without mutating the
// entitlement record itself.
model MarketplaceInstallEvent {
  id           String                      @id @default(cuid())
  installId    String
  eventType    MarketplaceInstallEventType
  fromVersion  String?
  toVersion    String?
  errorMessage String?                     @db.Text

  install MarketplaceInstall @relation(fields: [installId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([installId, createdAt])
}

model MarketplaceReview {
  id                   String    @id @default(cuid())
  listingId            String
  organizationId       String
  userId               String
  // Ties the review to a REAL install — this IS the "verified install"
  // badge, not a spoofable boolean.
  installId            String    @unique
  rating               Int // 1-5, zod-validated at the action layer
  title                String?
  body                 String?   @db.Text
  publisherResponse    String?   @db.Text
  publisherRespondedAt DateTime?

  listing      MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User               @relation("MarketplaceReviewAuthor", fields: [userId], references: [id], onDelete: Cascade)
  install      MarketplaceInstall @relation(fields: [installId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, organizationId])
  @@index([listingId])
}

enum MarketplacePublisherStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

// Wraps (not duplicates) the existing Partner/Commission/Payout reseller
// machinery — a MarketplacePublisher's earnings flow through the exact same
// Commission/Payout rows a referral Partner's do, differentiated only by
// Commission.sourceType.
model MarketplacePublisher {
  id             String                     @id @default(cuid())
  userId         String                     @unique
  partnerId      String?                    @unique
  displayName    String
  companyName    String?
  contactEmail   String
  website        String?
  status         MarketplacePublisherStatus @default(PENDING)
  bio            String?                    @db.Text
  logoStorageKey String?                    @db.Text

  user     User                 @relation("MarketplacePublisherUser", fields: [userId], references: [id], onDelete: Cascade)
  partner  Partner?             @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  listings MarketplaceListing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum MarketplaceOrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELED
}

// The money row for a marketplace purchase, deliberately thin — the actual
// charge/refund state lives on a real, reused PlatformInvoice/PlatformPayment
// under the buyer org's existing BillingAccount, so refundPlatformPayment()
// and every existing invoice UI keep working completely unmodified.
model MarketplaceOrder {
  id             String                  @id @default(cuid())
  organizationId String
  listingId      String
  versionId      String
  buyerUserId    String
  pricingModel   MarketplacePricingModel // snapshot at purchase time
  amountCents    Int
  currency       String
  status         MarketplaceOrderStatus  @default(PENDING)

  gatewayProvider          PaymentGatewayProvider?
  gatewayCheckoutSessionId String?

  platformInvoiceId String? @unique // reuse: real invoice/payment/refund lives here
  installId         String? @unique // set once the install engine completes post-payment
  commissionId      String? @unique // reuse: publisher payout lives here

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listing         MarketplaceListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  version         MarketplaceVersion  @relation(fields: [versionId], references: [id], onDelete: Restrict)
  buyerUser       User                @relation("MarketplaceOrderBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict)
  install         MarketplaceInstall? @relation(fields: [installId], references: [id], onDelete: SetNull)
  commission      Commission?         @relation(fields: [commissionId], references: [id], onDelete: SetNull)
  platformInvoice PlatformInvoice?    @relation(fields: [platformInvoiceId], references: [id], onDelete: SetNull)

