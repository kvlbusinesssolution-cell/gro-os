enum SignatureProvider {
  MANUAL
  DOCUSIGN
  ADOBE_SIGN
  DROPBOX_SIGN
}

enum SignatureStatus {
  PENDING
  SIGNED
  DECLINED
  EXPIRED
}

// Digital-signature-ready architecture: MANUAL is fully implemented (a
// public token-based signing page records signerName/typedSignature/IP and
// flips the parent document to SIGNED). DOCUSIGN/ADOBE_SIGN/DROPBOX_SIGN
// are modeled so a future phase can wire in a real vendor integration
// without a schema change — no real API calls are made to any of them
// today (no vendor credentials exist in this environment).
model Signature {
  id                 String            @id @default(cuid())
  organizationId     String
  docKind            DocumentKind
  docId              String
  signerName         String
  signerEmail        String
  provider           SignatureProvider @default(MANUAL)
  status             SignatureStatus   @default(PENDING)
  signatureToken     String            @unique
  typedSignature     String?
  signedAt           DateTime?
  ipAddress          String?
  requestedByUserId  String?
  // Third-party envelope id (DocuSign envelopeId, Adobe Sign agreementId,
  // Dropbox Sign signature_request_id) — set only once a real envelope is
  // created via the Integration Layer (src/lib/integrations/*). Null for
  // MANUAL signatures. The webhook receivers under src/app/api/webhooks/
  // look a Signature up by this field to mark it SIGNED on a real
  // provider-pushed event, never by polling/guessing.
  providerEnvelopeId String?

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedByUser User?        @relation("SignatureRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([provider, providerEnvelopeId])
  @@index([organizationId])
  @@index([docKind, docId])
}

// ===== Phase 17: Enterprise Knowledge Base / AI Long-Term Memory / RAG Engine =====
// KnowledgeArticleKind/Status/visibility are additive to the pre-existing
// flat KnowledgeArticle (createdAt/updatedAt/tags/knowledgeBaseId unchanged,
// every existing row is valid under the new defaults: kind ARTICLE, status
// PUBLISHED — the old model had no draft concept, so treating pre-existing
// rows as already-published is the only honest default). `tags String[]`
// stays as the simple free-text tag column existing UI already reads/writes
// (src/app/dashboard/knowledge-base/_components/article-form.tsx); the new
// `tagEntities`/KnowledgeTag relation below is an additional, real
// tag-as-entity system (autocomplete, per-tag article counts, tag pages) —
// both coexist, neither replaces the other.
enum KnowledgeArticleKind {
  ARTICLE
  FAQ
  POLICY
  PROCEDURE
  PLAYBOOK
  TEMPLATE
  MEETING_NOTES
  SOP
  TECHNICAL_DOC
  SALES_DOC
  HR_DOC
  FINANCE_DOC
}

enum KnowledgeArticleStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

// PRIVATE: only createdByUserId can read/edit. ORG: every active member of
// the organization. There is no Department model anywhere else in this
// schema, so a DEPARTMENT visibility tier isn't backed by a real table yet —
// left out rather than faked; ORG is the honest ceiling today.
enum KnowledgeArticleVisibility {
  PRIVATE
  ORG
}

model KnowledgeArticle {
  id              String   @id @default(cuid())
  knowledgeBaseId String
  title           String
  content         String   @db.Text
  tags            String[]
  createdByUserId String?

  categoryId String?
  kind       KnowledgeArticleKind       @default(ARTICLE)
  status     KnowledgeArticleStatus     @default(PUBLISHED)
  visibility KnowledgeArticleVisibility @default(ORG)

  reviewedByUserId String?
  reviewedAt       DateTime?

  knowledgeBase KnowledgeBase             @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  createdByUser User?                     @relation("ArticleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  category      KnowledgeCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tagEntities   KnowledgeTag[]            @relation("ArticleTags")
  versions      KnowledgeArticleVersion[]
  attachments   KnowledgeAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([knowledgeBaseId])
  @@index([categoryId])
}

model KnowledgeCategory {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  parentId       String?

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       KnowledgeCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     KnowledgeCategory[] @relation("CategoryHierarchy")
  articles     KnowledgeArticle[]

  createdAt DateTime @default(now())

  @@unique([organizationId, slug])
  @@index([organizationId, parentId])
}

model KnowledgeTag {
  id             String @id @default(cuid())
  organizationId String
  name           String
  slug           String

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  articles     KnowledgeArticle[] @relation("ArticleTags")

  createdAt DateTime @default(now())

  @@unique([organizationId, slug])
  @@index([organizationId])
}

// Full-content snapshot taken on every real edit (not a diff store) — same
// "keep the whole prior version" simplicity as DocumentVersion elsewhere in
// this schema, not a byte-diff engine.
model KnowledgeArticleVersion {
  id             String  @id @default(cuid())
  articleId      String
  title          String
  content        String  @db.Text
  editedByUserId String?

  article      KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  editedByUser User?            @relation("KnowledgeArticleVersionEditor", fields: [editedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([articleId])
}

model KnowledgeAttachment {
  id               String  @id @default(cuid())
  articleId        String
  filename         String
  storageKey       String  @db.Text
  mimeType         String
  sizeBytes        Int
  uploadedByUserId String?

  article        KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  uploadedByUser User?            @relation("KnowledgeAttachmentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([articleId])
