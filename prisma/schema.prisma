enum MemoryType {
  PREFERENCE
  GOAL
  PAST_DECISION
  MEETING_NOTE
  CLIENT_CONTEXT
  KNOWLEDGE
  TASK
}

// Real record this memory was distilled from, if any — MANUAL covers memory
// a user wrote directly via the AI Memory Manager UI rather than one an
// agent derived from a real event.
enum MemorySourceKind {
  MEETING
  DEAL
  PROPOSAL
  PROJECT
  TASK
  MANUAL
}

model AgentMemory {
  id               String     @id @default(cuid())
  agentId          String
  organizationId   String
  type             MemoryType
  // AES-256-GCM ciphertext (base64: iv + authTag + ciphertext) — see src/lib/ai/encryption.ts.
  // Never store or query plaintext here.
  encryptedContent String     @db.Text

  pinned     Boolean           @default(false)
  archivedAt DateTime?
  sourceKind MemorySourceKind?
  sourceId   String?

  agent        AIAgentInstance    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       AgentMemoryEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@index([organizationId, type])
  @@index([agentId, pinned])
  @@index([agentId, archivedAt])
}

enum MemoryEventType {
  CREATED
  EDITED
  PINNED
  UNPINNED
  ARCHIVED
  RESTORED
  DELETED
}

// Real audit trail backing the AI Memory Manager's Memory Timeline — one row
// per real state change to a memory (never inferred/reconstructed after the
// fact). memoryId is nullable so a DELETED event can still be listed after
// the AgentMemory row itself is gone (memory's own onDelete: Cascade would
// otherwise erase its own history) — the deleted memory's last known
// (encrypted) content is preserved in `contentSnapshot` for exactly that
// case.
model AgentMemoryEvent {
  id              String          @id @default(cuid())
  memoryId        String?
  agentId         String
  organizationId  String
  eventType       MemoryEventType
  contentSnapshot String?         @db.Text
  actorUserId     String?

  memory       AgentMemory? @relation(fields: [memoryId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId, agentId])
  @@index([memoryId])
}

enum MessagePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model AgentConversation {
  id              String          @id @default(cuid())
  organizationId  String
  senderAgentId   String
  receiverAgentId String?
  reason          String
  priority        MessagePriority @default(NORMAL)
  content         String          @db.Text
  attachments     Json?
  parentId        String?

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  senderAgent   AIAgentInstance     @relation("ConversationSender", fields: [senderAgentId], references: [id], onDelete: Cascade)
  receiverAgent AIAgentInstance?    @relation("ConversationReceiver", fields: [receiverAgentId], references: [id], onDelete: Cascade)
  parent        AgentConversation?  @relation("ConversationThread", fields: [parentId], references: [id], onDelete: SetNull)
  replies       AgentConversation[] @relation("ConversationThread")

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([parentId])
}

enum NotificationType {
  MEETING_STARTED
  MEETING_ENDED
  TASK_ASSIGNED
  TASK_COMPLETED
  DECISION_MADE
  NEW_RECOMMENDATION
  CRITICAL_ALERT
  APPROVAL_REQUESTED
  EMAIL_READY
  CRM_EVENT
  AUTOMATION_EVENT
