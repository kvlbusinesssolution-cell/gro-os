enum ComplianceFramework {
  SOC2
  ISO27001
  GDPR
  CCPA
  DPDP_INDIA
  PCI_DSS
  WCAG
}

enum ComplianceReportStatus {
  READY
  PARTIAL
  NOT_READY
}

// A real, generated readiness snapshot per framework — `findings` is real,
// structured Json (a checklist of real controls checked against this
// codebase's actual architecture), never a fabricated "certified" claim.
// This app is not SOC2/ISO27001-CERTIFIED by generating this row — it
// records ARCHITECTURAL READINESS for that certification process, which
// still requires a real third-party auditor engagement this codebase
// cannot itself provide.
model ComplianceReport {
  id          String                 @id @default(cuid())
  framework   ComplianceFramework
  status      ComplianceReportStatus
  findings    Json
  generatedAt DateTime               @default(now())

  @@index([framework, generatedAt])
