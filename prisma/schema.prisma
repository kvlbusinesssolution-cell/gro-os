  organizationId  String
  category        ExpenseCategory
  amount          Float
  incurredOn      DateTime        @db.Date
  description     String?
  createdByUserId String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId, incurredOn])
}

// ============================= Phase 16: Integration Hub & Workflow Automation Engine =============================

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum WorkflowRunStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum WorkflowNodeType {
  TRIGGER
  CONDITION
  DELAY
  LOOP
  AI_ACTION
  EMAIL
  SMS
  WEBHOOK
  CRM
  PROPOSAL
  PROJECT
  APPROVAL
  DOCUMENT
  NOTIFICATION
  DATABASE
  FUNCTION
  CUSTOM_API
}

// The advanced, multi-step, branchable automation engine — a genuine
// superset of the existing simple AutomationRule (one trigger, one action),
// which stays exactly as-is for its existing callers. A Workflow can express
// everything an AutomationRule can (its first two nodes are just
// TRIGGER→one action node) plus branching/loops/delays/AI-authored plans.
model Workflow {
  id              String            @id @default(cuid())
  organizationId  String
  name            String
  description     String?           @db.Text
  status          WorkflowStatus    @default(DRAFT)
  triggerType     AutomationTrigger
  // Trigger-specific config, e.g. { cronExpression } for CRON, { webhookId }
  // for WEBHOOK_RECEIVED — validated against a per-trigger-type Zod schema
  // in application code, not enforced at the DB layer.
  triggerConfig   Json?
  isAIGenerated   Boolean           @default(false)
  // The exact natural-language prompt that produced this workflow, if any —
  // kept verbatim for audit/regeneration, never summarized/altered.
  aiPrompt        String?           @db.Text
  createdByUserId String?
  runCount        Int               @default(0)
  lastRunAt       DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        WorkflowStep[]
  runs         WorkflowRun[]
  webhooks     Webhook[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
}

model WorkflowStep {
  id            String           @id @default(cuid())
  workflowId    String
  nodeType      WorkflowNodeType
  name          String
  // Node-specific configuration (e.g. EMAIL: {to, subject, template},
  // CONDITION: {field, operator, value}, CUSTOM_API: {url, method, headers}).
  config        Json
  // Canvas position for the visual builder — {x, y}. Purely presentational,
  // never read by the execution engine.
  position      Json
  // Ordered DAG via explicit next-step pointers rather than an implicit
  // array index, since CONDITION nodes branch (see onTrueStepId/onFalseStepId).
  nextStepId    String?          @unique
  onTrueStepId  String?          @unique
  onFalseStepId String?          @unique

  workflow    Workflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  nextStep    WorkflowStep? @relation("WorkflowStepNext", fields: [nextStepId], references: [id], onDelete: SetNull)
  onTrueStep  WorkflowStep? @relation("WorkflowStepOnTrue", fields: [onTrueStepId], references: [id], onDelete: SetNull)
  onFalseStep WorkflowStep? @relation("WorkflowStepOnFalse", fields: [onFalseStepId], references: [id], onDelete: SetNull)

  incomingNext    WorkflowStep[] @relation("WorkflowStepNext")
  incomingOnTrue  WorkflowStep[] @relation("WorkflowStepOnTrue")
  incomingOnFalse WorkflowStep[] @relation("WorkflowStepOnFalse")

  stepRuns WorkflowStepRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workflowId])
}

// Real execution record — created the moment a trigger genuinely fires
// (never speculative), one per actual run.
model WorkflowRun {
  id             String            @id @default(cuid())
  workflowId     String
  organizationId String
  status         WorkflowRunStatus @default(QUEUED)
  // The real event payload that triggered this run (webhook body, entity
  // snapshot, cron tick timestamp, manual-trigger user input) — verbatim.
  triggerPayload Json?
  startedAt      DateTime?
  finishedAt     DateTime?
  error          String?           @db.Text
  // BullMQ job id for this run, once queue infra (Batch 12.2) is wired —
  // null for runs executed before/without the queue.
  queueJobId     String?

  workflow Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepRuns WorkflowStepRun[]

  createdAt DateTime @default(now())

  @@index([workflowId, status])
  @@index([organizationId, createdAt])
}

model WorkflowStepRun {
  id             String            @id @default(cuid())
  workflowRunId  String
  workflowStepId String
  status         WorkflowRunStatus @default(QUEUED)
  input          Json?
  output         Json?
  error          String?           @db.Text
  attempt        Int               @default(1)
  startedAt      DateTime?
  finishedAt     DateTime?

  workflowRun  WorkflowRun  @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  workflowStep WorkflowStep @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)

  @@index([workflowRunId])
}

// Prebuilt starting points — a real, complete { steps, triggerType } shape
// (the same shape a real Workflow+WorkflowStep set would have), never a
// vague description-only placeholder. "Install" deep-copies this into a
// real Workflow for the installing org.
model AutomationTemplate {
  id             String            @id @default(cuid())
  // Unique so the prebuilt-template seed can upsert on name instead of
  // duplicating rows every time it re-runs.
  name           String            @unique
  description    String            @db.Text
  category       String
  icon           String?
  popular        Boolean           @default(false)
  triggerType    AutomationTrigger
  triggerConfig  Json?
  // Array of { nodeType, name, config, position, order } — application code
  // materializes this into real WorkflowStep rows on install, preserving
  // branching via a local index rather than real IDs (which don't exist
  // until installed).
  stepsBlueprint Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Persisted mirror of the in-process event-bus (src/lib/realtime/event-bus.ts)
// publishes — that bus stays purely in-memory/SSE-only (documented single-
// instance limitation), this table is the durable, replayable, queryable
// history layer the Event Bus spec asks for, written alongside every publish.
model EventLog {
  id             String    @id @default(cuid())
  organizationId String
  eventType      String
  payload        Json
  publishedAt    DateTime  @default(now())
  replayedAt     DateTime?
  replayCount    Int       @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, eventType, publishedAt])
}

enum SecretCategory {
  API_KEY
  OAUTH_SECRET
  JWT_SECRET
  SMTP_CREDENTIAL
  DATABASE_CREDENTIAL
  ENCRYPTION_KEY
  OTHER
}

// The Secrets Manager's own store — distinct from IntegrationConnection's
// OAuth tokens (which have their own dedicated encrypted fields) and from
// ApiKey (this app's own issued keys, bcrypt-hashed not reversibly
// encrypted since they're never displayed again after creation). This is
// for arbitrary user-entered secrets a Workflow's CUSTOM_API/WEBHOOK nodes
// need to reference (e.g. a third-party service's raw API key) — AES-256-GCM
// encrypted at rest via src/lib/crypto/aes-gcm.ts, decrypted only inside a
// Server Action / job worker, never sent to the client.
model Secret {
  id              String         @id @default(cuid())
  organizationId  String
  key             String
  category        SecretCategory @default(OTHER)
  encryptedValue  String         @db.Text
  description     String?
  createdByUserId String?
  lastRotatedAt   DateTime?
  lastUsedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
}

// Real per-call usage tracking for both this app's own issued ApiKeys and
// outbound calls to connected IntegrationConnections — powers the API
// Manager's "Usage Statistics" and rate-limit displays honestly, never
// estimated.
model APIUsage {
  id                      String   @id @default(cuid())
  organizationId          String
  apiKeyId                String?
  integrationConnectionId String?
  endpoint                String
  method                  String
  statusCode              Int
  responseTimeMs          Int
  createdAt               DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([apiKeyId])
  @@index([integrationConnectionId])
}

enum WebhookDirection {
  INCOMING
  OUTGOING
}

// Phase 33: the platform's fixed catalog of typed events a developer can
// subscribe to (Webhook.eventTypes below) — distinct from the per-Workflow
// generic WEBHOOK/CUSTOM_API node, which fires on workflow logic, not a
// named business event. Extend this enum (and the real emitWebhookEvent()
// call site in src/lib/webhooks/event-bus.ts) together — never add an event
// name here without a real emitter, and never emit an event not listed here.
enum WebhookEventType {
  CONTACT_CREATED
  COMPANY_CREATED
  DEAL_WON
  DEAL_LOST
  APPLICATION_STATUS_CHANGED
}

// User-configured, dynamically-created webhooks tied to a Workflow — the
// generic Webhook Engine's own model. Distinct from the hardcoded, code-level
// receiver routes already built for DocuSign/Adobe Sign/Dropbox Sign/Resend
// (src/app/api/webhooks/*/route.ts), which stay exactly as they are; those
// are fixed integrations, this is a user-defined endpoint per Workflow.
model Webhook {
  id              String           @id @default(cuid())
  organizationId  String
  workflowId      String?
  direction       WebhookDirection
  // For INCOMING: the unique slug this org's endpoint is reachable at
  // (/api/webhooks/custom/[slug]). For OUTGOING: the real target URL this
  // Workflow's WEBHOOK node posts to.
  slug            String?          @unique
  targetUrl       String?
  // AES-256-GCM encrypted HMAC signing secret (incoming: verifies the
  // sender; outgoing: signs our own payload so the receiver can verify us).
  encryptedSecret String?          @db.Text
  active          Boolean          @default(true)
  lastTriggeredAt DateTime?
  // Phase 33: when non-empty, this row is ALSO (or exclusively, if
  // workflowId is null) a platform event-bus subscription — delivered by
  // emitWebhookEvent() whenever a matching typed business event fires for
  // this organization, in addition to (or instead of) any Workflow-triggered
  // delivery. A row can legitimately have both a workflowId and eventTypes.
  eventTypes      WebhookEventType[] @default([])

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow     Workflow?         @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  deliveries   WebhookDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model WebhookDelivery {
  id         String           @id @default(cuid())
  webhookId  String
  direction  WebhookDirection
  payload    Json
  statusCode Int?
  success    Boolean          @default(false)
  attempt    Int              @default(1)
  error      String?          @db.Text

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([webhookId, createdAt])
}

// ===== Final Phase: Enterprise Security, Monitoring, DR, Compliance =====

enum SecurityEventType {
  LOGIN_FAILED
  LOGIN_SUCCESS_NEW_DEVICE
  BRUTE_FORCE_DETECTED
  RATE_LIMIT_EXCEEDED
  SUSPICIOUS_IP
  PASSWORD_CHANGED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  SESSION_REVOKED
  API_KEY_ABUSE
  WEBHOOK_SIGNATURE_INVALID
  PERMISSION_DENIED
}

enum SecurityEventSeverity {
  INFO
  WARNING
  CRITICAL
}

// Distinct from the generic AuditLog (which records real WHAT-HAPPENED
// business actions, e.g. "integration.connected") — SecurityEvent is
// specifically security-relevant signals with a real severity, meant to
// feed both an admin-facing security feed and the alerting pipeline
// (SystemAlert below). Never a duplicate of AuditLog; a single real event
// (e.g. a password change) may reasonably produce rows in both, from two
// different call sites with two different purposes.
model SecurityEvent {
  id             String                @id @default(cuid())
  userId         String?
  organizationId String?
  type           SecurityEventType
  severity       SecurityEventSeverity @default(INFO)
  ipAddress      String?
  userAgent      String?
  detail         String?               @db.Text
  metadata       Json?

  // Hash chain — same scheme as AuditLog.previousHash/hash above (see
  // src/lib/audit-chain-verify.ts): tamper-evident, not a DB-enforced
  // append-only guarantee. See AuditLog's doc comment for the full caveat.
  previousHash String?
  hash         String?

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([type, createdAt])
  @@index([severity, createdAt])
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  MONITORING
  RESOLVED
}

// Phase 20: distinguishes ISO27001's "Security Incident Register"
// requirement from ordinary operational incidents, without a parallel
// SecurityIncident model — a security incident IS an Incident, just
// categorized. Defaults to OPERATIONAL so every pre-Phase-20 row stays
// correctly classified without a backfill.
enum IncidentCategory {
  OPERATIONAL
  SECURITY
  AVAILABILITY
  DATA
  COMPLIANCE
}

// A real, platform-operator-facing incident record — created either
// manually (an operator declares an incident) or automatically from a
// CRITICAL SystemAlert (see below). Distinct from the org-scoped BugReport
// model (a client/team-facing bug tracker for one project) — this is
// platform-wide operational incident tracking.
model Incident {
  id          String           @id @default(cuid())
  title       String
  description String?          @db.Text
  severity    IncidentSeverity
  status      IncidentStatus   @default(OPEN)
  category    IncidentCategory @default(OPERATIONAL)
  startedAt   DateTime         @default(now())
  resolvedAt  DateTime?
  postmortem  String?          @db.Text

  updates IncidentUpdate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Real timeline entries for an Incident — never edited in place once
// created (append-only), so the incident's real history is preserved
// exactly as it happened for a postmortem, matching this app's existing
// "immutable log" discipline elsewhere (AuditLog/SecurityEvent are also
// create-only, never updated).
model IncidentUpdate {
  id         String         @id @default(cuid())
  incidentId String
  message    String         @db.Text
  status     IncidentStatus

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([incidentId])
}

enum SystemComponent {
  DATABASE
  REDIS
  AI_PROVIDER
  EMBEDDING_PROVIDER
  PAYMENT_GATEWAY
  STORAGE
  WORKFLOW_QUEUE
  SCHEDULER_QUEUE
  RAG_QUEUE
  BILLING_QUEUE
  EMAIL
}

enum HealthStatus {
  HEALTHY
  DEGRADED
  DOWN
}

// Real periodic health-check snapshots (see src/lib/monitoring/health.ts) —
// a genuine probe result per component, never a fabricated "all green."
// The live /api/health endpoint always computes a real-time check itself;
// this table is the historical record those checks accumulate into for
// uptime trend charts on the Production Dashboard.
model SystemHealthSnapshot {
  id        String          @id @default(cuid())
  component SystemComponent
  status    HealthStatus
  latencyMs Int?
  detail    String?         @db.Text

