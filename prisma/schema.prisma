enum SystemAlertType {
  SERVER_DOWN
  QUEUE_FAILURE
  DATABASE_FAILURE
  PAYMENT_FAILURE
  AUTH_FAILURE
  AI_PROVIDER_FAILURE
  STORAGE_FAILURE
  HIGH_CPU
  HIGH_MEMORY
  SECURITY_INCIDENT
}

enum SystemAlertSeverity {
  WARNING
  CRITICAL
}

enum SystemAlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

// Infrastructure/operational alerting — deliberately named SystemAlert, not
// "Alert" (that name is already the pre-existing org-scoped business-KPI
// alert model, e.g. "this deal's health score dropped" — a completely
// different concern from "the database is unreachable"). Real rows only,
// created by real monitoring checks (src/lib/monitoring/*), never
// synthetic demo data.
model SystemAlert {
