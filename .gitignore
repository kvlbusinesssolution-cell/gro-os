# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report

# real session storageState minted by e2e/global-setup.ts against a real
# local/CI Postgres — never a fixture worth committing, and would leak a
# live session cookie if it were.
/e2e/.auth

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# uploaded documents — real user files, never checked in
/storage/documents

# generated a11y audit reports (scripts/a11y-audit.ts) — regenerate anytime, never checked in
/storage/a11y-reports

# real database dumps produced by scripts/backup-database.sh — never checked in
# (this repo is public; a committed dump would leak real data)
/storage/backups

# uploaded career resumes — real user files, never checked in
/storage/career-resumes

# generated career CVs (CV Builder) — real user files, never checked in
/storage/career-cvs
__pycache__/
