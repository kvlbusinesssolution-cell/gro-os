DATABASE_URL="postgresql://user:password@localhost:5432/kvl_growthos?schema=public"
AUTH_SECRET="generate with: openssl rand -base64 32"

# Redis — required for the Scheduler Service's real BullMQ job queue
# (src/lib/scheduler/providers/bullmq-provider.ts) and used as a second,
# independent consumer by the generic Redis caching layer
# (src/lib/cache/redis-cache.ts, e.g. company-health.ts's computeCompanyHealth).
# Also backs the AI provider fallback retry queue below
# (src/lib/ai/fallback-queue.ts). A local install (`redis-server`) or any
# managed Redis works. Defaults to redis://localhost:6379 if unset.
# REDIS_URL="redis://localhost:6379"

# ---- AI Agent Runtime: paid providers + free fallback chain ----
# Every AI Agent Instance call (src/lib/ai/agent-runtime.ts) goes through a
# real fallback chain (src/lib/ai/fallback.ts), tried in this exact order:
#   1. Google Gemini (paid, GEMINI_API_KEY) — primary; the org pays for real
#      Gemini quota and wants it actually spent rather than sitting idle.
#   2. OpenAI (paid, OPENAI_API_KEY) — second paid provider, same "don't
#      leave a paid key idle" reasoning; added 2026-09-17.
#   3. Anthropic Claude (paid, ANTHROPIC_API_KEY) — third fallback; still the
#      model every agent prompt in this codebase was actually tuned against,
#      so quality never regresses once Gemini and OpenAI are both down.
#   4. Groq (free tier, GROQ_API_KEY) — fast, generous free allowance.
#   5. OpenRouter (free-tier ":free" models, OPENROUTER_API_KEY) — last resort
#      before the whole chain is considered down.
# Only the providers with a key actually set are tried — set just
# ANTHROPIC_API_KEY and the other four are silently skipped, exactly like
# today. Set none at all and every AI Agent call throws AINotConnectedError
# (never fabricated output). If EVERY configured provider fails on a given
# call, it's queued for durable automatic retry (BullMQ, backed off over
# several minutes) rather than failing outright — see fallback-queue.ts.
#
# These are DISTINCT from the per-org "Connect" dialog credentials under
# /dashboard/settings/integrations (see the Groq/Gemini/OpenRouter/OpenAI/
# DeepSeek/Ollama note further down this file) — those are each
# organization's OWN bring-your-own-key for the separate Integration Hub
# "AI_PROVIDER" adapters, stored per-org in the database, never read from
# process.env, and never used by the agent runtime. The keys below are YOUR
# platform's own fallback keys, used by every organization's agents.
#
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL="gpt-5.1"
# GROQ_API_KEY=
# GROQ_MODEL="openai/gpt-oss-120b"
# GEMINI_API_KEY=
# GEMINI_MODEL="gemini-flash-latest"
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL="nvidia/nemotron-3-super-120b-a12b:free"
# Free-tier model slugs on Groq/OpenRouter get retired without warning —
# if a provider starts 404ing, check its current catalog (Groq:
# GET https://api.groq.com/openai/v1/models with your key; OpenRouter:
# GET https://openrouter.ai/api/v1/models, filter for ids ending ":free";
# OpenAI: GET https://api.openai.com/v1/models with your key) and update the
# *_MODEL var rather than assuming the key itself is broken.

# ---- Optional OAuth providers ----
# Each provider below is only added to Auth.js's `providers` array when its
# client id/secret are BOTH set. Leave these unset and the app builds/runs
# fine — those login buttons simply don't render. Set both to enable it.

# Google OAuth (https://console.developers.google.com/apis/credentials)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID / Azure AD OAuth (https://portal.azure.com)
# MICROSOFT_ENTRA_ID_TENANT_ID is optional — omit it to allow any Microsoft
# account (personal/school/work) to sign in via the multi-tenant endpoint.
# MICROSOFT_ENTRA_ID_CLIENT_ID=
# MICROSOFT_ENTRA_ID_CLIENT_SECRET=
# MICROSOFT_ENTRA_ID_TENANT_ID=

# GitHub OAuth (https://github.com/settings/developers)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# LinkedIn OAuth (https://www.linkedin.com/developers/apps) — requires a
# LinkedIn Company Page, and the "Sign In with LinkedIn using OpenID Connect"
# product enabled on the app. Callback URL to authorize in the app's Auth
# settings: <your-site-url>/api/auth/callback/linkedin
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# ---- Optional magic-link (email) sign-in ----
# Without EMAIL_SERVER set, magic links are never actually emailed — the
# sign-in link is instead logged to the server console
# ("[DEV] Magic link for x@y.com: <url>") and the flow still completes
# successfully, so magic-link sign-in is fully testable without real SMTP.
# Set EMAIL_SERVER (a nodemailer connection string, e.g.
# "smtp://user:pass@smtp.example.com:587") and EMAIL_FROM to send real email.
# EMAIL_SERVER=
# EMAIL_FROM=

# ---- Optional Outreach Assistant email sending ----
# The Outreach Assistant (src/lib/outreach/email-provider.ts) sends real cold
# email via Resend if RESEND_API_KEY is set, else via the EMAIL_SERVER/
# EMAIL_FROM pair above. With neither set, EmailDrafts can be generated and
# approved but a "send" honestly reports not_configured — a draft is never
# marked SENT unless a real send genuinely succeeded.
#
# IMPORTANT for cold outreach specifically: this app never sets a distinct
# Reply-To header, so a prospect's "Reply" goes to whatever EMAIL_FROM is —
# a "no-reply@..." address here silently swallows every real reply. Use a
# real, monitored mailbox (e.g. "Your Company <sales@yourdomain.com>") for
# EMAIL_FROM if outreach replies matter to you.
# RESEND_API_KEY=

# Resend webhook signature verification (src/app/api/webhooks/resend/route.ts).
# Resend signs webhook deliveries via Svix — this is the per-endpoint signing
# secret ("whsec_...") shown when you create the webhook in the Resend
# dashboard (resend.com/docs/dashboard/webhooks/event-types), subscribed to
# email.bounced/email.complained. Without this set, incoming webhooks are
# still processed but a warning is logged that signature verification was
# skipped.
# RESEND_WEBHOOK_SECRET=

# ---- KVL sales-inbox reply sync (real IMAP read, KVL-only) ----
# src/lib/business-development/kvl-reply-sync-job.ts polls this mailbox
# every 30 minutes (registry.ts's `kvl-reply-sync` job) and turns a real
# reply from a matching Contact into a real Reply row (with AI sentiment)
# automatically — no manual "log a reply" needed for KVL's own outreach.
# Hardcoded to KVL's own info@ mailbox by design (sales@ is just a forwarding
# alias to it — aliases have no inbox of their own to poll), not a generic
# per-org integration. Confirmed live 2026-09-17: this domain's MX records
# point at Hostinger's own hosted mail (mx1/mx2.hostinger.com), so the real
# IMAP host is Hostinger's shared one — imap.hostinger.com, NOT
# mail.<yourdomain> (that guess 404ed/NXDOMAIN'd; don't assume a custom
# self-hosted mail server just because the *website* is on a Hostinger VPS).
# KVL_IMAP_HOST=imap.hostinger.com
# KVL_IMAP_PORT=993
# KVL_IMAP_USER=
# KVL_IMAP_PASSWORD=
# KVL_IMAP_SECURE=true

# ---- Optional Website Scanner: real search-rank check ----
# The SEO tab's "Search ranking" finding (src/lib/scanner/seo-rank.ts) does a
# real Google SERP lookup via SerpApi (https://serpapi.com — paid, has a free
# trial tier) for the site's own guessed brand keyword. Google has no free
# public rank-check API, so this is genuinely optional — without it, the
# finding honestly reads "Rank tracking not configured" rather than a
# fabricated position. Never folded into the numeric SEO score (would make
# scores incomparable between scans run with vs. without this key).
# SERPAPI_KEY=

# ---- Optional Website Scanner: real headless-browser measurement ----
# When set to "true", the scanner launches a real headless Chromium
# (Playwright, src/lib/scanner/browser-metrics.ts) against the target site to
# measure genuine Core Web Vitals (LCP/CLS/a long-task-based TBT proxy) and a
# real rendered-computed-style color-contrast ratio, blended into the
# Performance/UX scores in place of the static-HTML-only heuristics. This is
# NOT installed by default — Chromium must be present in the runtime
# environment (`npx playwright install --with-deps chromium`, which needs a
# glibc-based OS; the project's default Docker image is Alpine/musl and does
# NOT currently include it). If Chromium isn't available, this degrades
# silently to the existing static heuristic — never a crash, never a
# fabricated measurement. Leave unset/"false" until you've provisioned a
# Chromium-capable environment and are ready to accept the added per-scan
# latency (several seconds) and memory/CPU cost of a real browser render.
# ENABLE_BROWSER_SCAN=false

# ---- Optional Weather widget ----
# The dashboard's WEATHER widget (src/lib/weather.ts) fetches real current
# conditions from OpenWeatherMap (https://openweathermap.org/api — free tier
# available) for the city each user sets on their widget. Without this key,
# the widget honestly shows "Not configured" instead of a fabricated forecast.
# WEATHER_API_KEY=

# ---- Optional Data Enrichment Waterfall (src/lib/enrichment/) ----
# Real, platform-level (not per-org OAuth) data-provider keys behind the
# Companies/Contacts enrichment waterfall — src/lib/business-development/
# enrichment.ts calls each of these only if configured, and honestly skips
# (never fabricates) a step whose key is absent.
#
# Hunter.io (https://hunter.io/api-documentation/v2) — real email finding
# and verification. Free tier: 25 searches + 25 verifications/month. The
# waterfall checks Hunter's own live quota before every call and falls
# through to Abstract API (below) rather than erroring once exhausted.
# HUNTER_IO_API_KEY=
#
# Abstract API email validation (https://www.abstractapi.com/api/email-verification-validation-api)
# — second, independent email-verification step, tried when Hunter.io is
# unconfigured or its monthly quota is exhausted. Free tier: 100/month.
# ABSTRACT_EMAIL_API_KEY=
#
# OpenCorporates (https://api.opencorporates.com) — the world's largest open
# database of real, legally-filed company registrations. A free registered
# token is required; unauthenticated requests share a global rate-limited
# pool too small to rely on, so this integration is genuinely off without one.
# OPENCORPORATES_API_TOKEN=
#
# UK Companies House (https://developer.company-information.service.gov.uk)
# — the UK government's own free public register. For a UK company, this is
# the strongest real decision-maker source in the whole platform: a real,
# legally-filed director name, not an AI web-search inference.
# UK_COMPANIES_HOUSE_API_KEY=
#
# Prospeo (https://prospeo.io/api-docs/) — real name+company-website email
# finder, tried when Hunter.io is unconfigured or genuinely finds nothing.
# Free tier: 100 credits/month, no time limit.
# PROSPEO_API_KEY=
#
# Wappalyzer (https://www.wappalyzer.com/docs/api/v2/lookup/) — real website
# technology detection, used only as a supplemental signal for a company
# with no WebsiteScan yet (this platform's own scanner already does deeper
# detection once a scan runs). Free tier: 50 lookups/month.
# WAPPALYZER_API_KEY=
#
# Financial Modeling Prep (https://financialmodelingprep.com/developer/docs)
# — real employee-count lookup for publicly-traded/SEC-reporting companies
# only (FMP's own coverage limit; never guessed for a private company).
# Free tier: 250 requests/day, requires a free signup for a key.
# FMP_API_KEY=
#
# SEC EDGAR full-text search (https://www.sec.gov/edgar/search/) — real,
# free, no API key required. SEC's own fair-access policy requires a
# genuine identifying User-Agent on every request (company/app name + a
# real contact — never a fake or default browser string).
# SEC_EDGAR_USER_AGENT="KVL GrowthOS contact@yourdomain.com"

# ---- Optional Integration Layer ----
# Account-linked OAuth integrations (Gmail/Outlook send, Google/Microsoft
# Calendar, DocuSign/Adobe Sign/Dropbox Sign e-signature) managed via
# src/lib/integrations/. Each adapter's isConfigured() only returns true
# when its client id/secret are BOTH set; otherwise the Integration
# Management page shows "Not Connected — requires <ENV_VAR>" and no feature
# that depends on it silently pretends to work.

# Adobe Acrobat Sign (https://secure.na1.adobesign.com -> Account > API > API Applications)
# ADOBE_SIGN_SHARD is optional and defaults to "na1" (Adobe Sign's API is
# partitioned into regional shards, e.g. na1/na2/na3/eu1/eu2/au1).
# ADOBE_SIGN_CLIENT_ID=
# ADOBE_SIGN_CLIENT_SECRET=
# ADOBE_SIGN_SHARD=

# DocuSign (https://developers.docusign.com) — eSignature envelopes.
# DOCUSIGN_ENVIRONMENT selects the OAuth/API host: "demo" (default, free
# developer sandbox) or "production". Leave unset/"demo" until you're ready
# to send real, legally-binding envelopes.
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_CLIENT_SECRET=
# DOCUSIGN_ENVIRONMENT=demo

# Dropbox Sign OAuth (https://developers.hellosign.com)
# DROPBOX_SIGN_CLIENT_ID=
# DROPBOX_SIGN_CLIENT_SECRET=

# Google integrations OAuth client (Gmail send + Google Calendar)
# (https://console.developers.google.com/apis/credentials)
# This is a SEPARATE OAuth client from GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET
# above — that one is used only for "Sign in with Google" and requests
# profile/email scopes; this one requests gmail.send/calendar scopes and
# must never be reused for login.
# GOOGLE_INTEGRATION_CLIENT_ID=
# GOOGLE_INTEGRATION_CLIENT_SECRET=

# Microsoft integrations OAuth app (Outlook Mail.Send + Calendars.ReadWrite)
# (https://portal.azure.com)
# This is a SEPARATE Entra ID app registration from
# MICROSOFT_ENTRA_ID_CLIENT_ID/MICROSOFT_ENTRA_ID_CLIENT_SECRET above — that
# one is used only for "Sign in with Microsoft" and requests basic sign-in
# scopes; this one requests Graph Mail.Send/Calendars.ReadWrite + offline_access
# and must never be reused for login.
# MICROSOFT_INTEGRATION_TENANT_ID is optional — omit it to allow any
# Microsoft account (personal/school/work) via the multi-tenant "common" endpoint.
# MICROSOFT_INTEGRATION_CLIENT_ID=
# MICROSOFT_INTEGRATION_CLIENT_SECRET=
# MICROSOFT_INTEGRATION_TENANT_ID=

# Webhook signature verification for the e-signature providers
# (src/app/api/webhooks/{docusign,adobe-sign,dropbox-sign}/route.ts). Without
# these, incoming webhooks are still processed but a warning is logged that
# signature verification was skipped — set these once the corresponding
# Connect/webhook subscription is configured with a matching secret.
# DOCUSIGN_WEBHOOK_HMAC_SECRET=
# For Dropbox Sign, DROPBOX_SIGN_CLIENT_SECRET (already set above) doubles as
# the event-callback signing key — no separate var needed. Adobe Sign is
# verified via the x-adobesign-clientid header against ADOBE_SIGN_CLIENT_ID
# (already set above) — no separate var needed either.

# ---- Integration Hub: further OAuth2 apps (Integration Center — Phase 16) ----
# Every adapter below shows "Not Connected — requires <ENV_VAR>" on the
# Integrations page until its client id/secret are both set — connecting
# never fakes a success. API_KEY-auth providers (Stripe, Twilio, SendGrid,
# OpenAI, ...) need no platform-level env var here at all — each org pastes
# its own key/token directly into the Connect dialog on that page.

# Slack (https://api.slack.com/apps) — OAuth v2, bot scopes chat:write/channels:read.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=

# HubSpot (https://developers.hubspot.com) — CRM sync.
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=

# Salesforce (https://help.salesforce.com -> Connected Apps) — CRM sync.
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=

# Zoho (https://api-console.zoho.com) — shared by both Zoho CRM and Zoho Books
# (same API Console app, different scopes requested per adapter).
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=

# Pipedrive (https://developers.pipedrive.com) — CRM sync.
# PIPEDRIVE_CLIENT_ID=
# PIPEDRIVE_CLIENT_SECRET=

# Dropbox (https://www.dropbox.com/developers/apps) — file storage.
# DROPBOX_CLIENT_ID=
# DROPBOX_CLIENT_SECRET=

# Cal.com API key and Freshsales/Twilio/Razorpay/PayPal/Paddle/LemonSqueezy/
# Vercel/Netlify/Cloudflare/OpenAI/Gemini/DeepSeek/Groq/OpenRouter/Ollama are
# all API_KEY-auth — no env var here, connected per-org via the Connect
# dialog.

# Calendly (https://calendly.com/integrations/api_webhooks) — calendar.
# CALENDLY_CLIENT_ID=
# CALENDLY_CLIENT_SECRET=

# Zoom (https://marketplace.zoom.us) — meetings.
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=

# QuickBooks (https://developer.intuit.com) — accounting.
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_ENVIRONMENT is optional and defaults to Intuit's sandbox; set to
# "production" once you're ready for real company data.
# QUICKBOOKS_ENVIRONMENT=sandbox

# Xero (https://developer.xero.com/myapps) — accounting.
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=

# GitHub integration app (https://github.com/settings/developers) — DEVELOPMENT
# category. Deliberately separate from GITHUB_CLIENT_ID/SECRET above, which is
# login-only ("Sign in with GitHub") and must never be reused here.
# GITHUB_INTEGRATION_CLIENT_ID=
# GITHUB_INTEGRATION_CLIENT_SECRET=

# GitLab (https://gitlab.com/-/profile/applications) — development.
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=

# Bitbucket (https://bitbucket.org/account/settings/app-passwords/ -> OAuth consumers) — development.
# BITBUCKET_CLIENT_ID=
# BITBUCKET_CLIENT_SECRET=

# Microsoft Teams reuses MICROSOFT_INTEGRATION_CLIENT_ID/SECRET/TENANT_ID
# above (same Entra ID app as Outlook/Microsoft Calendar, different Graph
# scopes) — no separate vars needed. Same for Google Drive/Google Meet, which
# reuse GOOGLE_INTEGRATION_CLIENT_ID/SECRET above.

# AES-256-GCM key for AgentMemory.encryptedContent (64-char hex, 32 bytes)
# — generate with: openssl rand -hex 32
# Required once any AI agent persists memory.
# AGENT_MEMORY_ENCRYPTION_KEY=

# AES-256-GCM key for IntegrationConnection OAuth tokens (64-char hex, 32
# bytes) — generate with: openssl rand -hex 32
# Separate from AGENT_MEMORY_ENCRYPTION_KEY (used for AI agent memory) so
# rotating one never breaks the other. Required only once you connect a
# real integration.
# INTEGRATION_TOKEN_ENCRYPTION_KEY=

# AES-256-GCM key for the Secrets Manager's Secret.encryptedValue (64-char
# hex, 32 bytes) — generate with: openssl rand -hex 32
# Separate from both AGENT_MEMORY_ENCRYPTION_KEY and
# INTEGRATION_TOKEN_ENCRYPTION_KEY so rotating this key domain never breaks
# agent memory or OAuth token decryption, or vice versa. Required once any
# org saves a secret via /dashboard/settings/secrets.
# SECRETS_MANAGER_ENCRYPTION_KEY=

# AES-256-GCM key for Workflow node webhook secrets (64-char hex, 32 bytes)
# — generate with: openssl rand -hex 32
# Its own independent key domain, same reasoning as above. Required once any
# workflow uses an incoming-webhook trigger with a signing secret.
# WEBHOOK_SECRET_ENCRYPTION_KEY=

# AES-256-GCM key for User.twoFactorSecret (64-char hex, 32 bytes) —
# generate with: openssl rand -hex 32
# Its own independent key domain — a DB dump alone must not be enough to
# generate valid TOTP codes for 2FA-enrolled accounts. Required once any
# user enrolls in 2FA (src/app/profile — "Set up 2FA").
# TWO_FACTOR_SECRET_ENCRYPTION_KEY=

# AES-256-GCM key for uploaded files at rest (64-char hex, 32 bytes) —
# generate with: openssl rand -hex 32
# Opt-in: if unset, uploaded files (documents, project files, RAG documents,
# knowledge-base attachments, white-label assets, platform invoices — all
# share src/lib/storage/file-store.ts) are written to local disk storage/ as
# plaintext, same as before this key existed. Setting it encrypts every NEW
# save() going forward; already-saved plaintext files remain readable (a
# magic-prefix marker lets read() tell them apart — never a destructive
# rewrite).
# FILE_STORAGE_ENCRYPTION_KEY=

# HMAC-SHA256 secret for time-limited signed file-download URLs (any random
# string, e.g. `openssl rand -hex 32`) — src/lib/storage/signed-url.ts.
# Required only once a real caller issues a signed download link (e.g.
# emailing a client a proposal PDF without requiring portal login).
# FILE_SIGNED_URL_SECRET=

# ---- Platform Billing Engine (Subscription/Billing/White Label phase) ----
# These are the PLATFORM OPERATOR's own gateway credentials — KVL GrowthOS
# charging a tenant organization for platform access — completely separate
# from the per-organization "bring your own account" payment integrations
# under src/lib/integrations/providers/{stripe,razorpay,paypal,paddle,
# lemonsqueezy}.ts (those let an org accept ITS OWN clients' payments).
# src/lib/billing/gateway/registry.ts's listConfiguredGateways() only shows
# a gateway as usable once its own vars below are set — none are simulated.

# Stripe (https://dashboard.stripe.com/apikeys) — primary international gateway.
# STRIPE_SECRET_KEY=
# Webhook signing secret from the endpoint you create for
# /api/webhooks/billing/stripe (https://dashboard.stripe.com/webhooks).
# STRIPE_WEBHOOK_SECRET=

# Razorpay (https://dashboard.razorpay.com/app/keys) — recommended for Indian tenants.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Webhook secret configured against /api/webhooks/billing/razorpay
# (https://dashboard.razorpay.com/app/webhooks).
# RAZORPAY_WEBHOOK_SECRET=

# Paddle (https://vendors.paddle.com/authentication) — Merchant of Record;
# Paddle itself handles global sales tax/VAT remittance.
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_ENVIRONMENT selects the API host: "sandbox" (default) or "production".
# PADDLE_ENVIRONMENT=sandbox

# LemonSqueezy (https://app.lemonsqueezy.com/settings/api) — optional gateway.
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_WEBHOOK_SECRET=

# Bank Transfer / Manual is always available with no credentials — an
# OWNER/ADMIN records a received payment directly from
# /dashboard/billing/subscription.

# ---- Production Dashboard / Monitoring / Alerting / Backups ----
# See src/lib/monitoring/*, src/app/admin/production/page.tsx,
# src/lib/ops/*, scripts/backup-*.sh, docs/operations/disaster-recovery.md.

# Sentry error tracking (sentry.server.config.ts, sentry.edge.config.ts,
# src/instrumentation.ts's onRequestError). NOT CONFIGURED until a real DSN
# is set — Sentry.init is never called with a placeholder DSN; without this,
# the app runs exactly as before, just without error reporting.
# SENTRY_DSN=
# Client-side (browser) init reads NEXT_PUBLIC_SENTRY_DSN specifically —
# Next.js only inlines NEXT_PUBLIC_-prefixed vars into the browser bundle.
# Set this to the SAME value as SENTRY_DSN above to also capture client-side
# errors (src/instrumentation-client.ts).
# NEXT_PUBLIC_SENTRY_DSN=
# Optional — only needed to upload source maps / annotate builds at build
# time (next.config.ts's withSentryConfig). Omit and the build still
# succeeds; it just skips source map upload (readable stack traces in
# Sentry require this once you do configure it).
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Platform-level (cross-tenant) infra alert webhooks — src/lib/monitoring/
# alerts.ts. Deliberately SEPARATE from the existing per-organization
# UserPreference.slackWebhookUrl/teamsWebhookUrl (those notify one tenant
# about their own business events; these notify whoever operates this
# entire deployment about infrastructure-level SystemAlerts, e.g. "the
# database is DOWN"). NOT CONFIGURED until set — dispatchWebhook is a real
# no-op without a URL; the in-app Notification to User.isPlatformOwner
# users is the only channel that fires until you set one of these.
# PLATFORM_ALERTS_SLACK_WEBHOOK_URL=
# PLATFORM_ALERTS_TEAMS_WEBHOOK_URL=

# Marketing-site "Talk to sales" / contact form inquiries (src/app/api/
# sales-inquiries/route.ts) — same dispatchWebhook pattern as
# PLATFORM_ALERTS_* above, but for inbound sales leads rather than infra
# alerts. NOT CONFIGURED until set: the SalesInquiry row is still created
# and the submitter still gets their confirmation email either way — these
# only control whether your own sales team is also notified.
# PLATFORM_SALES_SLACK_WEBHOOK_URL=
# PLATFORM_SALES_TEAMS_WEBHOOK_URL=
# PLATFORM_SALES_EMAIL=

# Real local-disk root for scripts/backup-database.sh / backup-storage.sh
# (each appends its own database/ or storage/ subdirectory). Defaults to
# <project root>/storage/backups/ if unset — override for a separate disk/
# mount with more capacity or off-host retention.
# BACKUP_DIR=

# Shared secret gating src/app/api/metrics/route.ts (a real Prometheus scrape
# endpoint — src/lib/monitoring/metrics.ts). Send it back as either the
# `x-metrics-token` request header or a `?token=` query param. Unlike
# /api/health (deliberately public), this endpoint is NOT CONFIGURED — it
# honestly returns 503 — until you set this, so it's never wide open by
# default. Generate with: openssl rand -hex 32
# METRICS_TOKEN=

# ---- OpenTelemetry tracing (src/instrumentation.ts) ----
# NOT CONFIGURED until OTEL_EXPORTER_OTLP_ENDPOINT is set to a real OTLP/HTTP
# collector endpoint — the NodeSDK bootstrap simply never starts, and the app
# runs exactly as before (no crash, no tracing overhead) without it.
# Point this at a self-hosted collector you actually run, e.g.:
#   - Grafana Tempo/Jaeger behind an OTel Collector (docker run -p 4318:4318
#     otel/opentelemetry-collector-contrib, or Jaeger's all-in-one image
#     which exposes an OTLP/HTTP receiver on :4318 directly), or
#   - a hosted OTel backend's OTLP/HTTP ingest URL (Grafana Cloud, Honeycomb,
#     etc. — most require OTEL_EXPORTER_OTLP_HEADERS below for auth).
# Base URL only (no /v1/traces suffix) — that path segment is appended for you.
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"

# Optional — comma-separated "key1=value1,key2=value2" headers sent with
# every export, per the OTel spec's standard header-list format. Needed for
# hosted backends that authenticate the OTLP ingest via a header, e.g.:
# OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer <token>"

# Optional — the service.name resource attribute traces are tagged with.
# Defaults to "kvl-growthos" if unset.
# OTEL_SERVICE_NAME=kvl-growthos
